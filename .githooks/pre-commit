#!/bin/sh
# Pre-commit hook: check formatting, lint, and test before every commit.
# Enabled via: git config core.hooksPath .githooks
set -e

export PATH="$HOME/.cargo/bin:$PATH"

# A commit that touches only the Swift client runs the client's tests
# and nothing of cargo: the Rust checks would rebuild a workspace the
# change cannot have affected, and CI runs them on the pull request
# anyway. Anything outside client/ runs the full set below.
STAGED=$(git diff --cached --name-only --diff-filter=ACDMR)
if [ -n "$STAGED" ] && ! printf '%s\n' "$STAGED" | grep -qv '^client/'; then
    echo "pre-commit: client only; swift test"
    (cd client && swift test --quiet)
    exit 0
fi

# Git runs hooks with GIT_DIR and GIT_INDEX_FILE pointing at the
# repository being committed. A test that runs git in a fixture directory
# would act on this repository instead, so none of them reach the tests.
for var in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
    unset "$var"
done

echo "pre-commit: cargo fmt"
cargo fmt --all --check

echo "pre-commit: cargo clippy"
cargo clippy --locked --workspace --all-targets --quiet -- -D warnings

echo "pre-commit: cargo test"
cargo test --locked --workspace --quiet

echo "pre-commit: cargo test (egui_term)"
cargo test --locked -p egui_term --lib --quiet
