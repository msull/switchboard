+        let (status, reply) = call(&mut port, method, path, None, "");
+        assert_eq!(
+            (status, code(&reply)),
+            (404, "not_found"),
+            "{method} {path}: {reply}"
+        );
+    }
+}
+
+/// A page connection is closed after its reply, so it frees its
+/// unauthenticated slot at once: four pages held open with their
+/// replies read do not fill the pool for a fifth.
+#[test]
+fn a_page_frees_its_slot_when_it_is_answered() {
+    let port = port();
+    let mut kept = Vec::new();
+    for _ in 0..MAX_UNAUTHENTICATED {
+        let mut conn = send(port.addr, &port.client, "GET", "/app.css", &[], "").unwrap();
+        let (status, head, _) = receive(&mut conn).unwrap();
+        assert_eq!(status, 200);
+        assert_eq!(header(&head, "connection"), Some("close"));
+        kept.push(conn);
+    }
+    std::thread::sleep(Duration::from_millis(100));
+    let (status, _, _) = exchange(port.addr, &port.client, "GET", "/app.css", &[], "").unwrap();
+    assert_eq!(status, 200, "the closed pages gave their slots back");
+    drop(kept);
+}
+
+/// Pages have a window of their own: the 121st in a minute is 429, and
+/// `/info` and `/pair` are not counted against it.
+#[test]
+fn the_page_window_is_120_a_minute_and_the_others_are_their_own() {
+    let mut port = port();
+    for _ in 0..120 {
+        let (status, _, _) = exchange(port.addr, &port.client, "GET", "/", &[], "").unwrap();
+        assert_eq!(status, 200);
+    }
+    let (status, _, out) = exchange(port.addr, &port.client, "GET", "/", &[], "").unwrap();
+    let text = String::from_utf8_lossy(&out);
+    assert_eq!(status, 429, "{text}");
+    assert!(text.contains("rate_limited"), "{text}");
+    let (status, _) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200, "info has its own window");
+    let (status, reply) = call(&mut port, "POST", "/api/v1/pair", None, "{}");
+    assert_eq!(
+        (status, code(&reply)),
+        (403, "pairing_closed"),
+        "pair has its own window"
+    );
+}
+
+/// Pairs a browser through the window the way the page does, with the
+/// `cookie` transport, and returns the `Set-Cookie` the host sent.
+fn browser_cookie(port: &mut Port, code: &str, scope: Scope, device_name: &str) -> String {
+    port.app.dispatch(AppAction::OpenPairing {
+        code: code.into(),
+        scope,
+    });
+    let spki = port
+        .remote
+        .state()
+        .identity
+        .as_ref()
+        .unwrap()
+        .spki_sha256
+        .clone();
+    let body = serde_json::json!({
+        "code": code,
+        "device_name": device_name,
+        "spki_sha256": spki,
+        "transport": "cookie",
+    });
+    let (status, head, reply) = call_with(port, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(status, 200, "{reply}");
+    assert!(
+        reply["body"].get("token").is_none(),
+        "no token in the body: {reply}"
+    );
+    header(&head, "set-cookie")
+        .expect("a cookie for the browser")
+        .to_owned()
+}
+
+/// The `name=value` a browser sends back from a `Set-Cookie`.
+fn cookie_pair(set_cookie: &str) -> String {
+    set_cookie.split(';').next().unwrap().to_owned()
+}
+
+/// A browser's pairing: the cookie is named for the host and carries
+/// the attributes that keep it from script and from other sites; its
+/// value alone reads `/me`, and a native client's pairing is unchanged.
+#[test]
+fn a_browser_pairs_with_a_cookie_its_script_cannot_read_and_the_cookie_alone_reads_me() {
+    let mut port = port();
+    let server_id = port.remote.state().identity.as_ref().unwrap().server_id;
+    let set = browser_cookie(&mut port, "ABCD2345", Scope::Control, "Safari on iPhone");
+    let name = format!("__Host-sb-{server_id}");
+    assert!(set.starts_with(&format!("{name}=")), "{set}");
+    for attr in [
+        "Path=/",
+        "Secure",
+        "HttpOnly",
+        "SameSite=Strict",
+        "Max-Age=34560000",
+    ] {
+        assert!(set.contains(attr), "{attr} in {set}");
+    }
+    assert!(!set.contains("Domain"), "{set}");
+    let pair = cookie_pair(&set);
+    let token = pair.split_once('=').unwrap().1;
+    assert_eq!(token.len(), 43, "a bearer token's length");
+
+    let (status, _, me) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &pair)], "");
+    assert_eq!(status, 200, "{me}");
+    assert_eq!(me["body"]["scope"], "control");
+    assert_eq!(me["body"]["name"], "Safari on iPhone");
+    assert_eq!(me["body"]["server_id"], server_id.to_string());
+
+    // A cookie under the fixed name, or with a wrong value, is nothing.
+    for cookie in [format!("__Host-sb={token}"), format!("{name}=nope")] {
+        let (status, _, reply) =
+            call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+        assert_eq!((status, code(&reply)), (401, "unauthorized"), "{cookie}");
+    }
+    // Other cookies in the jar are ignored.
+    let jar = format!("theme=dark; {pair}; other=1");
+    let (status, _, _) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &jar)], "");
+    assert_eq!(status, 200);
+
+    // A native client is given its token in the body and no cookie.
+    port.app.dispatch(AppAction::OpenPairing {
+        code: "BCDE2345".into(),
+        scope: Scope::Read,
+    });
+    let spki = port
+        .remote
+        .state()
+        .identity
+        .as_ref()
+        .unwrap()
+        .spki_sha256
+        .clone();
+    let body = serde_json::json!({ "code": "BCDE2345", "device_name": "Pad", "spki_sha256": spki });
+    let (status, head, reply) =
+        call_with(&mut port, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(status, 200, "{reply}");
+    assert!(reply["body"]["token"].is_string(), "{reply}");
+    assert!(header(&head, "set-cookie").is_none(), "{head:?}");
+}
+
+/// Two instances on one address: each names its cookie for its own id,
+/// and each reads only its own, so one pairing never overwrites the other.
+#[test]
+fn two_instances_on_one_address_keep_their_cookies_apart() {
+    let mut first = port();
+    let mut second = port();
+    let cookie_first = cookie_pair(&browser_cookie(
+        &mut first,
+        "ABCD2345",
+        Scope::Read,
+        "First",
+    ));
+    let cookie_second = cookie_pair(&browser_cookie(
+        &mut second,
+        "ABCD2345",
+        Scope::Read,
+        "Second",
+    ));
+    assert_ne!(
+        cookie_first.split('=').next(),
+        cookie_second.split('=').next(),
+        "each host's cookie has its own name"
+    );
+
+    let jar = format!("{cookie_first}; {cookie_second}");
+    let (status, _, me) = call_with(&mut first, "GET", "/api/v1/me", &[("Cookie", &jar)], "");
+    assert_eq!(
+        (status, me["body"]["name"].as_str()),
+        (200, Some("First")),
+        "{me}"
+    );
+    let (status, _, me) = call_with(&mut second, "GET", "/api/v1/me", &[("Cookie", &jar)], "");
+    assert_eq!(
+        (status, me["body"]["name"].as_str()),
+        (200, Some("Second")),
+        "{me}"
+    );
+    let (status, _, reply) = call_with(
+        &mut second,
+        "GET",
+        "/api/v1/me",
+        &[("Cookie", &cookie_first)],
+        "",
+    );
+    assert_eq!((status, code(&reply)), (401, "unauthorized"), "{reply}");
+}
+
+/// A cookie write must come from this host's own page: a request with
+/// no `Origin`, or another one, is 403 `origin`; the page's own origin
+/// gets past it; a bearer request is not asked for an `Origin`.
+#[test]
+fn a_cookie_write_must_come_from_this_hosts_page_and_a_bearer_need_not() {
+    let mut port = port();
+    let (_, _, session) = seed(&mut port, "");
+    let cookie = cookie_pair(&browser_cookie(
+        &mut port,
+        "ABCD2345",
+        Scope::Control,
+        "Pad",
+    ));
+    let token = pair(&mut port, "BCDE2345", Scope::Control, "Mac mini");
+    let path = format!("/api/v1/sessions/{session}/send");
+    let body = r#"{"op":"origin-1","text":"hi"}"#;
+
+    let (status, _, reply) = call_with(&mut port, "POST", &path, &[("Cookie", &cookie)], body);
+    assert_eq!((status, code(&reply)), (403, "origin"), "{reply}");
+    let (status, _, reply) = call_with(
+        &mut port,
+        "POST",
+        &path,
+        &[("Cookie", &cookie), ("Origin", "https://evil.example")],
+        body,
+    );
+    assert_eq!((status, code(&reply)), (403, "origin"), "{reply}");
+    // Same host, another port: the same name, so a different origin.
+    let (status, _, reply) = call_with(
+        &mut port,
+        "POST",
+        &path,
+        &[("Cookie", &cookie), ("Origin", "https://localhost:9999")],
+        body,
+    );
+    assert_eq!((status, code(&reply)), (403, "origin"), "{reply}");
+    // The page's own origin passes the rule; the send is then refused for
+    // a session that is not running, which is not this rule.
+    let (_, _, reply) = call_with(
+        &mut port,
+        "POST",
+        &path,
+        &[("Cookie", &cookie), ("Origin", "https://localhost")],
+        body,
+    );
+    assert_ne!(code(&reply), "origin", "{reply}");
+
+    let bearer = format!("Bearer {token}");
+    let (_, _, reply) = call_with(
+        &mut port,
+        "POST",
+        &path,
+        &[("Authorization", &bearer)],
+        body,
+    );
+    assert_ne!(code(&reply), "origin", "a bearer needs no Origin: {reply}");
+    let (status, _, _) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!(status, 200, "a cookie read needs no Origin");
+}
+
+/// `/me` says the device's scope and follows a change to it; a revoked
+/// browser is refused as an unknown token, and `/info` still answers
+/// with the host's own id and key, which is what the page compares.
+#[test]
+fn me_follows_the_scope_and_a_revoked_browser_is_refused_as_an_unknown_one() {
+    let mut port = port();
+    let (status, _, _) = call_with(&mut port, "GET", "/api/v1/me", &[], "");
+    assert_eq!(status, 401, "/me is refused to no one");
+    let cookie = cookie_pair(&browser_cookie(
+        &mut port,
+        "ABCD2345",
+        Scope::Read,
+        "Safari on iPad",
+    ));
+    let (_, _, me) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!(me["body"]["scope"], "read");
+
+    let device = port.app.core().devices()[0].id;
+    port.app.dispatch(AppAction::SetDeviceScope {
+        device,
+        scope: Scope::Control,
+    });
+    let (_, _, me) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!(me["body"]["scope"], "control");
+
+    port.app.dispatch(AppAction::RevokeDevice(device));
+    let (status, _, reply) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!((status, code(&reply)), (401, "unauthorized"), "{reply}");
+    let (status, info) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200);
+    let identity = port.remote.state().identity.clone().unwrap();
+    assert_eq!(info["body"]["server_id"], identity.server_id.to_string());
+    assert_eq!(info["body"]["spki_sha256"], identity.spki_sha256);
+}
