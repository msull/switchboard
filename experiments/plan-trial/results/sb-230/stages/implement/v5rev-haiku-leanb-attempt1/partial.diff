+#[test]
+fn the_pages_answer_before_pairing_with_their_headers_and_nothing_else() {
+    let port = port();
+    let pages: [(&str, &str, &[u8]); 3] = [
+        (
+            "/",
+            "text/html; charset=utf-8",
+            include_bytes!("../web/index.html"),
+        ),
+        (
+            "/app.js",
+            "text/javascript; charset=utf-8",
+            include_bytes!("../web/app.js"),
+        ),
+        (
+            "/app.css",
+            "text/css; charset=utf-8",
+            include_bytes!("../web/app.css"),
+        ),
+    ];
+    for (path, content_type, body) in pages {
+        let (status, head, out) = exchange(port.addr, &port.client, "GET", path, &[], "").unwrap();
+        assert_eq!(status, 200, "{path}");
+        assert_eq!(header(&head, "content-type"), Some(content_type), "{path}");
+        assert_eq!(
+            header(&head, "content-security-policy"),
+            Some(web::CSP),
+            "{path}"
+        );
+        assert_eq!(header(&head, "referrer-policy"), Some("no-referrer"));
+        assert_eq!(header(&head, "cache-control"), Some("no-store"));
+        assert_eq!(header(&head, "x-content-type-options"), Some("nosniff"));
+        assert_eq!(header(&head, "connection"), Some("close"));
+        assert_eq!(out, body, "{path} is the file the crate was built with");
+    }
+    // A query is not part of the path, and is not echoed.
+    let (status, _, out) =
+        exchange(port.addr, &port.client, "GET", "/?code=ABCD2345", &[], "").unwrap();
+    assert_eq!(status, 200);
+    assert_eq!(out, include_bytes!("../web/index.html"));
+}
