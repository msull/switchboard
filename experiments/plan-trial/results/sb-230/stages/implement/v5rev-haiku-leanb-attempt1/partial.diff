+/// The route table at the top of `web/app.js`, read from the file.
+fn page_routes() -> Vec<(String, String)> {
+    let js = include_str!("../web/app.js");
+    let table = js
+        .split("const ROUTES = {")
+        .nth(1)
+        .and_then(|rest| rest.split("};").next())
+        .expect("the page has a route table");
+    table
+        .lines()
+        .filter_map(|line| {
+            let (_, rest) = line.trim().split_once(": ['")?;
+            let (method, path) = rest.split_once("', '")?;
+            let path = path.strip_suffix("'],")?;
+            Some((method.to_owned(), path.to_owned()))
+        })
+        .collect()
+}
+
+/// Every route the page calls is one the host serves to a paired device
+/// with an answer other than `not_found`, so a renamed route fails here.
+#[test]
+fn every_route_the_page_calls_is_one_the_host_serves() {
+    let mut port = port();
+    let (_, project, session) = seed(&mut port, "");
+    let token = pair(&mut port, "ABCD2345", Scope::Control, "Pad");
+    let bearer = format!("Bearer {token}");
+    let routes = page_routes();
+    assert!(routes.len() >= 10, "the table is read: {routes:?}");
+    for (method, route) in routes {
+        let id: &str = if route.starts_with("/projects/") {
+            &project
+        } else {
+            &session
+        };
+        let path = format!("/api/v1{}", route.replace("{id}", id));
+        let body = if route.ends_with("/send") {
+            r#"{"op":"route-test","text":"hi"}"#
+        } else {
+            "{}"
+        };
+        let (status, _, reply) = call_with(
+            &mut port,
+            &method,
+            &path,
+            &[("Authorization", &bearer)],
+            body,
+        );
+        assert_ne!(
+            code(&reply),
+            "not_found",
+            "{method} {path} is not served: {status} {reply}"
+        );
+    }
+}
+
+/// The page's markup and script stay within the policy it is served
+/// under: no inline script, style or handler, its references are to
+/// files the port serves, and the script never writes markup from text.
+#[test]
+fn the_page_has_no_inline_script_style_or_handler_and_writes_no_markup() {
+    let html = include_str!("../web/index.html");
+    for tag in html.split("<script").skip(1) {
+        let open = tag.split('>').next().unwrap_or("");
+        assert!(open.contains("src=\""), "an inline script: {open}");
+    }
+    assert!(!html.contains("style="), "an inline style");
+    assert!(
+        !html
+            .split_whitespace()
+            .any(|w| w.starts_with("on") && w.contains('=')),
+        "an inline handler"
+    );
+    for attr in ["src=\"", "href=\""] {
+        for value in html.split(attr).skip(1) {
+            let value = value.split('"').next().unwrap_or("");
+            assert!(
+                value.starts_with("data:") || web::page(value).is_some(),
+                "{value} is not served"
+            );
+        }
+    }
+    let js = include_str!("../web/app.js");
+    for banned in [
+        "innerHTML",
+        "outerHTML",
+        "insertAdjacentHTML",
+        "eval(",
+        "document.write",
+    ] {
+        assert!(
+            !js.contains(banned),
+            "{banned} writes markup or code from text"
+        );
+    }
+}
