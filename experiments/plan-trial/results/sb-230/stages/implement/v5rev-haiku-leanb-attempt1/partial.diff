+    let host = match address {
+        IpAddr::V4(a) => a.to_string(),
+        IpAddr::V6(a) => format!("[{a}]"),
+    };
+    format!(
+        "https://{host}:{port}/#code={}&key={}&id={}",
+        window.code, identity.spki_sha256, identity.server_id
