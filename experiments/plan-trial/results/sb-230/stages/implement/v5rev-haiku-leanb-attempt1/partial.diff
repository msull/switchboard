+/// The page's own unit tests, under node, when node is installed.
+#[test]
+fn the_page_script_passes_its_own_unit_tests() {
+    if std::process::Command::new("node")
+        .arg("--version")
+        .output()
+        .is_err()
+    {
+        eprintln!("node is not installed; the page's unit tests are skipped");
+        return;
+    }
+    let out = std::process::Command::new("node")
+        .args(["--test", "web/app.test.js"])
+        .current_dir(env!("CARGO_MANIFEST_DIR"))
+        .output()
+        .expect("node runs");
+    assert!(
+        out.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
