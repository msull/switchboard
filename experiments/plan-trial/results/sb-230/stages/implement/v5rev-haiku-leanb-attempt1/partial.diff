     public static func parse(_ text: String) throws -> PairingInvite {
-        try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+        if text.hasPrefix("https://") {
+            return try parseURL(text)
+        }
+        return try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+    }
+
+    /// `https://<host>:<port>/#code=…&key=…&id=…`: the fragment holds the
+    /// code, the key and the id, and the URL names where the host answers.
+    static func parseURL(_ text: String) throws -> PairingInvite {
+        guard let components = URLComponents(string: text),
+              let host = components.host,
+              let fragment = components.fragment
+        else {
+            throw DecodingError.dataCorrupted(
+                .init(codingPath: [], debugDescription: "not an invite URL"))
+        }
+        var values: [String: String] = [:]
+        for pair in fragment.split(separator: "&") {
+            let parts = pair.split(separator: "=", maxSplits: 1).map(String.init)
+            if parts.count == 2 {
+                values[parts[0]] = parts[1]
+            }
+        }
+        guard let code = values["code"], let key = values["key"], let id = values["id"] else {
+            throw DecodingError.dataCorrupted(
+                .init(codingPath: [], debugDescription: "the invite has no code, key or id"))
+        }
+        let address = components.port.map { "\(host):\($0)" } ?? host
+        return PairingInvite(
+            serverID: ServerID(id), spkiSha256: key, code: code, addresses: [address])
     }
 }
