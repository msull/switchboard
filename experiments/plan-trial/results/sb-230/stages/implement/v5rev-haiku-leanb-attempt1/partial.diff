+/// The pairing invite a phone scans or a person pastes: an `https` URL
+/// at the address the port answers, its fragment carrying the window's
+/// code and the host's key and id. A browser never sends a fragment, so
+/// the code is in no request line; the page checks the key and the id
+/// against the host before it sends the code.
+#[must_use]
+pub fn invite_url(
+    identity: &Identity,
+    window: &PairingWindow,
+    address: IpAddr,
+    port: u16,
