+"use strict";
+
+// The token is not here. The host set it as an HttpOnly cookie that
+// script cannot read, and the browser sends it with every request to
+// this host. What is kept is public: which host this is, its key hash
+// (to see an identity change) and the scope the pairing granted.
+const STORE = {
+  server: "switchboard.server_id",
+  key: "switchboard.spki_sha256",
+  scope: "switchboard.scope",
+};
+
+const state = {
+  host: "",
+  live: false,
+  socket: null,
+  stopped: false,
+  justPaired: false,
+  listRevision: -1,
+  scope: null,
+  sessions: [],
+  projects: [],
+  waitingIds: new Set(),
+  open: null,
+  ticks: 0,
+};
+
+const $ = (id) => document.getElementById(id);
+
+function readStored(name) {
+  try {
+    return localStorage.getItem(name);
+  } catch (e) {
+    return null;
+  }
+}
+
+function writeStored(name, value) {
+  try {
+    localStorage.setItem(name, value);
+  } catch (e) {
+    // Private browsing: this visit still works, the next one pairs again.
+  }
+}
+
+function notice(text) {
+  $("notice").textContent = text;
+  $("notice").hidden = text === "";
+}
+
+// One request. The reply is the host's envelope: `body` on success,
+// `error {code, message}` on a refusal.
+async function api(method, path, body) {
+  const init = { method, credentials: "same-origin", cache: "no-store", headers: {} };
+  if (body !== undefined) {
+    init.headers["Content-Type"] = "application/json";
+    init.body = JSON.stringify(body);
+  }
+  let res;
+  try {
+    res = await fetch(path, init);
+  } catch (e) {
+    return { ok: false, status: 0, error: { message: "The host did not answer." } };
+  }
+  let json = {};
+  try {
+    json = await res.json();
+  } catch (e) {
+    json = {};
+  }
+  if (res.ok) {
+    return { ok: true, status: res.status, body: json.body, revision: json.revision };
+  }
+  return {
+    ok: false,
+    status: res.status,
+    error: json.error || { message: "The host answered " + res.status + "." },
+  };
+}
+
+// The invite is the URL's fragment. A browser never sends it, so the
+// code reaches the host only in the pairing request. The URL is replaced
+// before anything else runs, so the code leaves the address bar.
+function readInvite() {
+  const params = new URLSearchParams(location.hash.slice(1));
+  if (!params.has("code") || !params.has("key") || !params.has("id")) {
+    return null;
+  }
+  const invite = {
+    code: (params.get("code") || "").toUpperCase(),
+    key: params.get("key"),
+    id: params.get("id"),
+  };
+  history.replaceState(null, "", "/");
+  return invite;
+}
+
+function deviceName() {
+  const ua = navigator.userAgent;
+  let browser = "Browser";
+  if (/Edg\//.test(ua)) browser = "Edge";
+  else if (/Chrome|CriOS|Chromium/.test(ua)) browser = "Chrome";
+  else if (/Firefox|FxiOS/.test(ua)) browser = "Firefox";
+  else if (/Safari/.test(ua)) browser = "Safari";
+  let device = "computer";
+  if (/iPhone/.test(ua)) device = "iPhone";
+  else if (/iPad/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)) {
+    device = "iPad";
+  } else if (/Android/.test(ua)) device = "Android";
+  else if (/Macintosh/.test(ua)) device = "Mac";
+  return browser + " on " + device;
+}
+
+function newOp() {
+  const b = crypto.getRandomValues(new Uint8Array(16));
+  b[6] = (b[6] & 0x0f) | 0x40;
+  b[8] = (b[8] & 0x3f) | 0x80;
+  const h = Array.from(b, (x) => x.toString(16).padStart(2, "0")).join("");
+  return [h.slice(0, 8), h.slice(8, 12), h.slice(12, 16), h.slice(16, 20), h.slice(20)].join("-");
+}
+
+// A refusal on an authenticated call: 401 ends the page's polling, and
+// the words say which of the three ways it happened.
+function failed(r) {
+  if (r.status !== 401) {
+    notice(r.error.message);
+    return;
+  }
+  state.stopped = true;
+  if (state.socket) state.socket.close();
+  if (state.justPaired) {
+    notice("This browser did not keep its pairing. Pair again.");
+  } else if (readStored(STORE.server)) {
+    notice("This device was revoked. Pair again.");
+  } else {
+    notice("Not paired. Open Remote devices on the Mac and scan the code.");
+  }
+}
+
+async function pair(invite, host) {
+  const r = await api("POST", "/api/v1/pair", {
+    code: invite.code,
+    spki_sha256: invite.key,
+    device_name: deviceName(),
+    transport: "cookie",
+  });
+  if (!r.ok) {
+    notice(r.error.message);
+    return false;
+  }
+  writeStored(STORE.server, host.server_id);
+  writeStored(STORE.key, invite.key);
+  writeStored(STORE.scope, r.body.scope);
+  state.justPaired = true;
+  notice("");
+  return true;
+}
+
+async function boot() {
+  const invite = readInvite();
+  const info = await api("GET", "/api/v1/info");
+  if (!info.ok) {
+    notice(info.error.message);
+    return;
+  }
+  const host = info.body;
+  state.host = host.server_name;
+  $("host").textContent = host.server_name;
+  if (invite) {
+    if (invite.key !== host.spki_sha256 || invite.id !== host.server_id) {
+      notice("This is not the host whose code was scanned.");
+      return;
+    }
+    if (!(await pair(invite, host))) return;
+  } else if (
+    readStored(STORE.server) === host.server_id &&
+    readStored(STORE.key) !== host.spki_sha256
+  ) {
+    notice("This host's identity changed. Pair again.");
+    return;
+  }
+  state.scope = readStored(STORE.scope);
+  if (!readStored(STORE.server)) {
+    notice("Not paired. Open Remote devices on the Mac and scan the code.");
+    return;
+  }
+  await refreshList();
+  setInterval(tick, 5000);
+}
+
+// The list: the waiting call is the first authenticated request, so a
+// pairing the host refused shows here. The socket opens after it, and
+// the collections are fetched after the socket is up (subscribe first).
+async function refreshList() {
+  const waiting = await api("GET", "/api/v1/waiting");
+  if (!waiting.ok) {
+    failed(waiting);
+    return;
+  }
+  state.justPaired = false;
+  state.waitingIds = new Set(waiting.body.sessions.map((s) => s.id));
+  let revision = waiting.revision;
+  connectSocket();
+  const projects = await api("GET", "/api/v1/projects");
+  if (!projects.ok) {
+    failed(projects);
+    return;
+  }
+  const sessions = [];
+  for (const p of projects.body.projects) {
+    const list = await api("GET", "/api/v1/projects/" + p.id + "/sessions");
+    if (!list.ok) {
+      failed(list);
+      return;
+    }
+    revision = Math.max(revision, list.revision);
+    for (const s of list.body.sessions) {
+      sessions.push(Object.assign({}, s, { projectName: p.name }));
+    }
+  }
+  state.listRevision = Math.max(revision, projects.revision);
+  state.projects = projects.body.projects;
+  state.sessions = sessions;
+  render();
+}
+
+function render() {
+  const list = $("list");
+  list.replaceChildren();
+  const groups = new Map();
+  for (const s of state.sessions) {
+    if (!groups.has(s.project)) groups.set(s.project, { name: s.projectName, items: [] });
+    groups.get(s.project).items.push(s);
+  }
+  const isWaiting = (s) => s.waiting || state.waitingIds.has(s.id);
+  const ordered = [...groups.values()]
+    .map((g) => {
+      g.items.sort((a, b) => Number(isWaiting(b)) - Number(isWaiting(a)));
+      g.waiting = g.items.filter(isWaiting).length;
+      return g;
+    })
+    .sort((a, b) => b.waiting - a.waiting || a.name.localeCompare(b.name));
+  if (ordered.length === 0) {
+    const p = document.createElement("p");
+    p.className = "meta";
+    p.textContent = "No sessions yet.";
+    list.append(p);
+  }
+  for (const g of ordered) {
+    const h = document.createElement("h2");
+    h.textContent = g.name;
+    list.append(h);
+    for (const s of g.items) {
+      const button = document.createElement("button");
+      button.type = "button";
+      button.className = "row" + (isWaiting(s) ? " waiting" : "");
+      const name = document.createElement("span");
+      name.className = "name";
+      name.textContent = s.name;
+      const meta = document.createElement("span");
+      meta.className = "meta";
+      meta.textContent = [s.kind, s.card, s.waiting_reason].filter(Boolean).join(" · ");
+      button.append(name, meta);
+      button.addEventListener("click", () => openSession(s));
+      list.append(button);
+    }
+  }
+  setStatus();
+}
+
+function setStatus() {
+  const scope = state.scope ? (state.scope === "control" ? "control" : "read-only") : "";
+  $("status").textContent = [state.host, state.live ? "live" : "polling", scope]
+    .filter(Boolean)
+    .join(" · ");
+}
+
+// The socket is an upgrade: the page works without it, polling the same
+// collections, and the socket's events only say what to refetch.
+function connectSocket() {
+  if (state.socket || state.stopped) return;
+  let ws;
+  try {
+    ws = new WebSocket("wss://" + location.host + "/api/v1/events");
+  } catch (e) {
+    return;
+  }
+  state.socket = ws;
+  ws.onmessage = (m) => {
+    let ev;
+    try {
+      ev = JSON.parse(m.data);
+    } catch (e) {
+      return;
+    }
+    onEvent(ev);
+  };
+  ws.onclose = () => {
+    if (state.socket === ws) state.socket = null;
+    state.live = false;
+    setStatus();
+  };
+}
+
+function sendFrame(type, open) {
+  if (state.socket && state.socket.readyState === WebSocket.OPEN) {
+    state.socket.send(JSON.stringify({ type, resource: { kind: open.contentKind, id: open.id } }));
+  }
+}
+
+function onEvent(ev) {
+  if (ev.type === "hello") {
+    state.live = true;
+    setStatus();
+    if (state.open) sendFrame("watch", state.open);
+    refreshList();
+    return;
+  }
+  if (ev.type === "resync_required") {
+    if (state.socket) state.socket.close();
+    return;
+  }
+  const kind = ev.resource ? ev.resource.kind : "";
+  const id = ev.resource ? ev.resource.id : "";
+  if (ev.type === "watching") {
+    if (state.open && id === state.open.id && kind === state.open.contentKind) loadOpen();
+    return;
+  }
+  if (ev.type !== "changed" && ev.type !== "removed") return;
+  if (kind === "conversation" || kind === "screen") {
+    if (state.open && id === state.open.id && ev.revision > state.open.revision) loadOpen();
+    return;
+  }
+  if (ev.revision > state.listRevision) refreshList();
+}
+
+// Polling while the socket is down, and the socket retried every 30 s.
+function tick() {
+  if (state.stopped) return;
+  state.ticks += 1;
+  if (!state.live) {
+    refreshList();
+    if (state.open) loadOpen();
+  }
+  if (state.ticks % 6 === 0) connectSocket();
+}
+
+async function openSession(s) {
+  closeOpen();
+  state.open = {
+    id: s.id,
+    name: s.name,
+    contentKind: s.kind === "claude" ? "conversation" : "screen",
+    revision: -1,
+  };
+  $("list").hidden = true;
+  $("session").hidden = false;
+  $("session-name").textContent = s.name;
+  $("session-text").textContent = "";
+  $("reply-note").textContent = "";
+  renderReplyBox();
+  if (state.socket && state.socket.readyState === WebSocket.OPEN) {
+    sendFrame("watch", state.open);
+  } else {
+    loadOpen();
+  }
+}
+
+function closeOpen() {
+  if (state.open) sendFrame("unwatch", state.open);
+  state.open = null;
+}
+
+async function loadOpen() {
+  const open = state.open;
+  if (!open) return;
+  const path =
+    open.contentKind === "conversation"
+      ? "/api/v1/sessions/" + open.id + "/last-response"
+      : "/api/v1/sessions/" + open.id + "/screen";
+  const r = await api("GET", path);
+  if (state.open !== open) return;
+  if (!r.ok) {
+    failed(r);
+    return;
+  }
+  open.revision = r.revision;
+  const text = r.body.text || (open.contentKind === "conversation" ? "No response yet." : "");
+  $("session-text").textContent = text;
+}
+
+function renderReplyBox() {
+  $("reply").hidden = !(state.open && state.scope === "control");
+}
+
+$("back").addEventListener("click", () => {
+  closeOpen();
+  $("session").hidden = true;
+  $("list").hidden = false;
+});
+
+$("reply").addEventListener("submit", async (ev) => {
+  ev.preventDefault();
+  const open = state.open;
+  const text = $("reply-text").value.trim();
+  if (!open || text === "") return;
+  const r = await api("POST", "/api/v1/sessions/" + open.id + "/send", { op: newOp(), text });
+  if (state.open !== open) return;
+  if (r.ok) {
+    $("reply-text").value = "";
+    $("reply-note").textContent = "Sent.";
+    loadOpen();
+  } else if (r.status === 403) {
+    state.scope = "read";
+    writeStored(STORE.scope, "read");
+    renderReplyBox();
+    setStatus();
+    $("reply-note").textContent = "This device is read-only now.";
+  } else {
+    failed(r);
+    $("reply-note").textContent = r.error.message;
+  }
+});
+
+boot();
diff --git a/web/index.html b/web/index.html
new file mode 100644
index 0000000..b3018c9
--- /dev/null
+++ b/web/index.html
@@ -0,0 +1,29 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="referrer" content="no-referrer">
+<title>Switchboard</title>
+<link rel="stylesheet" href="/app.css">
+</head>
+<body>
+<header>
+  <h1 id="host">Switchboard</h1>
+  <p id="status" class="meta"></p>
+</header>
+<p id="notice" class="notice" hidden></p>
+<main id="list"></main>
+<section id="session" hidden>
+  <nav><button id="back" type="button">Sessions</button></nav>
+  <h2 id="session-name"></h2>
+  <pre id="session-text"></pre>
+  <form id="reply" hidden>
+    <textarea id="reply-text" rows="3" aria-label="Message to the session"></textarea>
+    <p><button type="submit">Send</button></p>
+    <p id="reply-note" class="meta"></p>
+  </form>
+</section>
+<script src="/app.js" defer></script>
+</body>
+</html>
