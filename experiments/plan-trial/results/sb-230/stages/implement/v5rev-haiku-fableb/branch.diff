+        switchboard::core::remote::pairing_invite(&identity, "192.168.1.9:43187", "ABCD2345");
+    // The phone opens the URL: the secrets are in its fragment, which the
+    // host never sees, so the host reads them from what the page sends.
+    let fragment = invite.split_once('#').unwrap().1;
+    let field = |name: &str| {
