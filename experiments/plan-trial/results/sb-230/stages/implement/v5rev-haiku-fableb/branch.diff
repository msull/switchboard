+/// A TLS connection the test keeps across requests, as a browser keeps
+/// the sockets of a page load.
+type Kept = BufReader<StreamOwned<ClientConnection, TcpStream>>;
+
+fn connect_kept(port: &Port) -> Kept {
+    let tcp = TcpStream::connect(port.addr).expect("connect");
+    tcp.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+    let conn = ClientConnection::new(
+        Arc::clone(&port.client),
+        ServerName::try_from("localhost").unwrap(),
+    )
+    .expect("client");
+    let mut s = StreamOwned::new(conn, tcp);
+    while s.conn.is_handshaking() {
+        s.conn.complete_io(&mut s.sock).expect("handshake");
+    }
+    BufReader::new(s)
+}
+
+/// One `GET` on a kept connection, answered by the app on this thread.
+/// The connection comes back for the next request.
+fn get_kept(
+    port: &mut Port,
+    mut kept: Kept,
+    path: &str,
+    cookie: Option<&str>,
+) -> (Kept, u16, Vec<(String, String)>, String) {
+    let cookie = cookie
+        .map(|c| format!("Cookie: {c}\r\n"))
+        .unwrap_or_default();
+    let request =
+        format!("GET {path} HTTP/1.1\r\nHost: localhost\r\n{cookie}Content-Length: 0\r\n\r\n");
+    let client = std::thread::spawn(move || {
+        kept.get_mut().write_all(request.as_bytes())?;
+        let (status, headers, body) = read_response(&mut kept)?;
+        Ok::<_, std::io::Error>((kept, status, headers, body))
+    });
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while !client.is_finished() {
+        assert!(std::time::Instant::now() < deadline, "no reply");
+        port.app.serve_pending();
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    client.join().unwrap().expect("a kept request")
+}
+
+/// A page load's three connections fit the unauthenticated pool and stay
+/// open while a browser that has paired reads and subscribes: the
+/// `/waiting` moves its connection to the paired pool, and the socket
+/// then opens as a fourth stranger at most.
+#[test]
+fn a_page_load_fits_the_stranger_pool() {
+    let mut port = port();
+    let cookie = pair_browser(&mut port, "ABCD2345", "Safari on iPhone");
+    // The pairing's own connection must be gone before the pool is counted.
+    std::thread::sleep(Duration::from_millis(100));
+    let mut held = Vec::new();
+    for path in ["/", "/app.css", "/app.js"] {
+        let kept = connect_kept(&port);
+        let (kept, status, _, _) = get_kept(&mut port, kept, path, None);
+        assert_eq!(status, 200, "{path}");
+        held.push(kept);
+    }
+    let fourth = connect_kept(&port);
+    let (_fourth, status, _, _) = get_kept(&mut port, fourth, "/api/v1/waiting", Some(&cookie));
+    assert_eq!(
+        status, 200,
+        "the cookie moves its connection to the paired pool"
+    );
+    let _sub = subscribe_cookie(&mut port, &cookie);
+    // The three page connections were held open all along.
+    let first = held.remove(0);
+    let (_, status, _, _) = get_kept(&mut port, first, "/", None);
+    assert_eq!(status, 200, "a page connection is still open");
+}
