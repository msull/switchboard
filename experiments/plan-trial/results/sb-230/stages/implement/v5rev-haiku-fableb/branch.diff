+/// The cookie a browser holds this host's token in. Cookies are scoped
+/// by host and not by port, so two instances on one machine would share
+/// a jar; the server id keeps each host's token under its own name, and
+/// it is stable for the host's life because a key rotation keeps it.
+#[must_use]
+pub fn token_cookie_name(identity: &Identity) -> String {
