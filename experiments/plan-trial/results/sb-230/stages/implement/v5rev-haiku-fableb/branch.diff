--- a/client/Sources/SwitchboardProtocol/Info.swift
+++ b/client/Sources/SwitchboardProtocol/Info.swift
@@ -110,8 +110,30 @@ public struct PairingInvite: Decodable, Sendable, Equatable {
         self.addresses = addresses
     }
 
-    /// The invite from the scanned or pasted text.
+    /// The invite from the scanned or pasted text: the host's page URL,
+    /// with the code, the key and the id in its fragment, or the JSON an
+    /// older host wrote. The URL's authority is kept as text, brackets
+    /// and all, so an IPv6 address reaches the transport as written.
     public static func parse(_ text: String) throws -> PairingInvite {
-        try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+        // Pasted text carries the newline or space around it.
+        let text = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        let prefix = "https://"
+        guard text.hasPrefix(prefix) else {
+            return try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+        }
+        let authority = String(text.dropFirst(prefix.count).prefix { $0 != "/" })
+        let fragment = text.split(separator: "#", maxSplits: 1).dropFirst().first.map(String.init) ?? ""
+        var fields: [String: String] = [:]
+        for pair in fragment.split(separator: "&") {
+            let parts = pair.split(separator: "=", maxSplits: 1).map(String.init)
+            if parts.count == 2 {
+                fields[parts[0]] = parts[1]
+            }
+        }
+        guard !authority.isEmpty, let code = fields["code"], let key = fields["key"], let id = fields["id"] else {
+            throw DecodingError.dataCorrupted(
+                DecodingError.Context(codingPath: [], debugDescription: "the invite URL lacks its host, code, key or id"))
+        }
+        return PairingInvite(serverID: ServerID(id), spkiSha256: key, code: code, addresses: [authority])
     }
 }
