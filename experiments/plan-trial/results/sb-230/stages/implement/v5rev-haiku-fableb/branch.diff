+/// The page names only its own files and runs no script the host did
+/// not ship: no inline script or style, no address outside the host,
+/// and the token never reaches script.
+#[test]
+fn the_page_references_only_what_the_host_serves() {
+    let html = switchboard::web::INDEX_HTML;
+    for attr in ["src=\"", "href=\""] {
+        for rest in html.split(attr).skip(1) {
+            let target = rest.split('"').next().unwrap();
+            assert!(
+                ["/", "/app.css", "/app.js"].contains(&target),
+                "{attr}{target}"
+            );
+        }
+    }
+    for part in html.split("<script").skip(1) {
+        let body = part.split_once('>').unwrap().1;
+        assert!(body.starts_with("</script>"), "a script has a body: {part}");
+    }
+    assert!(!html.contains("<style"), "no inline style");
+    for text in [html, switchboard::web::APP_CSS, switchboard::web::APP_JS] {
+        assert!(!text.contains("style="), "a style attribute");
+        assert!(!text.contains("http://") && !text.contains("https://"));
+    }
+    let js = switchboard::web::APP_JS;
+    assert!(
+        !js.contains("Authorization"),
+        "the token never enters script"
+    );
+    assert!(!js.contains("document.cookie"), "the cookie is never read");
