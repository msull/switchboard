+        .clone();
+    let body = serde_json::json!({
+        "code": code, "spki_sha256": spki, "device_name": device, "transport": "cookie"
+    });
+    let (status, headers, reply) =
+        call_with(port, "POST", "/api/v1/pair", None, None, &body.to_string());
+    assert_eq!(status, 200, "{reply}");
+    header(&headers, "set-cookie")
+        .expect("a cookie")
+        .split("; ")
+        .next()
+        .unwrap()
