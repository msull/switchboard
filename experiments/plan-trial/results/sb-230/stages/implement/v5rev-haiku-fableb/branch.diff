+#[test]
+fn the_page_window_is_rate_limited() {
+    let mut port = port();
+    let mut statuses = Vec::new();
+    for _ in 0..121 {
+        let (status, _, _) = call_text(&mut port, "GET", "/app.css", None, None, "");
+        statuses.push(status);
+    }
+    assert!(statuses[..120].iter().all(|s| *s == 200), "{statuses:?}");
+    assert_eq!(statuses[120], 429);
+}
