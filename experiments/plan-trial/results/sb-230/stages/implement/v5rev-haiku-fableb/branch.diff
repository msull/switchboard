+/// The page's reply for a `GET` of one of its files, or `None` for any
+/// other request. Nothing is cached across versions, and no type is
+/// sniffed away from the one given.
+fn page_reply(request: &RemoteRequest) -> Option<RemoteReply> {
+    if request.method != "GET" {
+        return None;
+    }
+    let (content_type, body) = match request.path.as_str() {
+        "/" => ("text/html; charset=utf-8", crate::web::INDEX_HTML),
+        "/app.css" => ("text/css; charset=utf-8", crate::web::APP_CSS),
+        "/app.js" => ("text/javascript; charset=utf-8", crate::web::APP_JS),
+        _ => return None,
+    };
+    Some(RemoteReply {
+        status: 200,
+        body: body.as_bytes().to_vec(),
+        authenticated: false,
+        headers: vec![
+            ("Content-Type".to_owned(), content_type.to_owned()),
+            ("Content-Security-Policy".to_owned(), PAGE_CSP.to_owned()),
+            ("Cache-Control".to_owned(), "no-store".to_owned()),
+            ("X-Content-Type-Options".to_owned(), "nosniff".to_owned()),
+        ],
+    })
