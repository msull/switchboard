+}
+
+/// The invite a phone opens: the page's URL with the code, the key and
+/// the id in the fragment, which a browser never sends to the host.
+/// `address` is `host:port`; an IPv6 host is bracketed here, so the
+/// authority is a valid URL host.
+#[must_use]
+pub fn pairing_invite(identity: &Identity, address: &str, code: &str) -> String {
+    let authority = match address.rsplit_once(':') {
+        Some((host, port)) if host.contains(':') && !host.starts_with('[') => {
+            format!("[{host}]:{port}")
+        }
+        _ => address.to_owned(),
+    };
+    format!(
+        "https://{authority}/#code={}&key={}&id={}",
+        code.to_ascii_uppercase(),
+        identity.spki_sha256,
+        identity.server_id,
+    )
+}
