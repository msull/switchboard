+/// The page's three files, served before pairing. The policy allows
+/// nothing but the host's own origin: no inline script or style, no
+/// frame, no form posted anywhere, and the socket only to the same host.
+const PAGE_CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
