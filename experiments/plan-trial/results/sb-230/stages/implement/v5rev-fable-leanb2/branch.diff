+/// A write authenticated by the cookie alone must come from the page's
+/// own origin (`https://` and the `Host` header): without an `Origin`
+/// or with another, 403 `origin`; a `GET` needs none; a bearer request
+/// needs none; and the same holds for the upgrade to the events socket.
+#[test]
+fn a_cookie_write_needs_the_pages_origin_and_a_bearer_needs_none() {
+    let mut port = port();
+    let (_, _, session) = seed(&mut port, "");
+    let cookie = pair_by_cookie(&mut port, "ABCD2345", Scope::Control, "Chrome on Android");
+    let token = pair(&mut port, "BCDE3456", Scope::Control, "Pad");
+    let send = format!("/api/v1/sessions/{session}/send");
+    let c = cookie.pair();
+    let body = |op: &str| serde_json::json!({ "op": op, "text": "hello" }).to_string();
+    let r = call_with(&mut port, "POST", &send, &[("Cookie", &c)], &body("o1"));
+    assert_eq!((r.status, code(&r.json())), (403, "origin"), "{}", r.body);
+    let other_port = [("Cookie", c.as_str()), ("Origin", "https://localhost:1")];
+    let r = call_with(&mut port, "POST", &send, &other_port, &body("o1"));
+    assert_eq!((r.status, code(&r.json())), (403, "origin"), "{}", r.body);
+    let elsewhere = [("Cookie", c.as_str()), ("Origin", "https://evil.example")];
+    let r = call_with(&mut port, "POST", &send, &elsewhere, &body("o1"));
+    assert_eq!((r.status, code(&r.json())), (403, "origin"), "{}", r.body);
+    let own = [("Cookie", c.as_str()), ("Origin", "https://localhost")];
+    let r = call_with(&mut port, "POST", &send, &own, &body("o1"));
+    assert_ne!(code(&r.json()), "origin", "{}", r.body);
+    assert_ne!(r.status, 403, "{}", r.body);
+    let r = call_with(&mut port, "GET", "/api/v1/waiting", &[("Cookie", &c)], "");
+    assert_eq!(r.status, 200, "a read needs no Origin: {}", r.body);
+    let (status, reply) = call(&mut port, "POST", &send, Some(&token), &body("o2"));
+    assert_ne!(code(&reply), "origin", "{status} {reply}");
+    assert_ne!(status, 403, "{reply}");
+
+    let foreign = subscribe_with(
+        &mut port,
+        vec![
+            ("Cookie".into(), c.clone()),
+            ("Origin".into(), "https://evil.example".into()),
+        ],
+        "/api/v1/events",
+    );
+    assert!(foreign.is_err(), "a foreign upgrade is refused");
+    let bare = subscribe_with(
+        &mut port,
+        vec![("Cookie".into(), c.clone())],
+        "/api/v1/events",
+    );
+    assert!(bare.is_err(), "an upgrade with no Origin is refused");
+    let own = subscribe_with(
+        &mut port,
+        vec![
+            ("Cookie".into(), c),
+            ("Origin".into(), "https://localhost".into()),
+        ],
+        "/api/v1/events",
+    );
+    assert!(own.is_ok(), "{:?}", own.err());
+    assert_eq!(port.app.subscriber_count(), 1);
+}
