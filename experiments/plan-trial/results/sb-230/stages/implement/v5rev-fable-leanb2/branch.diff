+/// `/me` says the device's scope as the dialog sets it; after Revoke
+/// the cookie is the same 401 as an unknown token and `/info` still
+/// names the same host, which is what lets the page say "removed".
+#[test]
+fn me_follows_the_scope_and_a_revoked_cookie_is_refused_while_info_is_unchanged() {
+    let mut port = port();
+    let cookie = pair_by_cookie(&mut port, "ABCD2345", Scope::Read, "Safari on iPad");
+    let (_, before) = get(&mut port, "/api/v1/info", None);
+    let c = cookie.pair();
+    let r = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &c)], "");
+    assert_eq!(r.json()["body"]["scope"], "read");
+    let device = port.app.core().devices()[0].id;
+    port.app.dispatch(AppAction::SetDeviceScope {
+        device,
+        scope: Scope::Control,
+    });
+    let r = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &c)], "");
+    assert_eq!(r.json()["body"]["scope"], "control");
+    port.app.dispatch(AppAction::RevokeDevice(device));
+    let r = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &c)], "");
+    assert_eq!((r.status, code(&r.json())), (401, "unauthorized"));
+    let (_, after) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(after["body"]["server_id"], before["body"]["server_id"]);
+    assert_eq!(after["body"]["spki_sha256"], before["body"]["spki_sha256"]);
+}
