+/// The three files are served to anyone, on the connection thread, with
+/// the headers that keep the page to itself and a closed connection;
+/// everything else outside the API is still the JSON 404; a query on a
+/// page path is ignored and never comes back; and every JSON reply now
+/// carries the browser's two headers too.
+#[test]
+fn the_page_is_served_to_anyone_and_the_rest_outside_the_api_is_still_json() {
+    let mut port = port();
+    for (path, content_type) in [
+        ("/", "text/html; charset=utf-8"),
+        ("/app.js", "text/javascript; charset=utf-8"),
+        ("/app.css", "text/css; charset=utf-8"),
+    ] {
+        let r = http_with(port.addr, &port.client, "GET", path, &[], "").unwrap();
+        assert_eq!(r.status, 200, "{path}");
+        assert_eq!(r.header("content-type"), Some(content_type), "{path}");
+        assert_eq!(r.header("content-security-policy"), Some(web::CSP));
+        assert_eq!(r.header("cache-control"), Some("no-store"));
+        assert_eq!(r.header("x-content-type-options"), Some("nosniff"));
+        assert_eq!(r.header("referrer-policy"), Some("no-referrer"));
+        assert_eq!(r.header("connection"), Some("close"));
+        assert_eq!(r.body, web::page(path).unwrap().body);
+    }
+    let r = http_with(
+        port.addr,
+        &port.client,
+        "GET",
+        "/?code=SECRETCODE&key=k",
+        &[],
+        "",
+    )
+    .unwrap();
+    assert_eq!(r.status, 200);
+    assert!(!r.body.contains("SECRETCODE"), "a query is not echoed");
+    for (method, path) in [
+        ("GET", "/favicon.ico"),
+        ("POST", "/"),
+        ("GET", "/api"),
+        ("GET", "/index.html"),
+        ("HEAD", "/app.js"),
+    ] {
+        let (status, reply) = call(&mut port, method, path, None, "");
+        assert_eq!(
+            (status, code(&reply)),
+            (404, "not_found"),
+            "{method} {path}: {reply}"
+        );
+    }
+    let r = call_with(&mut port, "GET", "/api/v1/info", &[], "");
+    assert_eq!(r.header("cache-control"), Some("no-store"));
+    assert_eq!(r.header("x-content-type-options"), Some("nosniff"));
+    assert_eq!(r.header("content-type"), Some("application/json"));
+}
