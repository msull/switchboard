+        format!("{}={}", self.name, self.token)
+    }
+}
+
+/// Pair as the page does: `/pair` with `transport: "cookie"`, the token
+/// taken from `Set-Cookie` and never from the body.
+fn pair_by_cookie(port: &mut Port, code: &str, scope: Scope, name: &str) -> Cookie {
+    port.app.dispatch(AppAction::OpenPairing {
+        code: code.into(),
+        scope,
+    });
+    let spki = port
+        .remote
+        .state()
+        .identity
+        .as_ref()
+        .unwrap()
+        .spki_sha256
+        .clone();
+    let body = serde_json::json!({
+        "code": code, "device_name": name, "spki_sha256": spki, "transport": "cookie",
+    });
+    let r = call_with(port, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(r.status, 200, "{}", r.body);
+    let reply = r.json();
+    assert!(
+        reply["body"].get("token").is_none(),
+        "no token in the body: {reply}"
+    );
+    let set_cookie = r.header("set-cookie").expect("Set-Cookie");
+    let (pair, _) = set_cookie.split_once(';').unwrap();
+    let (name, token) = pair.split_once('=').unwrap();
+    Cookie {
+        name: name.to_owned(),
+        token: token.to_owned(),
+        device_id: reply["body"]["device_id"].as_str().unwrap().to_owned(),
+    }
+}
