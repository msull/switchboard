+/// A browser pairs as the CLI does, `/info` then `/pair`, asking for its
+/// token as a cookie: the reply sets `__Host-sb-<server_id>` as an
+/// `HttpOnly` cookie and carries no token, and the cookie alone reads
+/// `/me`. A native pairing is unchanged: the token in the body, no cookie.
+#[test]
+fn a_browser_pairs_by_cookie_and_the_cookie_alone_reads_me() {
+    let mut port = port();
+    let (_, info) = get(&mut port, "/api/v1/info", None);
+    let spki = info["body"]["spki_sha256"].as_str().unwrap().to_owned();
+    let server_id = info["body"]["server_id"].as_str().unwrap().to_owned();
+    port.app.dispatch(AppAction::OpenPairing {
+        code: "ABCD2345".into(),
+        scope: Scope::Read,
+    });
+    let body = serde_json::json!({
+        "code": "abcd2345", "spki_sha256": spki,
+        "device_name": "Safari on iPhone", "transport": "cookie",
+    })
+    .to_string();
+    let r = call_with(&mut port, "POST", "/api/v1/pair", &[], &body);
+    assert_eq!(r.status, 200, "{}", r.body);
+    let reply = r.json();
+    assert!(reply["body"].get("token").is_none(), "{reply}");
+    assert_eq!(reply["body"]["server_id"], server_id);
+    assert_eq!(reply["body"]["scope"], "read");
+    let set_cookie = r.header("set-cookie").expect("Set-Cookie").to_owned();
+    let (pair, attrs) = set_cookie.split_once(';').unwrap();
+    let (name, token) = pair.split_once('=').unwrap();
+    assert_eq!(name, format!("__Host-sb-{server_id}"));
+    assert_eq!(token.len(), 43);
+    let attrs: Vec<&str> = attrs.split(';').map(str::trim).collect();
+    for attr in [
+        "HttpOnly",
+        "Secure",
+        "SameSite=Strict",
+        "Path=/",
+        "Max-Age=34560000",
+    ] {
+        assert!(attrs.contains(&attr), "{attr} in {set_cookie}");
+    }
+    assert!(
+        !attrs.iter().any(|a| a.starts_with("Domain")),
+        "{set_cookie}"
+    );
+
+    let cookie = format!("{name}={token}");
+    let r = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!(r.status, 200, "{}", r.body);
+    let me = r.json();
+    assert_eq!(me["body"]["name"], "Safari on iPhone");
+    assert_eq!(me["body"]["scope"], "read");
+    assert_eq!(me["body"]["server_id"], server_id);
+    assert_eq!(me["body"]["server_name"], info["body"]["server_name"]);
+    assert_eq!(me["body"]["device_id"], reply["body"]["device_id"]);
+    // Among other cookies, and on every read a token reads.
+    let many = format!("theme=dark; {cookie}; other=1");
+    let r = call_with(
+        &mut port,
+        "GET",
+        "/api/v1/waiting",
+        &[("Cookie", &many)],
+        "",
+    );
+    assert_eq!(r.status, 200, "{}", r.body);
+    assert_eq!(port.app.core().devices()[0].name, "Safari on iPhone");
+    // The bearer header still reads nothing without a token.
+    let (status, reply) = get(&mut port, "/api/v1/me", None);
+    assert_eq!((status, code(&reply)), (401, "unauthorized"));
+
+    port.app.dispatch(AppAction::OpenPairing {
+        code: "BCDE3456".into(),
+        scope: Scope::Read,
+    });
+    let body = serde_json::json!({
+        "code": "BCDE3456", "spki_sha256": spki, "device_name": "Vision Pro",
+    })
+    .to_string();
+    let r = call_with(&mut port, "POST", "/api/v1/pair", &[], &body);
+    assert_eq!(r.status, 200, "{}", r.body);
+    let native = r.json();
+    assert_eq!(native["body"]["token"].as_str().unwrap().len(), 43);
+    assert!(
+        r.header("set-cookie").is_none(),
+        "no cookie for a native client"
+    );
+    let (status, me) = get(
+        &mut port,
+        "/api/v1/me",
+        Some(native["body"]["token"].as_str().unwrap()),
+    );
+    assert_eq!(status, 200, "{me}");
+    assert_eq!(me["body"]["name"], "Vision Pro");
+}
