-    /// The invite from the scanned or pasted text.
+    /// The invite from the scanned or pasted text: the URL form, or the
+    /// JSON form.
     public static func parse(_ text: String) throws -> PairingInvite {
-        try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.lowercased().hasPrefix("https://") {
+            return try fromURL(trimmed)
+        }
+        return try Wire.decode(PairingInvite.self, from: Data(trimmed.utf8))
+    }
+
+    /// The URL form. The fragment carries `code`, `key` and `id`; the
+    /// authority is the one address. Anything missing is an error, as a
+    /// malformed JSON invite is.
+    static func fromURL(_ text: String) throws -> PairingInvite {
+        func corrupt(_ why: String) -> DecodingError {
+            DecodingError.dataCorrupted(
+                DecodingError.Context(codingPath: [], debugDescription: "invite URL: \(why)"))
+        }
+        guard let components = URLComponents(string: text), let host = components.host,
+            !host.isEmpty
+        else { throw corrupt("no address") }
+        guard let fragment = components.fragment else { throw corrupt("no fragment") }
+        var fields: [String: String] = [:]
+        for pair in fragment.split(separator: "&") {
+            let parts = pair.split(separator: "=", maxSplits: 1, omittingEmptySubsequences: false)
+            guard parts.count == 2 else { continue }
+            fields[String(parts[0])] = String(parts[1]).removingPercentEncoding ?? String(parts[1])
+        }
+        guard let code = fields["code"], !code.isEmpty else { throw corrupt("no code") }
+        guard let key = fields["key"], !key.isEmpty else { throw corrupt("no key") }
+        guard let id = fields["id"], !id.isEmpty else { throw corrupt("no id") }
+        let port = components.port ?? 443
+        // Foundation differs on whether an IPv6 host keeps its brackets.
+        let bare = host.trimmingCharacters(in: CharacterSet(charactersIn: "[]"))
+        let address = bare.contains(":") ? "[\(bare)]:\(port)" : "\(bare):\(port)"
+        return PairingInvite(
+            serverID: ServerID(id), spkiSha256: key.lowercased(), code: code.uppercased(),
+            addresses: [address])
     }
 }
