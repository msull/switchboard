+/// A page reply closes its connection, so loads in a row never hold
+/// the pool; five at once against a pool of four are measured; and the
+/// page has a window of its own, 120 a minute, which leaves `/info` and
+/// `/pair` theirs.
+#[test]
+fn page_loads_free_their_slot_and_have_their_own_window() {
+    let first = port();
+    for _ in 0..=MAX_UNAUTHENTICATED {
+        let r = http_with(first.addr, &first.client, "GET", "/app.css", &[], "").unwrap();
+        assert_eq!(r.status, 200);
+    }
+    let served = (0..5)
+        .map(|_| {
+            let addr = first.addr;
+            let config = Arc::clone(&first.client);
+            std::thread::spawn(move || {
+                http_with(addr, &config, "GET", "/app.js", &[], "").is_ok_and(|r| r.status == 200)
+            })
+        })
+        .collect::<Vec<_>>()
+        .into_iter()
+        .filter_map(|t| t.join().unwrap().then_some(()))
+        .count();
+    eprintln!("parallel page requests served: {served} of 5 against a pool of 4");
+    assert!(served >= MAX_UNAUTHENTICATED, "{served}");
+    drop(first);
+
+    let mut port = port();
+    for n in 0..PAGE_PER_MINUTE {
+        let r = http_with(port.addr, &port.client, "GET", "/", &[], "").unwrap();
+        assert_eq!(r.status, 200, "page request {n}");
+    }
+    let r = http_with(port.addr, &port.client, "GET", "/app.js", &[], "").unwrap();
+    assert_eq!((r.status, code(&r.json())), (429, "rate_limited"));
+    let (status, _) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200, "info has its own window");
+    let (status, reply) = call(&mut port, "POST", "/api/v1/pair", None, "{}");
+    assert_eq!(
+        (status, code(&reply)),
+        (403, "pairing_closed"),
+        "pair has its own window"
+    );
+}
+
+/// The page's pure parts (`web/app.test.js`) under `node --test`;
+/// skipped where node is absent, as the tmux tests are.
+#[test]
+fn the_pages_pure_parts_pass_under_node() {
+    let test = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("web/app.test.js");
+    let out = match std::process::Command::new("node")
+        .arg("--test")
+        .arg(&test)
+        .output()
+    {
+        Ok(out) => out,
+        Err(e) => {
+            eprintln!("skipping the page's node tests: {e}");
+            return;
+        }
+    };
+    assert!(
+        out.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
