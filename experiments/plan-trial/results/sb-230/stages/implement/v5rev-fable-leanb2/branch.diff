+/// The embedded page references only what the host serves: every `src`
+/// and `href` in `index.html` is a served path or `data:`, every API
+/// route in `app.js` answers a paired device with something other than
+/// `not_found`, and the guards hold: no inline script or style, no
+/// event attribute, no `innerHTML`.
+#[test]
+fn the_embedded_page_references_only_paths_the_host_serves() {
+    let html = web::page("/").unwrap().body;
+    let js = web::page("/app.js").unwrap().body;
+    for attr in ["src=\"", "href=\""] {
+        for rest in html.split(attr).skip(1) {
+            let value = rest.split('"').next().unwrap();
+            assert!(
+                value == "data:," || web::page(value).is_some(),
+                "{attr}{value} is not served"
+            );
+        }
+    }
+    assert!(!html.contains("<script>"), "no inline script");
+    assert!(!html.contains("<style"), "no inline style sheet");
+    assert!(!html.contains("style=\""), "no style attribute");
+    let lower = html.to_ascii_lowercase();
+    assert!(
+        !lower
+            .split(|c: char| c.is_whitespace() || c == '<')
+            .any(|w| w.starts_with("on") && w.contains('=')),
+        "no event attribute"
+    );
+    for banned in [
+        "innerHTML",
+        "outerHTML",
+        "eval(",
+        "document.write",
+        "insertAdjacentHTML",
+        "new Function",
+    ] {
+        assert!(!js.contains(banned), "{banned} in app.js");
+    }
+
+    let mut port = port();
+    port.transcripts.set(Some(conversation(1)));
+    let (_, project, session) = seed(&mut port, "");
+    launched(&mut port, &session);
+    let token = pair(&mut port, "ABCD2345", Scope::Control, "Safari on iPhone");
+    let routes: Vec<String> = js
+        .match_indices("/api/v1/")
+        .map(|(i, _)| js[i..].split(['\'', '"', '`']).next().unwrap().to_owned())
+        .collect();
+    assert!(routes.len() >= 9, "{routes:?}");
+    for route in routes {
+        let id = if route.contains("projects/{id}") {
+            &project
+        } else {
+            &session
+        };
+        let path = route.replace("{id}", id);
+        let (method, body) = if path.ends_with("/pair") || path.ends_with("/send") {
+            ("POST", r#"{"op":"o1","text":"hi"}"#)
+        } else {
+            ("GET", "")
+        };
+        let (status, reply) = call(&mut port, method, &path, Some(&token), body);
+        assert_ne!(
+            code(&reply),
+            "not_found",
+            "{route} as {path}: {status} {reply}"
+        );
+    }
+}
