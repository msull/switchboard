@@ -0,0 +1,70 @@
+//! The web control surface's files, embedded: the three files under
+//! `web/` the remote port serves before pairing, each with its content
+//! type, and the headers that keep the page to itself. The connection
+//! thread answers them from this table without reaching the frame; the
+//! bytes are constant, so there is nothing for the core to decide.
+
+/// One file the port serves at `path`.
+pub struct Page {
+    pub path: &'static str,
+    pub content_type: &'static str,
+    pub body: &'static str,
+}
+
+/// The files, matched by exact path. `index.html` declares a `data:`
+/// icon so a browser never asks for `/favicon.ico`.
+pub const PAGES: [Page; 3] = [
+    Page {
+        path: "/",
+        content_type: "text/html; charset=utf-8",
+        body: include_str!("../../web/index.html"),
+    },
+    Page {
+        path: "/app.js",
+        content_type: "text/javascript; charset=utf-8",
+        body: include_str!("../../web/app.js"),
+    },
+    Page {
+        path: "/app.css",
+        content_type: "text/css; charset=utf-8",
+        body: include_str!("../../web/app.css"),
+    },
+];
+
+/// What the page may load and talk to: its own files, its own API, and
+/// nothing else. No inline script or style, no framing, no form posts.
+/// `connect-src 'self'` is what admits `wss:` to the same host where a
+/// browser allows it; where one does not, the events socket is what is
+/// lost and polling carries.
+pub const CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+/// The headers on every page reply, beyond the content type, length
+/// and `Connection: close` the writer adds.
+pub const HEADERS: [(&str, &str); 4] = [
+    ("Content-Security-Policy", CSP),
+    ("Cache-Control", "no-store"),
+    ("X-Content-Type-Options", "nosniff"),
+    ("Referrer-Policy", "no-referrer"),
+];
+
+/// The file at `path`, matched exactly; a query was already split off.
+#[must_use]
+pub fn page(path: &str) -> Option<&'static Page> {
+    PAGES.iter().find(|p| p.path == path)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_three_files_are_found_by_exact_path_and_nothing_else_is() {
+        assert_eq!(page("/").unwrap().content_type, "text/html; charset=utf-8");
+        assert!(page("/app.js").unwrap().body.contains("/api/v1/"));
+        assert!(page("/app.css").is_some());
+        assert!(page("/index.html").is_none());
+        assert!(page("/favicon.ico").is_none());
+        assert!(page("").is_none());
+        assert!(page("/app.js/").is_none());
+    }
+}
