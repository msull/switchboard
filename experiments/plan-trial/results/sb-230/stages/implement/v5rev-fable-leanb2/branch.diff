+/// Two instances on one Mac share one address, so a browser's cookie
+/// jar holds both their cookies: each is named for its server id, each
+/// host reads only its own, and the fixed name authenticates nothing.
+#[test]
+fn two_hosts_set_differently_named_cookies_and_each_reads_only_its_own() {
+    let mut a = port();
+    let mut b = port();
+    let ca = pair_by_cookie(&mut a, "ABCD2345", Scope::Read, "Safari on iPhone");
+    let cb = pair_by_cookie(&mut b, "ABCD2345", Scope::Read, "Safari on iPhone");
+    assert_ne!(ca.name, cb.name);
+    assert!(ca.name.starts_with("__Host-sb-"));
+    let both = format!("{}; {}", ca.pair(), cb.pair());
+    let r = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", &both)], "");
+    assert_eq!(r.status, 200, "{}", r.body);
+    assert_eq!(r.json()["body"]["device_id"], ca.device_id);
+    let r = call_with(&mut b, "GET", "/api/v1/me", &[("Cookie", &both)], "");
+    assert_eq!(r.status, 200, "{}", r.body);
+    assert_eq!(r.json()["body"]["device_id"], cb.device_id);
+    // Only the other host's cookie: a stranger.
+    let r = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", &cb.pair())], "");
+    assert_eq!((r.status, code(&r.json())), (401, "unauthorized"));
+    let r = call_with(&mut b, "GET", "/api/v1/me", &[("Cookie", &ca.pair())], "");
+    assert_eq!((r.status, code(&r.json())), (401, "unauthorized"));
+    // The fixed name, with a valid token under it.
+    let fixed = format!("__Host-sb={}", ca.token);
+    let r = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", &fixed)], "");
+    assert_eq!((r.status, code(&r.json())), (401, "unauthorized"));
+}
