@@ -0,0 +1,184 @@
+//! A throwaway HTTPS server over a certificate made as the app's
+//! `make_identity` makes it (P-256, self-signed, no subject alternative
+//! name): one page whose script asks the server to set
+//! `__Host-sb-<id>` as an `HttpOnly` cookie, reads `/me` back to see
+//! whether the browser sent it, reports what `document.cookie` shows
+//! (it should be nothing), and opens `wss://` to the same host under the
+//! app's Content-Security-Policy to see whether `connect-src 'self'`
+//! admits it. Run two with different `--id` and `--port` to see that
+//! neither cookie overwrites the other.
+//!
+//! Usage: `spike-web-page --port 8443 --id alpha`
+
+use std::io::{BufRead, BufReader, Read, Write};
+use std::net::TcpListener;
+use std::sync::Arc;
+
+use rustls::pki_types::{CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer};
+use rustls::{ServerConfig, ServerConnection, StreamOwned};
+
+const CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+const PAGE: &str = r#"<!doctype html><html><head><meta charset="utf-8"><link rel="icon" href="data:,"><title>spike 23</title></head>
+<body><pre id="out">running</pre><script src="/app.js"></script></body></html>"#;
+
+const SCRIPT: &str = r#"
+const out = document.getElementById('out');
+const lines = [];
+function say(s) { lines.push(s); out.textContent = lines.join('\n'); }
+(async () => {
+  say('host ' + location.host);
+  const set = await fetch('/set', { credentials: 'same-origin' });
+  say('set: ' + set.status + ' ' + await set.text());
+  const me = await fetch('/me', { credentials: 'same-origin' });
+  say('me: ' + set.status + ' ' + await me.text());
+  say('document.cookie: "' + document.cookie + '"');
+  await new Promise((done) => {
+    let settled = false;
+    const finish = (s) => { if (!settled) { settled = true; say(s); done(); } };
+    try {
+      const ws = new WebSocket('wss://' + location.host + '/ws');
+      ws.addEventListener('open', () => finish('wss: open'));
+      ws.addEventListener('error', () => finish('wss: error'));
+      ws.addEventListener('close', (e) => finish('wss: close ' + e.code));
+      setTimeout(() => finish('wss: no event in 3 s'), 3000);
+    } catch (e) {
+      finish('wss: threw ' + e);
+    }
+  });
+  say('done');
+})();
+"#;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let arg = |name: &str, default: &str| {
+        args.iter()
+            .position(|a| a == name)
+            .and_then(|i| args.get(i + 1))
+            .cloned()
+            .unwrap_or_else(|| default.to_owned())
+    };
+    let port: u16 = arg("--port", "8443").parse().expect("port");
+    let id = arg("--id", "alpha");
+    let key = rcgen::KeyPair::generate().expect("key");
+    let mut params = rcgen::CertificateParams::new(Vec::<String>::new()).expect("params");
+    params
+        .distinguished_name
+        .push(rcgen::DnType::CommonName, format!("Switchboard {id}"));
+    let cert = params.self_signed(&key).expect("certificate");
+    let config = ServerConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .expect("versions")
+    .with_no_client_auth()
+    .with_single_cert(
+        vec![CertificateDer::from(cert.der().to_vec())],
+        PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(key.serialize_der())),
+    )
+    .expect("config");
+    let config = Arc::new(config);
+    let listener = TcpListener::bind(("0.0.0.0", port)).expect("bind");
+    eprintln!("spike 23: https://127.0.0.1:{port}/ as {id}");
+    for stream in listener.incoming().flatten() {
+        let config = Arc::clone(&config);
+        let id = id.clone();
+        std::thread::spawn(move || {
+            let conn = ServerConnection::new(config).expect("connection");
+            let mut tls = StreamOwned::new(conn, stream);
+            if tls.conn.complete_io(&mut tls.sock).is_err() {
+                return;
+            }
+            let mut reader = BufReader::new(tls);
+            loop {
+                let Some((path, headers)) = read_head(&mut reader) else {
+                    return;
+                };
+                let header = |name: &str| {
+                    headers
+                        .iter()
+                        .find(|(n, _)| n == name)
+                        .map(|(_, v)| v.clone())
+                };
+                let write = reader.get_mut();
+                let out = match path.as_str() {
+                    "/" => reply(200, "text/html; charset=utf-8", PAGE, &[]),
+                    "/app.js" => reply(200, "text/javascript; charset=utf-8", SCRIPT, &[]),
+                    "/set" => reply(
+                        200,
+                        "application/json",
+                        &format!("{{\"set\":\"{id}\"}}"),
+                        &[&format!(
+                            "Set-Cookie: __Host-sb-{id}=tok-{id}; Max-Age=34560000; Path=/; Secure; HttpOnly; SameSite=Strict"
+                        )],
+                    ),
+                    "/me" => reply(
+                        200,
+                        "application/json",
+                        &format!(
+                            "{{\"server\":\"{id}\",\"cookie\":\"{}\"}}",
+                            header("cookie").unwrap_or_default()
+                        ),
+                        &[],
+                    ),
+                    "/ws" => {
+                        let Some(key) = header("sec-websocket-key") else {
+                            return;
+                        };
+                        let accept = tungstenite::handshake::derive_accept_key(key.as_bytes());
+                        let _ = write.write_all(
+                            format!("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept}\r\n\r\n")
+                                .as_bytes(),
+                        );
+                        let _ = write.flush();
