+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="referrer" content="no-referrer">
+<title>Switchboard</title>
+<link rel="icon" href="data:,">
+<link rel="stylesheet" href="/app.css">
