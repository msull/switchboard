+    let identity = port.remote.state().identity.clone().unwrap();
+    let invite = pairing_invite(&identity, "127.0.0.1:43187", code);
+    let fragment: std::collections::HashMap<&str, &str> = invite
+        .split_once('#')
+        .unwrap()
+        .1
+        .split('&')
+        .filter_map(|p| p.split_once('='))
+        .collect();
+    let (_, info) = get(port, "/api/v1/info", None);
+    assert_eq!(info["body"]["spki_sha256"], fragment["key"]);
+    assert_eq!(info["body"]["server_id"], fragment["id"]);
+    let body = serde_json::json!({
+        "code": fragment["code"],
+        "spki_sha256": fragment["key"],
+        "device_name": name,
+        "transport": "cookie",
+    });
+    let (status, headers, text) = call_raw(
+        port,
+        "POST",
+        "/api/v1/pair",
+        (None, None),
+        &body.to_string(),
+    );
+    assert_eq!(status, 200, "{text}");
+    let reply: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert!(reply["body"].get("token").is_none(), "{reply}");
+    let set = header(&headers, "set-cookie").expect("a cookie").to_owned();
+    let pair = set.split(';').next().unwrap().to_owned();
+    (pair, set)
+}
+
+#[test]
+fn a_browser_pairs_from_the_invite_and_reads_through_its_cookie() {
+    let mut port = port();
+    let (pair, set) = pair_as_browser(&mut port, "ABCD2345", "Safari on iPhone");
+    let identity = port.remote.state().identity.clone().unwrap();
+    let name = token_cookie_name(&identity);
+    assert_eq!(name, format!("switchboard_token_{}", identity.server_id));
+    assert!(pair.starts_with(&format!("{name}=")), "{set}");
+    for attribute in ["HttpOnly", "Secure", "SameSite=Strict", "Path=/api/v1/"] {
+        assert!(set.contains(attribute), "{attribute} in {set}");
+    }
+    assert!(!set.contains("Domain"), "{set}");
+    let token = pair.split_once('=').unwrap().1.to_owned();
+
+    let (status, _, text) = call_raw(&mut port, "GET", "/api/v1/waiting", (None, Some(&pair)), "");
+    assert_eq!(status, 200, "{text}");
+    let device = port.app.core().devices()[0].clone();
+    assert_eq!(device.name, "Safari on iPhone");
+    assert!(
+        device.last_seen.is_some(),
+        "the cookie request marked it seen"
+    );
+    let sub = subscribe_cookie(&mut port, &pair);
+
+    // A bearer outranks the cookie.
+    let bad = format!("{name}=not-a-token");
+    let (status, _, _) = call_raw(
+        &mut port,
+        "GET",
+        "/api/v1/waiting",
+        (Some(&token), Some(&bad)),
+        "",
+    );
+    assert_eq!(status, 200);
+
+    // Another host's cookie name is ignored, even holding this host's token.
+    let other = format!("switchboard_token_{}={token}", uuid::Uuid::new_v4());
+    let (status, headers, _) = call_raw(
+        &mut port,
+        "GET",
+        "/api/v1/waiting",
+        (None, Some(&other)),
+        "",
+    );
+    assert_eq!(status, 401);
+    assert!(header(&headers, "set-cookie").is_none(), "{headers:?}");
+    let both = format!("{other}; {pair}");
+    let (status, _, _) = call_raw(&mut port, "GET", "/api/v1/waiting", (None, Some(&both)), "");
+    assert_eq!(status, 200, "through the right name");
+
+    port.app.dispatch(AppAction::RevokeDevice(device.id));
+    match next_frame(&mut port, &sub, 5) {
+        Some(Err(reason)) => assert!(reason.starts_with("closed"), "{reason}"),
+        other => panic!("expected the close, got {other:?}"),
+    }
+    let (status, headers, _) =
+        call_raw(&mut port, "GET", "/api/v1/waiting", (None, Some(&pair)), "");
+    assert_eq!(status, 401);
+    let clearing = header(&headers, "set-cookie").expect("a clearing cookie");
+    assert!(clearing.starts_with(&format!("{name}=;")), "{clearing}");
+    assert!(clearing.contains("Max-Age=0"), "{clearing}");
+
+    // The native pairing is as it was: the token in the body, no cookie.
+    port.app.dispatch(AppAction::OpenPairing {
+        code: "WXYZ2345".into(),
+        scope: Scope::Read,
+    });
+    let body = serde_json::json!({
+        "code": "WXYZ2345", "device_name": "Pad", "spki_sha256": identity.spki_sha256
+    });
+    let (status, headers, text) = call_raw(
+        &mut port,
+        "POST",
+        "/api/v1/pair",
+        (None, None),
+        &body.to_string(),
+    );
+    assert_eq!(status, 200, "{text}");
+    assert!(header(&headers, "set-cookie").is_none());
+    let reply: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(reply["body"]["token"].as_str().map(str::len), Some(43));
+}
+
+/// A connection that asked for `path`, read the answer and keeps the
+/// socket open until `release` is sent.
+fn hold_page(
+    port: &mut Port,
+    path: &str,
+) -> (std::thread::JoinHandle<()>, std::sync::mpsc::Sender<()>) {
+    let (addr, config, path) = (port.addr, Arc::clone(&port.client), path.to_owned());
+    let (ready_tx, ready) = std::sync::mpsc::channel();
+    let (release, wait) = std::sync::mpsc::channel::<()>();
+    let thread = std::thread::spawn(move || {
+        let tcp = TcpStream::connect(addr).expect("connect");
+        tcp.set_read_timeout(Some(Duration::from_secs(10))).unwrap();
+        let conn = ClientConnection::new(config, ServerName::try_from("localhost").unwrap())
+            .expect("client");
+        let mut s = StreamOwned::new(conn, tcp);
+        while s.conn.is_handshaking() {
+            s.conn.complete_io(&mut s.sock).expect("handshake");
+        }
+        write!(s, "GET {path} HTTP/1.1\r\nHost: localhost\r\n\r\n").unwrap();
+        s.flush().unwrap();
+        let mut reader = BufReader::new(s);
+        let mut length = 0usize;
+        let mut line = String::new();
+        reader.read_line(&mut line).unwrap();
+        assert!(line.contains("200"), "{line}");
+        loop {
+            let mut h = String::new();
+            reader.read_line(&mut h).unwrap();
+            let h = h.trim_end();
+            if h.is_empty() {
+                break;
+            }
+            if let Some((n, v)) = h.split_once(':')
+                && n.eq_ignore_ascii_case("content-length")
+            {
+                length = v.trim().parse().unwrap();
+            }
+        }
+        let mut body = vec![0; length];
+        reader.read_exact(&mut body).unwrap();
+        ready_tx.send(()).unwrap();
+        let _ = wait.recv_timeout(Duration::from_secs(20));
+    });
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while ready.try_recv().is_err() {
+        assert!(std::time::Instant::now() < deadline, "no page");
+        port.app.serve_pending();
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    (thread, release)
+}
+
+/// What a page load asks of the stranger pool: three kept-alive
+/// connections for the three files, then the first authenticated
+/// request and the socket, while all three are still open.
+#[test]
+fn a_page_load_fits_the_stranger_pool() {
+    let mut port = port();
+    let (pair, _) = pair_as_browser(&mut port, "ABCD2345", "Safari on iPhone");
+    let held: Vec<_> = PAGE_FILES
+        .iter()
+        .map(|(path, _)| hold_page(&mut port, path))
+        .collect();
+    let (status, _, text) = call_raw(&mut port, "GET", "/api/v1/waiting", (None, Some(&pair)), "");
+    assert_eq!(status, 200, "{text}");
+    let _sub = subscribe_cookie(&mut port, &pair);
+    for (thread, release) in held {
+        release.send(()).unwrap();
+        thread.join().unwrap();
+    }
+}
+
+#[test]
+fn the_page_window_is_rate_limited() {
+    let mut port = port();
+    let mut statuses = Vec::new();
+    for _ in 0..121 {
+        let (status, _, _) = call_raw(&mut port, "GET", "/app.css", (None, None), "");
+        statuses.push(status);
+    }
+    assert!(statuses[..120].iter().all(|s| *s == 200));
+    assert_eq!(statuses[120], 429);
+    let (status, _) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200, "info has its own limit");
+}
