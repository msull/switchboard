index 0000000..b86ea2c
--- /dev/null
+++ b/web/app.js
@@ -0,0 +1,360 @@
+"use strict";
+
+// The page holds no token: the host sets it as an HttpOnly cookie when
+// pairing and the browser attaches it to every request and to the
+// WebSocket. What is kept here is public (the host's id and key, which
+// `/info` serves to anyone) plus the scope, to know whether to show the
+// reply box.
+const API = "/api/v1/";
+const STORE = "switchboard_pairing";
+const POLL_MS = 5000;
+const RETRY_SOCKET_MS = 30000;
+
+const $ = (id) => document.getElementById(id);
+const main = $("main");
+
+const state = {
+  info: null,
+  scope: "read",
+  rev: { projects: -1 },
+  projects: [],
+  sessions: [], // each session view with its project name attached
+  open: null, // the session being read
+  text: "",
+  socket: null,
+  live: false,
+  timer: null,
+  refreshing: false,
+};
+
+function el(tag, attrs, ...kids) {
+  const e = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs || {})) {
+    if (k === "class") e.className = v;
+    else if (k.startsWith("on")) e.addEventListener(k.slice(2), v);
+    else e[k] = v;
+  }
+  for (const kid of kids) e.append(kid);
+  return e;
+}
+
+function notice(text, ...more) {
+  main.replaceChildren(el("div", { class: "notice" }, text), ...more);
+}
+
+function readStored() {
+  try {
+    return JSON.parse(localStorage.getItem(STORE)) || null;
+  } catch {
+    return null;
+  }
+}
+
+async function call(method, path, body) {
+  const init = { method, credentials: "same-origin", cache: "no-store" };
+  if (body !== undefined) {
+    init.headers = { "Content-Type": "application/json" };
+    init.body = JSON.stringify(body);
+  }
+  const res = await fetch(API + path, init);
+  let json = null;
+  try {
+    json = await res.json();
+  } catch {
+    // an empty or non-JSON body is read as no body
+  }
+  return { status: res.status, json };
+}
+
+function deviceName() {
+  const ua = navigator.userAgent;
+  if (/iPhone/.test(ua)) return "Safari on iPhone";
+  if (/iPad/.test(ua)) return "Safari on iPad";
+  if (/Android/.test(ua)) return /Firefox/.test(ua) ? "Firefox on Android" : "Chrome on Android";
+  if (/Macintosh/.test(ua)) return navigator.maxTouchPoints > 1 ? "Safari on iPad" : /Chrome/.test(ua) ? "Chrome on Mac" : "Safari on Mac";
+  if (/Windows/.test(ua)) return "Browser on Windows";
+  if (/Linux/.test(ua)) return "Browser on Linux";
+  return "Browser";
+}
+
+// The invite rides in the fragment, which is never sent to the host.
+// It is cleared before any request so it does not stay in the address bar.
+function takeInvite() {
+  const params = new URLSearchParams(location.hash.slice(1));
+  const code = params.get("code");
+  const key = params.get("key");
+  const id = params.get("id");
+  if (!code || !key || !id) return null;
+  history.replaceState(null, "", "/");
+  return { code, key, id };
+}
+
+async function start() {
+  const invite = takeInvite();
+  const stored = readStored();
+  let info;
+  try {
+    const res = await call("GET", "info");
+    info = res.json && res.json.body;
+  } catch {
+    notice("Cannot reach the host.");
+    return;
+  }
+  if (!info) {
+    notice("The host did not answer.");
+    return;
+  }
+  state.info = info;
+  $("host").textContent = info.server_name || "Switchboard";
+  if (stored && stored.server_id === info.server_id && stored.spki_sha256 !== info.spki_sha256) {
+    notice("This host's identity changed. Pair again.");
+    return;
+  }
+  if (invite) {
+    if (invite.key !== info.spki_sha256) {
+      notice("This is not the host whose code was scanned.");
+      return;
+    }
+    const res = await call("POST", "pair", {
+      code: invite.code,
+      spki_sha256: info.spki_sha256,
+      device_name: deviceName(),
+      transport: "cookie",
+    });
+    if (res.status !== 200) {
+      const msg = res.json && res.json.error ? res.json.error.message : "pairing failed";
+      notice("Pairing failed: " + msg + ".");
+      return;
+    }
+    state.scope = res.json.body.scope;
+    localStorage.setItem(
+      STORE,
+      JSON.stringify({ server_id: info.server_id, spki_sha256: info.spki_sha256, scope: state.scope }),
+    );
+  } else if (stored) {
+    state.scope = stored.scope || "read";
+  }
+  const waiting = await call("GET", "waiting");
+  if (waiting.status === 401) {
+    notice(
+      readStored()
+        ? "This device was revoked. Pair again."
+        : "Not paired. Open Remote devices on the Mac and scan the code.",
+    );
+    return;
+  }
+  if (waiting.status !== 200) {
+    notice("The host refused: " + waiting.status + ".");
+    return;
+  }
+  // A cookie the browser did not keep shows up here: the first
+  // authenticated call after pairing is refused.
+  openSocket();
+  await refresh();
+  schedule();
+}
+
+async function refresh() {
+  if (state.refreshing) return;
+  state.refreshing = true;
+  try {
+    const projects = await call("GET", "projects");
+    if (projects.status === 401) {
+      notice("This device was revoked. Pair again.");
+      return;
+    }
+    if (projects.status !== 200) return;
+    state.rev.projects = projects.json.revision;
+    state.projects = projects.json.body.projects;
+    const lists = await Promise.all(
+      state.projects.map((p) => call("GET", "projects/" + p.id + "/sessions")),
+    );
+    state.sessions = [];
+    lists.forEach((res, i) => {
+      if (res.status !== 200) return;
+      for (const s of res.json.body.sessions) {
+        state.sessions.push({ ...s, project_name: state.projects[i].name });
+      }
+    });
+    if (state.open) await loadContent();
+    render();
+  } finally {
+    state.refreshing = false;
+  }
+}
+
+async function loadContent() {
+  const s = state.sessions.find((x) => x.id === state.open);
+  if (!s) return;
+  const leaf = s.kind === "claude" ? "last-response" : "screen";
+  const res = await call("GET", "sessions/" + s.id + "/" + leaf);
+  if (res.status === 200) state.text = res.json.body.text || "";
+}
+
+function render() {
+  $("status").textContent = (state.live ? "live" : "polling") + " · " + state.scope;
+  if (state.open) {
+    renderSession();
+    return;
+  }
+  const rank = (s) => (s.waiting ? 0 : 1);
+  const groups = state.projects.map((p) => ({
+    project: p,
+    sessions: state.sessions.filter((s) => s.project === p.id).sort((a, b) => rank(a) - rank(b)),
+  }));
+  groups.sort((a, b) => {
+    const wa = a.sessions.some((s) => s.waiting) ? 0 : 1;
+    const wb = b.sessions.some((s) => s.waiting) ? 0 : 1;
+    return wa - wb;
+  });
+  const kids = [];
+  for (const g of groups) {
+    if (g.sessions.length === 0) continue;
+    kids.push(el("h2", {}, g.project.name));
+    for (const s of g.sessions) {
+      const line = [s.kind, s.card, s.waiting && s.waiting_reason ? s.waiting_reason : ""]
+        .filter(Boolean)
+        .join(" · ");
+      kids.push(
+        el(
+          "button",
+          { class: "row" + (s.waiting ? " waiting" : ""), onclick: () => openSession(s.id) },
+          el("div", { class: "name" }, s.name),
+          el("div", { class: "meta" }, line),
+        ),
+      );
+    }
+  }
+  if (kids.length === 0) kids.push(el("div", { class: "notice" }, "No sessions."));
+  main.replaceChildren(...kids);
+}
+
+function renderSession() {
+  const s = state.sessions.find((x) => x.id === state.open);
+  if (!s) {
+    state.open = null;
+    render();
+    return;
+  }
+  const kids = [
+    el("button", { class: "act", onclick: closeSession }, "Back"),
+    el("h2", {}, s.name),
+    el("div", { class: "meta" }, [s.kind, s.card, s.waiting_reason || ""].filter(Boolean).join(" · ")),
+    el("pre", {}, state.text),
+  ];
+  if (state.scope === "control") {
+    // Rebuilding the page on each event must not eat what is being typed.
+    const prior = document.getElementById("reply");
+    const box = el("textarea", { id: "reply", placeholder: "Reply to the session" });
+    if (prior) box.value = prior.value;
+    kids.push(box, el("button", { class: "act", onclick: () => send(s.id, box) }, "Send"));
+    kids.push(el("div", { class: "meta", id: "sent" }));
+  }
+  main.replaceChildren(...kids);
+}
+
+async function openSession(id) {
+  state.open = id;
+  state.text = "";
+  await loadContent();
+  watch("watch");
+  render();
+}
+
+function closeSession() {
+  watch("unwatch");
+  state.open = null;
+  render();
+}
+
+function contentKind() {
+  const s = state.sessions.find((x) => x.id === state.open);
+  return s && s.kind === "claude" ? "conversation" : "screen";
+}
+
+function watch(type) {
+  if (!state.open || !state.socket || state.socket.readyState !== WebSocket.OPEN) return;
+  state.socket.send(JSON.stringify({ type, resource: { kind: contentKind(), id: state.open } }));
+}
+
+async function send(id, box) {
+  const text = box.value.trim();
+  if (!text) return;
+  const op = crypto.randomUUID();
+  const res = await call("POST", "sessions/" + id + "/send", { op, text });
+  const out = $("sent");
+  if (res.status === 403) {
+    state.scope = "read";
+    render();
+    notice("This device is read-only now.");
+    return;
+  }
+  if (res.status === 200) {
+    box.value = "";
+    if (out) out.textContent = "Sent.";
+  } else if (out) {
+    out.textContent = res.json && res.json.error ? res.json.error.message : "Not sent.";
+  }
+}
+
+// --- live updates: a WebSocket when the browser allows one, a poll when not
+
+function openSocket() {
+  let ws;
+  try {
+    ws = new WebSocket("wss://" + location.host + "/api/v1/events");
+  } catch {
+    return;
+  }
+  let opened = false;
+  state.socket = ws;
+  ws.onopen = () => {
+    opened = true;
+    state.live = true;
+    watch("watch");
+    render();
+  };
+  ws.onmessage = (m) => {
+    let ev;
+    try {
+      ev = JSON.parse(m.data);
+    } catch {
+      return;
+    }
+    if (ev.type === "resync_required") {
+      refresh();
+      return;
+    }
+    if (ev.type !== "changed" && ev.type !== "removed") return;
+    const r = ev.resource || {};
+    if (r.id === state.open && (r.kind === "conversation" || r.kind === "screen")) {
+      loadContent().then(render);
+    } else if (ev.revision > state.rev.projects) {
+      refresh();
+    }
+  };
+  ws.onclose = () => {
+    if (state.socket === ws) state.socket = null;
+    if (opened) {
+      state.live = false;
+      render();
+    }
+  };
+  ws.onerror = () => {};
+}
+
+function schedule() {
+  clearInterval(state.timer);
+  let since = 0;
+  state.timer = setInterval(() => {
+    since += POLL_MS;
+    if (state.live) return;
+    refresh();
+    if (!state.socket && since >= RETRY_SOCKET_MS) {
+      since = 0;
+      openSocket();
+    }
+  }, POLL_MS);
+}
+
+start();
