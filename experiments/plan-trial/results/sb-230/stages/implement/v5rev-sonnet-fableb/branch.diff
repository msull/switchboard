+
+/// What the pairing QR and "Copy invite" carry: the address a phone
+/// opens and, in the fragment (which a browser never sends to the
+/// server, so no request log can hold it), the code, the host's key
+/// and its id. `address` is `host:port`; an IPv6 literal is bracketed.
+#[must_use]
+pub fn pairing_invite(identity: &Identity, address: &str, code: &str) -> String {
+    let authority = address
+        .parse::<std::net::SocketAddr>()
+        .map_or_else(|_| address.to_owned(), |a| a.to_string());
+    format!(
+        "https://{authority}/#code={}&key={}&id={}",
+        code.to_ascii_uppercase(),
+        identity.spki_sha256,
+        identity.server_id
+    )
+}
