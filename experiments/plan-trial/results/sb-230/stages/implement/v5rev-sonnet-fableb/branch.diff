@@ -110,8 +110,36 @@ public struct PairingInvite: Decodable, Sendable, Equatable {
         self.addresses = addresses
     }
 
-    /// The invite from the scanned or pasted text.
+    /// The invite from the scanned or pasted text: the URL the host's QR
+    /// code holds (`https://<host:port>/#code=…&key=…&id=…`), or the JSON
+    /// an earlier host wrote.
     public static func parse(_ text: String) throws -> PairingInvite {
-        try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.hasPrefix("https://") {
+            return try parseURL(trimmed)
+        }
+        return try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+    }
+
+    /// The authority is taken as text, between `https://` and the first
+    /// `/`, so the brackets around an IPv6 literal survive.
+    private static func parseURL(_ text: String) throws -> PairingInvite {
+        let rest = text.dropFirst("https://".count)
+        let authority = rest.prefix { $0 != "/" }
+        var fields: [String: String] = [:]
+        if let hash = rest.firstIndex(of: "#") {
+            for pair in rest[rest.index(after: hash)...].split(separator: "&") {
+                let kv = pair.split(separator: "=", maxSplits: 1)
+                if kv.count == 2 { fields[String(kv[0])] = String(kv[1]) }
+            }
+        }
+        guard !authority.isEmpty, let code = fields["code"], let key = fields["key"],
+            let id = fields["id"]
+        else {
+            throw DecodingError.dataCorrupted(
+                .init(codingPath: [], debugDescription: "the invite URL lacks an address, code, key or id"))
+        }
+        return PairingInvite(
+            serverID: ServerID(id), spkiSha256: key, code: code, addresses: [String(authority)])
     }
 }
