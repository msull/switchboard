     public static func parse(_ text: String) throws -> PairingInvite {
-        try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.hasPrefix("https://") {
+            return try parseURL(trimmed)
+        }
+        return try Wire.decode(PairingInvite.self, from: Data(text.utf8))
+    }
+
+    /// `https://<address>/#code=…&key=…&id=…`. The address is taken as
+    /// text, so an IPv6 literal keeps the brackets the host wrote; the
+    /// fragment carries the rest, which a browser never sends to the host.
+    private static func parseURL(_ text: String) throws -> PairingInvite {
+        let rest = text.dropFirst("https://".count)
+        guard let slash = rest.firstIndex(of: "/"), let hash = rest.firstIndex(of: "#") else {
+            throw DecodingError.dataCorrupted(
+                .init(codingPath: [], debugDescription: "an invite URL has an address and a fragment"))
+        }
+        var fields: [String: String] = [:]
+        for part in rest[rest.index(after: hash)...].split(separator: "&") {
+            let pair = part.split(separator: "=", maxSplits: 1)
+            if pair.count == 2 {
+                fields[String(pair[0])] = String(pair[1])
+            }
+        }
+        guard let id = fields["id"], let key = fields["key"], let code = fields["code"] else {
+            throw DecodingError.dataCorrupted(
+                .init(codingPath: [], debugDescription: "an invite URL names the code, key and id"))
+        }
+        return PairingInvite(
+            serverID: ServerID(id), spkiSha256: key, code: code,
+            addresses: [String(rest[..<slash])])
     }
 }
