+    assert_eq!(r.status, 200, "the right name answers: {}", r.body);
+
+    // A native client pairs as before: the token in the body, no cookie.
+    port.app.dispatch(AppAction::OpenPairing {
+        code: "BCDE2346".into(),
+        scope: Scope::Read,
+    });
+    let native = serde_json::json!({
+        "code": "BCDE2346", "device_name": "Vision Pro", "spki_sha256": identity.spki_sha256,
+    });
+    let r = fetch(&mut port, "POST", "/api/v1/pair", None, None, &native.to_string());
+    assert_eq!(r.status, 200, "{}", r.body);
+    let reply: serde_json::Value = serde_json::from_str(&r.body).unwrap();
+    assert_eq!(reply["body"]["token"].as_str().map(str::len), Some(43));
+    assert!(r.all("Set-Cookie").is_empty(), "no cookie for a native client");
+
+    // Revocation: the browser's next read is refused, its cookie cleared,
+    // and its socket closed.
+    let browser = port.app.core().devices()[0].id;
+    port.app.dispatch(AppAction::RevokeDevice(browser));
+    let r = fetch(&mut port, "GET", "/api/v1/waiting", None, Some(&cookie), "");
+    assert_eq!(r.status, 401, "{}", r.body);
+    let cleared = r.header("Set-Cookie").expect("the cookie is cleared");
+    assert!(
+        cleared.starts_with(&format!("{cookie_name}=;")) && cleared.contains("Max-Age=0"),
+        "{cleared}"
+    );
+    match next_frame(&mut port, &sub, 5) {
+        Some(Err(reason)) => assert!(reason.starts_with("closed"), "{reason}"),
+        other => panic!("expected the close, got {other:?}"),
+    }
+}
+
+/// The page's three files each hold a connection while the page loads:
+/// three strangers in the unauthenticated pool. The page's first
+/// authenticated call moves its connection to the paired pool, and the
+/// events socket then opens while the three are still held.
+#[test]
+fn a_page_load_fits_the_stranger_pool() {
+    let mut port = port();
+    let cookie = pair_browser(&mut port, "ABCD2345", "Safari on iPhone");
+    let addr = port.addr;
+    let config = Arc::clone(&port.client);
+    let mut held = Vec::new();
+    for path in ["/", "/app.css", "/app.js"] {
+        let kept = pinned(addr, &config).expect("connect");
+        let (kept, r) = send_on(&mut port, kept, "GET", path, None);
+        assert_eq!(r.status, 200, "{path}");
+        held.push(kept);
+    }
+    let r = fetch(&mut port, "GET", "/api/v1/waiting", None, Some(&cookie), "");
+    assert_eq!(r.status, 200, "the first authenticated call: {}", r.body);
+    let sub = subscribe_with(&mut port, ("Cookie", cookie.clone()), "/api/v1/events");
+    let (_, r) = send_on(&mut port, pinned(addr, &config).expect("connect"), "GET", "/app.js", None);
+    assert_eq!(r.status, 200, "a page file is still served with the socket open");
+    assert_eq!(held.len(), 3, "the three page connections were held");
+    drop(sub);
+}
+
+/// The page's files share a window of their own: 120 in a minute, the
+/// 121st refused before the frame. The other windows are not spent.
+#[test]
+fn the_page_window_is_rate_limited() {
+    let mut port = port();
+    let mut statuses = Vec::new();
+    for _ in 0..121 {
+        statuses.push(fetch(&mut port, "GET", "/app.css", None, None, "").status);
+    }
+    assert!(statuses[..120].iter().all(|&s| s == 200), "{statuses:?}");
+    assert_eq!(statuses[120], 429, "{statuses:?}");
+    let (status, _) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200, "info has its own window");
+}
