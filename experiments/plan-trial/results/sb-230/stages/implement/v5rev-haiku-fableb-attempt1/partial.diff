+
+/// The start of a token cookie's name; the rest is the host's id.
+pub const TOKEN_COOKIE_PREFIX: &str = "switchboard_token_";
+
+/// The name of the cookie a browser holds this host's token in. It is
+/// per host: cookies are scoped by host and not by port, so two
+/// instances on one address would otherwise overwrite each other's
+/// token.
+#[must_use]
+pub fn token_cookie_name(identity: &Identity) -> String {
+    format!("{TOKEN_COOKIE_PREFIX}{}", identity.server_id)
+}
+
+/// The invite a pairing window shows as its QR code and copies as text.
+/// `address` is `host:port` as a `SocketAddr` writes it, so an IPv6
+/// host is bracketed. The code and the key ride in the fragment, which
+/// a browser never sends to the host, so neither reaches its request
+/// log. The key is the full hash, so a page can compare it with `/info`
+/// by string equality.
+#[must_use]
+pub fn pairing_invite(identity: &Identity, address: &str, code: &str) -> String {
+    format!(
+        "https://{address}/#code={}&key={}&id={}",
+        code.to_ascii_uppercase(),
+        identity.spki_sha256,
+        identity.server_id,
+    )
+}
