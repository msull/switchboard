+                w.write_all(&[0x81, 5, b'h', b'e', b'l', b'l', b'o', 0x88, 0])?;
+                w.flush()?;
+                return Ok(());
+            }
+            _ => json(w, 404, "{\"error\":\"not found\"}", ""),
+        }?;
+    }
+}
+
+fn page<W: Write>(w: &mut W, content_type: &str, body: &str) -> io::Result<()> {
+    write!(
