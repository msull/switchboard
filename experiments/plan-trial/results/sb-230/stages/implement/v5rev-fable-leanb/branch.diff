+    /// The URL form: the host and port are the address, the fragment's
+    /// `code`, `key` and `id` the rest. Each is required.
+    static func parseURL(_ text: String) throws -> PairingInvite {
+        guard let components = URLComponents(string: text), let host = components.host, !host.isEmpty
+        else {
+            throw InviteError.malformed("not a URL with a host")
+        }
+        var values: [String: String] = [:]
+        for pair in (components.fragment ?? "").split(separator: "&") {
+            guard let at = pair.firstIndex(of: "=") else { continue }
+            let name = String(pair[pair.startIndex..<at])
+            let value = String(pair[pair.index(after: at)...])
+            values[name] = value.removingPercentEncoding ?? value
+        }
+        guard let code = values["code"], !code.isEmpty else {
+            throw InviteError.malformed("the URL has no code")
+        }
+        guard let key = values["key"], !key.isEmpty else {
+            throw InviteError.malformed("the URL has no key")
+        }
+        guard let id = values["id"], !id.isEmpty else {
+            throw InviteError.malformed("the URL has no id")
+        }
+        let bracketed = host.contains(":") && !host.hasPrefix("[") ? "[\(host)]" : host
+        let address = components.port.map { "\(bracketed):\($0)" } ?? bracketed
+        return PairingInvite(serverID: ServerID(id), spkiSha256: key, code: code, addresses: [address])
     }
 }
+
+/// An invite that is neither the URL nor the JSON.
+public enum InviteError: Error, Equatable {
+    case malformed(String)
