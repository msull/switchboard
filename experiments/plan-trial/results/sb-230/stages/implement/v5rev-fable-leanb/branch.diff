+/// A response head and body: the status, the headers with their names
+/// lowercased, and the body as text, which a page's is.
+type Response = (u16, Vec<(String, String)>, String);
+
+/// One request with any headers over a fresh pinned connection.
+fn http_with(
+    addr: SocketAddr,
+    config: &Arc<ClientConfig>,
+    method: &str,
+    path: &str,
+    headers: &[(&str, &str)],
+    body: &str,
+) -> std::io::Result<Response> {
+    let tcp = TcpStream::connect(addr)?;
+    tcp.set_read_timeout(Some(Duration::from_secs(10)))?;
+    let conn = ClientConnection::new(
+        Arc::clone(config),
+        ServerName::try_from("localhost").unwrap(),
+    )
+    .map_err(std::io::Error::other)?;
+    let mut s = StreamOwned::new(conn, tcp);
+    while s.conn.is_handshaking() {
+        s.conn.complete_io(&mut s.sock)?;
+    }
+    let extra = headers.iter().fold(String::new(), |mut s, (n, v)| {
+        use std::fmt::Write as _;
+        let _ = write!(s, "{n}: {v}\r\n");
+        s
+    });
+    write!(
+        s,
+        "{method} {path} HTTP/1.1\r\nHost: localhost\r\n{extra}Content-Length: {}\r\n\r\n{body}",
+        body.len()
+    )?;
+    s.flush()?;
+    let mut reader = BufReader::new(s);
+    let mut line = String::new();
+    reader.read_line(&mut line)?;
+    let status: u16 = line
+        .split_whitespace()
+        .nth(1)
+        .and_then(|s| s.parse().ok())
+        .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidData, line.clone()))?;
+    let mut out_headers = Vec::new();
+    let mut length = 0usize;
+    loop {
+        let mut h = String::new();
+        reader.read_line(&mut h)?;
+        let h = h.trim_end();
+        if h.is_empty() {
+            break;
+        }
+        if let Some((n, v)) = h.split_once(':') {
+            let (n, v) = (n.trim().to_ascii_lowercase(), v.trim().to_owned());
+            if n == "content-length" {
+                length = v.parse().unwrap_or(0);
+            }
+            out_headers.push((n, v));
+        }
+    }
+    let mut out = vec![0; length];
+    reader.read_exact(&mut out)?;
+    Ok((
+        status,
+        out_headers,
+        String::from_utf8_lossy(&out).into_owned(),
+    ))
+}
+
+/// `http_with` from a client thread, the app serving on this one.
+fn call_with(
+    port: &mut Port,
+    method: &str,
+    path: &str,
+    headers: &[(&str, &str)],
+    body: &str,
+) -> Response {
+    let addr = port.addr;
+    let config = Arc::clone(&port.client);
+    let (method, path, body) = (method.to_owned(), path.to_owned(), body.to_owned());
+    let headers: Vec<(String, String)> = headers
+        .iter()
+        .map(|(n, v)| ((*n).to_owned(), (*v).to_owned()))
+        .collect();
+    let client = std::thread::spawn(move || {
+        let borrowed: Vec<(&str, &str)> = headers
+            .iter()
+            .map(|(n, v)| (n.as_str(), v.as_str()))
+            .collect();
+        http_with(addr, &config, &method, &path, &borrowed, &body)
+    });
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while !client.is_finished() {
+        assert!(std::time::Instant::now() < deadline, "no reply");
+        port.app.serve_pending();
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    client.join().unwrap().expect("http")
+}
+
+/// A response header by its lowercased name.
+fn header<'a>(headers: &'a [(String, String)], name: &str) -> Option<&'a str> {
+    headers
+        .iter()
+        .find(|(n, _)| n == name)
+        .map(|(_, v)| v.as_str())
+}
