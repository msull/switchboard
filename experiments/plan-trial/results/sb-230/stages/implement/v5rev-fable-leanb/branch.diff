+    let (_, _, plain) = call_with(&mut port, "GET", "/", &[], "");
+    let (status, _, with_query) = call_with(&mut port, "GET", "/?code=QUERY999&key=k", &[], "");
+    assert_eq!(status, 200);
+    assert_eq!(with_query, plain, "a query is ignored");
+    assert!(!with_query.contains("QUERY999"));
+    for (method, path) in [
+        ("GET", "/favicon.ico"),
+        ("POST", "/"),
+        ("GET", "/api"),
+        ("GET", "/index.html"),
+    ] {
+        let (status, headers, body) = call_with(&mut port, method, path, &[], "");
+        assert_eq!(status, 404, "{method} {path}: {body}");
+        assert_eq!(header(&headers, "content-type"), Some("application/json"));
+        let value: serde_json::Value = serde_json::from_str(&body).unwrap();
+        assert_eq!(code(&value), "not_found", "{method} {path}");
+    }
+    let (_, headers, _) = call_with(&mut port, "GET", "/api/v1/info", &[], "");
+    assert_eq!(header(&headers, "cache-control"), Some("no-store"));
+    assert_eq!(header(&headers, "x-content-type-options"), Some("nosniff"));
+    assert_eq!(header(&headers, "connection"), Some("keep-alive"));
+}
+
+/// The page references only what the host serves: every `src` and
+/// `href` is a page or inline, every API path in the script answers,
+/// and the files hold nothing the policy would block.
+#[test]
+fn the_page_references_only_paths_the_host_serves() {
+    use switchboard::adapters::web;
+    let index = include_str!("../web/index.html");
+    let script = include_str!("../web/app.js");
+    let mut refs = Vec::new();
+    for attr in ["src=\"", "href=\""] {
+        for (at, _) in index.match_indices(attr) {
+            let rest = &index[at + attr.len()..];
+            refs.push(&rest[..rest.find('"').unwrap()]);
+        }
+    }
+    assert!(refs.len() >= 3, "{refs:?}");
+    for r in &refs {
+        assert!(r.starts_with("data:") || web::page(r).is_some(), "{r}");
+    }
+    // No inline script, no event handler attribute, no inline style.
+    for tag in index.split('<').skip(1) {
+        let tag = &tag[..tag.find('>').unwrap_or(tag.len())];
+        if tag.starts_with("script") {
+            assert!(tag.contains(" src="), "an inline script: <{tag}>");
+        }
+        for word in tag.split_whitespace() {
+            let name = word.split('=').next().unwrap_or("");
+            assert!(!name.starts_with("on"), "a handler attribute: <{tag}>");
+            assert_ne!(name, "style", "an inline style: <{tag}>");
+        }
+    }
+    for banned in ["innerHTML", "eval(", "document.write"] {
+        assert!(!script.contains(banned), "{banned} in app.js");
+    }
+
+    let mut port = port();
+    let (_, project, session) = seed(&mut port, "");
+    let token = pair(&mut port, "ABCD2345", Scope::Control, "Pad");
+    let mut paths = Vec::new();
+    for (at, _) in script.match_indices("'/api/v1/") {
+        let rest = &script[at + 1..];
+        paths.push(rest[..rest.find('\'').unwrap()].to_owned());
+    }
+    assert!(paths.len() >= 10, "{paths:?}");
+    for path in paths {
+        let id = if path.starts_with("/api/v1/projects/") {
+            &project
+        } else {
+            &session
+        };
+        let path = path.replace("{id}", id);
+        let (method, body) = if path.ends_with("/send") {
+            ("POST", r#"{"op":"web-1","text":"hello"}"#)
+        } else if path.ends_with("/pair") {
+            ("POST", "{}")
+        } else {
+            ("GET", "")
+        };
+        let (status, reply) = call(&mut port, method, &path, Some(&token), body);
+        assert_ne!(
+            code(&reply),
+            "not_found",
+            "{method} {path}: {status} {reply}"
+        );
+    }
+}
+
+/// A browser pairs with `transport: "cookie"`: the token comes back as
+/// an `HttpOnly` cookie named for the server and not in the body, and
+/// the cookie alone reads `/me`. A native pairing is unchanged. Two
+/// hosts on one address keep their cookies apart by name.
+#[test]
+fn a_browser_pairs_by_cookie_and_each_host_reads_only_its_own() {
+    let mut a = port();
+    let (set_cookie, reply) = pair_by_cookie(&mut a, "ABCD2345", Scope::Read, "Safari on iPhone");
+    let server_id = reply["body"]["server_id"].as_str().unwrap().to_owned();
+    assert!(reply["body"].get("token").is_none(), "{reply}");
+    assert_eq!(reply["body"]["scope"], "read");
+    let (pair_a, attributes) = set_cookie.split_once(';').unwrap();
+    let (name, value) = pair_a.split_once('=').unwrap();
+    assert_eq!(name, format!("__Host-sb-{server_id}"));
+    assert_eq!(value.len(), 43);
+    for attribute in [
+        "HttpOnly",
+        "Secure",
+        "SameSite=Strict",
+        "Path=/",
+        "Max-Age=34560000",
+    ] {
+        assert!(attributes.contains(attribute), "{attribute}: {set_cookie}");
+    }
+    assert!(!set_cookie.contains("Domain"), "{set_cookie}");
+
+    let (status, _, text) = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", pair_a)], "");
+    assert_eq!(status, 200, "{text}");
+    let me: serde_json::Value = serde_json::from_str(&text).unwrap();
+    let device = a.app.core().devices()[0].clone();
+    assert_eq!(me["body"]["device_id"], device.id.to_string());
+    assert_eq!(me["body"]["name"], "Safari on iPhone");
+    assert_eq!(me["body"]["scope"], "read");
+    assert_eq!(me["body"]["server_id"], server_id);
+    assert_eq!(
+        me["body"]["server_name"],
+        a.remote.state().identity.as_ref().unwrap().server_name
+    );
+    assert_eq!(device.name, "Safari on iPhone");
+
+    // A native pairing: the token in the body, no cookie.
+    a.app.dispatch(AppAction::OpenPairing {
+        code: "EFGH6789".into(),
+        scope: Scope::Read,
+    });
+    let spki = a
+        .remote
+        .state()
+        .identity
+        .as_ref()
+        .unwrap()
+        .spki_sha256
+        .clone();
+    let body = serde_json::json!({ "code": "EFGH6789", "device_name": "Pad", "spki_sha256": spki });
+    let (status, headers, text) = call_with(&mut a, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(status, 200, "{text}");
+    assert!(header(&headers, "set-cookie").is_none());
+    let native: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(native["body"]["token"].as_str().map(str::len), Some(43));
+
+    // A second host, as a second instance on one Mac: its own name.
+    let mut b = port();
+    let (set_cookie_b, _) = pair_by_cookie(&mut b, "ABCD2345", Scope::Read, "Chrome on Android");
+    let pair_b = cookie_pair(&set_cookie_b);
+    assert_ne!(
+        pair_a.split_once('=').unwrap().0,
+        pair_b.split_once('=').unwrap().0
+    );
+    let both = format!("{pair_a}; {pair_b}");
+    let (status, _, text) = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", &both)], "");
+    assert_eq!(status, 200, "{text}");
+    let me: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(me["body"]["name"], "Safari on iPhone");
+    let (status, _, text) = call_with(&mut b, "GET", "/api/v1/me", &[("Cookie", &both)], "");
+    assert_eq!(status, 200, "{text}");
+    let me: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(me["body"]["name"], "Chrome on Android");
+    for (host, other) in [(&mut a, pair_b), (&mut b, pair_a)] {
+        let (status, _, text) = call_with(host, "GET", "/api/v1/me", &[("Cookie", other)], "");
+        assert_eq!(status, 401, "the other host's cookie: {text}");
+    }
+    let fixed = format!("__Host-sb={value}");
+    let (status, _, text) = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", &fixed)], "");
+    assert_eq!(status, 401, "a cookie under the fixed name: {text}");
+}
+
+/// A write or an upgrade authenticated by cookie alone must carry the
+/// page's own `Origin`; a read needs none, and a bearer never does.
+#[test]
+fn a_cookie_write_needs_the_pages_origin_and_a_bearer_needs_none() {
+    let mut port = port();
+    let (_, _, session) = seed(&mut port, "");
+    let (set_cookie, _) = pair_by_cookie(&mut port, "ABCD2345", Scope::Control, "Safari on iPhone");
+    let cookie = cookie_pair(&set_cookie).to_owned();
+    let send = format!("/api/v1/sessions/{session}/send");
+    let body = r#"{"op":"w1","text":"hello"}"#;
+    let refused = |port: &mut Port, headers: &[(&str, &str)]| {
+        let (status, _, text) = call_with(port, "POST", &send, headers, body);
+        let value: serde_json::Value = serde_json::from_str(&text).unwrap();
+        (status, code(&value).to_owned())
+    };
+    assert_eq!(
+        refused(&mut port, &[("Cookie", &cookie)]),
+        (403, "origin".into())
+    );
+    assert_eq!(
+        refused(
+            &mut port,
+            &[("Cookie", &cookie), ("Origin", "https://evil.example")]
+        ),
+        (403, "origin".into())
+    );
+    assert_eq!(
+        refused(
+            &mut port,
+            &[("Cookie", &cookie), ("Origin", "http://localhost")]
+        ),
+        (403, "origin".into())
+    );
+    let (status, code) = refused(
+        &mut port,
+        &[("Cookie", &cookie), ("Origin", "https://localhost")],
+    );
+    assert_ne!(code, "origin", "{status}");
+    assert_ne!(code, "unauthorized", "{status}");
+    assert!(
+        port.app.core().devices()[0].last_seen.is_some(),
+        "the send ran as the device"
+    );
+    let (status, _, _) = call_with(
+        &mut port,
+        "GET",
+        "/api/v1/waiting",
+        &[("Cookie", &cookie)],
+        "",
+    );
+    assert_eq!(status, 200, "a cookie read needs no origin");
+
+    let token = pair(&mut port, "EFGH6789", Scope::Control, "Pad");
+    let (status, reply) = call(&mut port, "POST", &send, Some(&token), body);
+    assert_ne!(self::code(&reply), "origin", "{status} {reply}");
+
+    let sub = subscribe_with(&mut port, &[("Cookie", &cookie)], "/api/v1/events");
+    let first = next_frame(&mut port, &sub, 5).expect("an answer");
+    assert!(first.is_err(), "a cookie upgrade with no origin: {first:?}");
+    let sub = subscribe_with(
+        &mut port,
+        &[("Cookie", &cookie), ("Origin", "https://evil.example")],
+        "/api/v1/events",
+    );
+    let first = next_frame(&mut port, &sub, 5).expect("an answer");
+    assert!(first.is_err(), "a foreign origin: {first:?}");
+    let sub = subscribe_with(
+        &mut port,
+        &[("Cookie", &cookie), ("Origin", "https://localhost")],
+        "/api/v1/events",
+    );
+    let hello = next_frame(&mut port, &sub, 5)
+        .expect("hello")
+        .expect("a frame");
+    let hello: serde_json::Value = serde_json::from_str(&hello).unwrap();
+    assert_eq!(hello["type"], "hello", "{hello}");
+}
+
+/// `/me` follows the scope the dialog sets; after Revoke the cookie is
+/// `unauthorized` while `/info` still answers the same id and key,
+/// which is what lets the page say "removed on the host".
+#[test]
+fn me_follows_the_scope_and_a_revoked_cookie_is_unauthorized_while_info_stands() {
+    let mut port = port();
+    let (set_cookie, reply) =
+        pair_by_cookie(&mut port, "ABCD2345", Scope::Read, "Safari on iPhone");
+    let cookie = cookie_pair(&set_cookie).to_owned();
+    let device = uuid::Uuid::parse_str(reply["body"]["device_id"].as_str().unwrap()).unwrap();
+    let me = |port: &mut Port| {
+        let (status, _, text) = call_with(port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+        let value: serde_json::Value = serde_json::from_str(&text).unwrap();
+        (status, value)
+    };
+    assert_eq!(me(&mut port).1["body"]["scope"], "read");
+    port.app.dispatch(AppAction::SetDeviceScope {
+        device,
+        scope: Scope::Control,
+    });
+    assert_eq!(me(&mut port).1["body"]["scope"], "control");
+    let (_, before) = get(&mut port, "/api/v1/info", None);
+    port.app.dispatch(AppAction::RevokeDevice(device));
+    let (status, value) = me(&mut port);
+    assert_eq!((status, code(&value)), (401, "unauthorized"), "{value}");
+    let (_, after) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(after["body"]["server_id"], before["body"]["server_id"]);
+    assert_eq!(after["body"]["spki_sha256"], before["body"]["spki_sha256"]);
+}
+
+/// A page load closes its connection, so loads never pile up in the
+/// unauthenticated pool; the pages have a window of their own, past
+/// which a load is 429 while `/info` and `/pair` keep theirs.
+#[test]
+fn page_loads_free_their_slot_and_have_a_window_of_their_own() {
+    let mut port = port();
+    for i in 0..120 {
+        let (status, _, _) = call_with(&mut port, "GET", "/", &[], "");
+        assert_eq!(status, 200, "load {i}");
+    }
+    let (status, _, text) = call_with(&mut port, "GET", "/app.js", &[], "");
+    assert_eq!(status, 429, "{text}");
+    let value: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(code(&value), "rate_limited");
+    let (status, _) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200, "info has its own window");
+    let (status, reply) = call(&mut port, "POST", "/api/v1/pair", None, "{}");
+    assert_eq!(
+        (status, code(&reply)),
+        (403, "pairing_closed"),
+        "pair has its own window"
+    );
+}
+
+/// The page's pure parts under `node --test`; skipped where node is
+/// not installed, as the tmux tests skip without tmux.
+#[test]
+fn the_pages_pure_parts_pass_under_node() {
+    let output = std::process::Command::new("node")
+        .args(["--test", "web/app.test.js"])
+        .current_dir(env!("CARGO_MANIFEST_DIR"))
+        .output();
+    let output = match output {
+        Ok(output) => output,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+            eprintln!("node is not installed; skipping the page's tests");
+            return;
+        }
+        Err(e) => panic!("node: {e}"),
+    };
+    assert!(
+        output.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
