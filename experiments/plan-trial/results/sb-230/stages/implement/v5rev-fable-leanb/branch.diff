new file mode 100644
index 0000000..deb9adc
--- /dev/null
+++ b/src/adapters/web.rs
@@ -0,0 +1,60 @@
+//! The web control surface the remote port serves: three files under
+//! `web/`, embedded at build time and answered on the connection thread
+//! as constant bytes. Nothing here is a request handler; the table says
+//! which path is which file, and the listener writes it.
+
+/// One embedded file: its path on the port, its type, its bytes.
+pub struct Page {
+    pub path: &'static str,
+    pub content_type: &'static str,
+    pub body: &'static str,
+}
+
+/// The page's own files and nothing else: no inline script or style,
+/// no outside resource, requests only to its own origin (the events
+/// socket included), an inline icon, and no framing of the page.
+pub const CONTENT_SECURITY_POLICY: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+/// Every page the port serves, by exact path.
+pub const PAGES: &[Page] = &[
+    Page {
+        path: "/",
+        content_type: "text/html; charset=utf-8",
+        body: include_str!("../../web/index.html"),
+    },
+    Page {
+        path: "/app.js",
+        content_type: "text/javascript; charset=utf-8",
+        body: include_str!("../../web/app.js"),
+    },
+    Page {
+        path: "/app.css",
+        content_type: "text/css; charset=utf-8",
+        body: include_str!("../../web/app.css"),
+    },
+];
+
+/// The page at `path`, matched exactly: a query was already split off
+/// and is ignored.
+#[must_use]
+pub fn page(path: &str) -> Option<&'static Page> {
+    PAGES.iter().find(|p| p.path == path)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pages_match_exactly_and_hold_their_files() {
+        assert_eq!(
+            page("/").map(|p| p.content_type),
+            Some("text/html; charset=utf-8")
+        );
+        assert!(page("/app.js").is_some_and(|p| p.body.contains("'use strict'")));
+        assert!(page("/app.css").is_some());
+        assert!(page("/index.html").is_none());
+        assert!(page("/app.js/").is_none());
+        assert!(page("/favicon.ico").is_none());
+    }
+}
