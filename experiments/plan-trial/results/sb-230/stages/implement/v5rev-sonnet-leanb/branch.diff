+/// The pairing URL a phone's camera opens: the page on the port, with
+/// the code, the key and the server id in the fragment, which a browser
+/// never sends. `address` is a host name or IP without its port.
+#[must_use]
+pub fn invite_url(identity: &Identity, window: &PairingWindow, address: &str, port: u16) -> String {
+    format!(
+        "https://{address}:{port}/#code={}&key={}&id={}",
+        window.code, identity.spki_sha256, identity.server_id
+    )
+}
+
+/// The name of the cookie a browser device keeps its token in. It
+/// carries the server id because cookies ignore ports: two instances on
+/// one address share a jar, and each must read only its own.
+#[must_use]
+pub fn cookie_name(server_id: &Uuid) -> String {
+    format!("__Host-sb-{server_id}")
+}
+
+/// The value of the cookie called `name` in a `Cookie` header, matched
+/// by exact name; every other cookie is ignored.
+#[must_use]
+pub fn cookie_value<'a>(header: &'a str, name: &str) -> Option<&'a str> {
+    header
+        .split(';')
+        .filter_map(|pair| pair.trim().split_once('='))
+        .find(|(n, _)| *n == name)
+        .map(|(_, v)| v.trim())
+        .filter(|v| !v.is_empty())
+}
