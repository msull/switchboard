+    let mut port = port();
+    let (_, project, session) = seed(&mut port, "");
+    let token = pair(&mut port, "ABCD2345", Scope::Control, "Pad");
+    let html = page(&port, "/").body;
+    let js = page(&port, "/app.js").body;
+
+    // index.html: every src and href is a served path or data:.
+    for attr in ["src=\"", "href=\""] {
+        for part in html.split(attr).skip(1) {
+            let value = part.split('"').next().unwrap();
+            assert!(
+                value.starts_with("data:") || page(&port, value).status == 200,
+                "{value}"
+            );
+        }
+    }
+    // No inline script, handler or style: the CSP would refuse them.
+    for script in html.split("<script").skip(1) {
+        assert!(script.split('>').next().unwrap().contains("src="));
+    }
+    for forbidden in [
+        "onclick=",
+        "onload=",
+        "onerror=",
+        "onsubmit=",
+        "style=",
+        "<style",
+    ] {
+        assert!(!html.contains(forbidden), "{forbidden}");
+    }
+    for forbidden in [
+        "innerHTML",
+        "outerHTML",
+        "eval(",
+        "document.write",
+        "insertAdjacentHTML",
+    ] {
+        assert!(!js.contains(forbidden), "{forbidden}");
+    }
+
+    // app.js: every /api/v1 string in its table answers something but
+    // the port's "no such route".
+    let table = js
+        .split("const API = {")
+        .nth(1)
+        .and_then(|t| t.split("};").next())
+        .unwrap();
+    let mut seen = 0;
+    for line in table.lines() {
+        let Some(path) = line
+            .split('\'')
+            .nth(1)
+            .filter(|p| p.starts_with("/api/v1/"))
+        else {
+            continue;
+        };
+        seen += 1;
+        let path = path
+            .replace("projects/{id}", &format!("projects/{project}"))
+            .replace("sessions/{id}", &format!("sessions/{session}"));
+        let method = if path.ends_with("/pair") || path.ends_with("/send") {
+            "POST"
+        } else {
+            "GET"
+        };
+        let (_, reply) = call(&mut port, method, &path, Some(&token), "{}");
+        let message = reply["error"]["message"].as_str().unwrap_or("");
+        assert_ne!(message, "not available on this port", "{method} {path}");
+        assert_ne!(message, "no such endpoint", "{method} {path}");
+    }
+    assert!(seen >= 9, "the table was read: {seen}");
