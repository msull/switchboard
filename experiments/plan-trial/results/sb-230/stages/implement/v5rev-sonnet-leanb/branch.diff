@@ -0,0 +1,43 @@
+//! The web control surface's three files, embedded in the binary and
+//! answered by the remote port's connection thread before pairing.
+//!
+//! The bytes are constant, so they never reach the frame: a page load
+//! cannot wait on a busy frame, and the frame's per-pass bound is for
+//! work the core does.
+
+/// One embedded file.
+pub struct Page {
+    pub path: &'static str,
+    pub content_type: &'static str,
+    pub body: &'static str,
+}
+
+/// Every page the port serves, matched on the exact path.
+pub const PAGES: [Page; 3] = [
+    Page {
+        path: "/",
+        content_type: "text/html; charset=utf-8",
+        body: include_str!("../../web/index.html"),
+    },
+    Page {
+        path: "/app.js",
+        content_type: "text/javascript; charset=utf-8",
+        body: include_str!("../../web/app.js"),
+    },
+    Page {
+        path: "/app.css",
+        content_type: "text/css; charset=utf-8",
+        body: include_str!("../../web/app.css"),
+    },
+];
+
+/// No inline script, no inline style and nothing from another origin.
+/// `connect-src 'self'` is what a browser may or may not admit `wss:`
+/// under; if not, the socket is what is lost and polling carries.
+pub const CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+/// The page for an exact path; a query was split off before this.
+#[must_use]
+pub fn page(path: &str) -> Option<&'static Page> {
+    PAGES.iter().find(|p| p.path == path)
+}
