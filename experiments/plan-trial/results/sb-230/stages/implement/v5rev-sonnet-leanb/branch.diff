+    let upgrade = |origin: Option<&str>, port: &mut Port| {
+        let mut h = vec![
+            c,
+            ("Upgrade", "websocket"),
+            ("Connection", "Upgrade"),
+            ("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ=="),
+            ("Sec-WebSocket-Version", "13"),
+        ];
+        if let Some(o) = origin {
+            h.push(("Origin", o));
+        }
+        call_with(port, "GET", "/api/v1/events", &h, "").status
+    };
+    assert_eq!(upgrade(Some("https://evil.example"), &mut port), 403);
+    assert_eq!(upgrade(None, &mut port), 403);
+    assert_eq!(upgrade(Some("https://localhost"), &mut port), 101);
+}
+
+#[test]
+fn a_page_closes_its_connection_and_pages_have_their_own_window() {
+    let mut port = port();
+    for _ in 0..=MAX_UNAUTHENTICATED {
+        assert_eq!(page(&port, "/").status, 200);
+    }
+    // Four stalled strangers still fill the pool for a page request.
+    let strangers: Vec<TcpStream> = (0..MAX_UNAUTHENTICATED)
+        .map(|_| TcpStream::connect(port.addr).expect("connect"))
+        .collect();
+    std::thread::sleep(Duration::from_millis(100));
+    assert!(
+        exchange(port.addr, &port.client, "GET", "/", &[], "").is_err(),
+        "the fifth is closed at accept"
+    );
+    drop(strangers);
+    std::thread::sleep(Duration::from_millis(100));
+
+    // The window is 120 a minute (some are spent above); /info and
+    // /pair keep their own.
+    let statuses: Vec<u16> = (0..121).map(|_| page(&port, "/app.css").status).collect();
+    assert_eq!(statuses.last(), Some(&429), "{statuses:?}");
+    let (status, _) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200);
+    let (status, _) = call(&mut port, "POST", "/api/v1/pair", None, "{}");
+    assert_eq!(status, 403, "pair is not in the page window");
+}
+
+/// The page's pure logic, under `node --test`; skipped where node is
+/// absent, like the tmux tests.
+#[test]
+fn the_pages_logic_passes_its_node_tests() {
+    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("web");
+    let Ok(out) = std::process::Command::new("node")
+        .arg("--test")
+        .arg(dir.join("app.test.js"))
+        .output()
+    else {
+        return;
+    };
+    assert!(
+        out.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
