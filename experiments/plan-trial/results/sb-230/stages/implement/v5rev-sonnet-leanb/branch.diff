+:root {
+  color-scheme: light dark;
+  --bg: #f6f6f4;
+  --fg: #1d1d1b;
+  --muted: #6a6a64;
+  --card: #ffffff;
+  --line: #d9d9d3;
+  --accent: #0a5fd8;
+  --wait: #a35200;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #161615;
+    --fg: #ececE6;
+    --muted: #9a9a92;
+    --card: #1f1f1d;
+    --line: #34342f;
+    --accent: #6aa7ff;
+    --wait: #ffb15e;
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--fg);
+  font: 16px/1.4 -apple-system, system-ui, sans-serif;
+}
+
+header {
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--line);
+}
+
+header .name {
+  font-weight: 600;
+}
+
+header .scope,
+.meta {
+  color: var(--muted);
+  font-size: 14px;
+}
+
+main {
+  max-width: 720px;
+  margin: 0 auto;
+  padding: 12px 16px 48px;
+}
+
+h2 {
+  margin: 20px 0 8px;
+  font-size: 15px;
+  color: var(--muted);
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.row {
+  display: block;
+  width: 100%;
+  margin: 0 0 8px;
+  padding: 10px 12px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  background: var(--card);
+  color: inherit;
+  font: inherit;
+  text-align: left;
+}
+
+.row:focus-visible,
+button:focus-visible,
+textarea:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.row.waiting {
+  border-left: 5px solid var(--wait);
+}
+
+.row .title {
+  font-weight: 600;
+}
+
+.waiting-word {
+  color: var(--wait);
+  font-weight: 600;
+}
+
+pre {
+  margin: 8px 0;
+  padding: 12px;
+  overflow-x: auto;
+  white-space: pre-wrap;
+  word-break: break-word;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  background: var(--card);
+  font: 13px/1.4 ui-monospace, Menlo, monospace;
+}
+
+textarea {
+  display: block;
+  width: 100%;
+  min-height: 96px;
+  padding: 8px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  background: var(--card);
+  color: inherit;
+  font: inherit;
+}
+
+button {
+  padding: 8px 14px;
+  border: 1px solid var(--accent);
+  border-radius: 8px;
+  background: var(--accent);
+  color: var(--bg);
+  font: inherit;
+}
+
+button.plain {
+  background: transparent;
+  color: var(--accent);
+}
+
+.notice {
+  margin: 12px 0;
+  padding: 12px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  background: var(--card);
+}
+
+.actions {
+  display: flex;
+  gap: 8px;
+  margin: 8px 0;
+}
diff --git a/web/app.js b/web/app.js
new file mode 100644
index 0000000..68a51eb
--- /dev/null
+++ b/web/app.js
@@ -0,0 +1,462 @@
+'use strict';
+// Switchboard's web control surface. It speaks the protocol the native
+// clients speak (docs/remote-client.md) and keeps no credential: the
+// token lives in an HttpOnly cookie the host sets at pairing. Every
+// string from the host reaches the page through textContent.
+
+// Every route the page calls, with {id} where an id goes. A host test
+// reads this table to check each one is served.
+const API = {
+  info: '/api/v1/info',
+  pair: '/api/v1/pair',
+  me: '/api/v1/me',
+  projects: '/api/v1/projects',
+  sessions: '/api/v1/projects/{id}/sessions',
+  waiting: '/api/v1/waiting',
+  lastResponse: '/api/v1/sessions/{id}/last-response',
+  screen: '/api/v1/sessions/{id}/screen',
+  send: '/api/v1/sessions/{id}/send',
+  events: '/api/v1/events',
+};
+
+const POLL_MS = 3000;
+const POLL_WITH_SOCKET_MS = 20000;
+const SOCKET_RETRY_MS = 5000;
+const SOCKET_RETRY_MAX_MS = 60000;
+const STORE_KEY = 'switchboard-host';
+
+// --- pure parts, covered by app.test.js
+
+/** The code, key and id in a location hash, or null. */
+function parseFragment(hash) {
+  const params = new URLSearchParams(String(hash || '').replace(/^#/, ''));
+  const code = params.get('code');
+  const key = params.get('key');
+  const id = params.get('id');
+  return code && key && id ? { code, key, id } : null;
+}
+
+/** "Safari on iPhone" and the like, from a user agent. */
+function deviceName(ua, touchPoints) {
+  const agent = String(ua || '');
+  let browser = 'Safari';
+  if (/Edg/.test(agent)) browser = 'Edge';
+  else if (/Firefox|FxiOS/.test(agent)) browser = 'Firefox';
+  else if (/Chrome|CriOS/.test(agent)) browser = 'Chrome';
+  let device = null;
+  if (/iPhone/.test(agent)) device = 'iPhone';
+  else if (/iPad/.test(agent) || (/Macintosh/.test(agent) && touchPoints > 1)) device = 'iPad';
+  else if (/Android/.test(agent)) device = 'Android';
+  else if (/Mac/.test(agent)) device = 'Mac';
+  else if (/Windows/.test(agent)) device = 'Windows';
+  else if (/Linux/.test(agent)) device = 'Linux';
+  return device ? `${browser} on ${device}` : 'Browser';
+}
+
+/**
+ * What a 401 means, from what the page stored at pairing and what
+ * /info says now (null when the host did not answer). The host cannot
+ * say "revoked": a removed device and an unknown token are one answer.
+ */
+function inferFailure(stored, info) {
+  if (!info) return 'unreachable';
+  if (!stored) return 'not-paired';
+  if (info.server_id === stored.server_id && info.spki_sha256 === stored.spki_sha256) {
+    return 'removed';
+  }
+  return 'changed';
+}
+
+/** Whether a reply is older than the one already applied (§4.4). */
+function isStale(applied, next) {
+  return !!applied && applied.epoch === next.epoch && next.revision < applied.revision;
+}
+
+/** Whether the host's state moved since the list the page holds. */
+function moved(held, next) {
+  return !held || held.epoch !== next.epoch || held.revision !== next.revision;
+}
+
+/** A random operation id, so a retried send is not typed twice. */
+function newOp(random) {
+  const bytes = new Uint8Array(16);
+  random(bytes);
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+/** Waiting sessions first within a project, a project with one first. */
+function arrange(groups) {
+  const waiting = (g) => g.sessions.some((s) => s.waiting);
+  const sorted = groups.map((g) => ({
+    project: g.project,
+    sessions: g.sessions.slice().sort((a, b) => Number(b.waiting) - Number(a.waiting)),
+  }));
+  return sorted.sort((a, b) => Number(waiting(b)) - Number(waiting(a)));
+}
+
+/** "3m ago" from a millisecond timestamp, or an empty string. */
+function ago(ms, now) {
+  if (typeof ms !== 'number') return '';
+  const secs = Math.max(0, Math.round((now - ms) / 1000));
+  if (secs < 60) return `${secs}s ago`;
+  if (secs < 3600) return `${Math.floor(secs / 60)}m ago`;
+  if (secs < 86400) return `${Math.floor(secs / 3600)}h ago`;
+  return `${Math.floor(secs / 86400)}d ago`;
+}
+
+function route(template, id) {
+  return template.replace('{id}', encodeURIComponent(id));
+}
+
+// --- the page
+
+function start() {
+  const headerEl = document.getElementById('header');
+  const mainEl = document.getElementById('main');
+  const state = {
+    me: null,
+    groups: [],
+    held: null,
+    open: null,
+    draft: { text: '', op: null },
+    socket: false,
+    socketDelay: SOCKET_RETRY_MS,
+  };
+
+  function h(tag, props, ...children) {
+    const el = document.createElement(tag);
+    for (const [k, v] of Object.entries(props || {})) {
+      if (k === 'class') el.className = v;
+      else if (k === 'on') for (const [e, f] of Object.entries(v)) el.addEventListener(e, f);
+      else el.setAttribute(k, v);
+    }
+    for (const c of children) el.append(c);
+    return el;
+  }
+
+  function stored() {
+    try {
+      return JSON.parse(localStorage.getItem(STORE_KEY));
+    } catch (e) {
+      return null;
+    }
+  }
+
+  async function api(path, options) {
+    const res = await fetch(path, { credentials: 'same-origin', ...options });
+    let json = null;
+    try {
+      json = await res.json();
+    } catch (e) {
+      json = null;
+    }
+    if (res.status === 401) await failed401();
+    return { status: res.status, json };
+  }
+
+  async function readInfo() {
+    try {
+      const res = await fetch(API.info, { credentials: 'same-origin' });
+      return res.ok ? (await res.json()).body : null;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  const SAYINGS = {
+    unreachable: "Can't reach the host.",
+    'not-paired':
+      'Not paired. Open the pairing window on the Mac and scan its code with this device.',
+    removed: 'This device was removed on the host. Pair again from its pairing window.',
+    changed: 'The host\'s identity changed. Pair again from its pairing window.',
+  };
+
+  async function failed401() {
+    const kind = inferFailure(stored(), await readInfo());
+    state.me = null;
+    notice(SAYINGS[kind]);
+    throw new Error('unauthorized');
+  }
+
+  function notice(text) {
+    headerEl.replaceChildren();
+    mainEl.replaceChildren(h('div', { class: 'notice', role: 'alert' }, text));
+  }
+
+  // --- pairing
+
+  async function pairFrom(fragment) {
+    // The fragment never left the browser; take it out of the address
+    // bar before anything else runs.
+    history.replaceState(null, '', location.pathname);
+    const info = await readInfo();
+    if (!info) return notice(SAYINGS.unreachable);
+    if (info.spki_sha256 !== fragment.key || info.server_id !== fragment.id) {
+      return notice('This address is a different Switchboard than the code was for.');
+    }
+    const res = await fetch(API.pair, {
+      method: 'POST',
+      credentials: 'same-origin',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        code: fragment.code,
+        spki_sha256: fragment.key,
+        device_name: deviceName(navigator.userAgent, navigator.maxTouchPoints),
+        transport: 'cookie',
+      }),
+    });
+    const json = await res.json().catch(() => null);
+    if (!res.ok) {
+      const code = json && json.error && json.error.code;
+      const words = {
+        pairing_closed: 'Pairing is not open on the host. Open the window again.',
+        wrong_code: 'The code did not match. Open the window again.',
+        wrong_key: 'This is not the host whose code was scanned.',
+        rate_limited: 'Too many tries. Wait a minute.',
+      };
+      return notice(words[code] || 'Pairing failed.');
+    }
+    localStorage.setItem(
+      STORE_KEY,
+      JSON.stringify({
+        server_id: info.server_id,
+        spki_sha256: info.spki_sha256,
+        server_name: info.server_name,
+      }),
+    );
+    await enter();
+  }
+
+  // --- screens
+
+  function drawHeader() {
+    headerEl.replaceChildren(
+      h('span', { class: 'name' }, state.me.server_name),
+      h('span', { class: 'scope' }, `${state.me.scope} access`),
+    );
+  }
+
+  function drawList() {
+    state.open = null;
+    drawHeader();
+    const now = Date.now();
+    const out = [];
+    if (!state.groups.length) out.push(h('p', { class: 'meta' }, 'No projects yet.'));
+    for (const group of state.groups) {
+      out.push(h('h2', {}, group.project.name));
+      for (const s of group.sessions) {
+        const lines = [];
+        if (s.waiting) {
+          const why = s.waiting_reason ? `: ${s.waiting_reason}` : '';
+          lines.push(h('div', { class: 'waiting-word' }, `Waiting on you${why}`));
+        }
+        lines.push(h('div', { class: 'title' }, s.name));
+        lines.push(h('div', { class: 'meta' }, [s.kind, s.card, ago(s.last_activity_ms, now)].filter(Boolean).join(' · ')));
+        out.push(
+          h('button', { class: s.waiting ? 'row waiting' : 'row', on: { click: () => openSession(s) } }, ...lines),
+        );
+      }
+    }
+    mainEl.replaceChildren(...out);
+  }
+
+  async function sessionText(s) {
+    const path = route(s.kind === 'claude' ? API.lastResponse : API.screen, s.id);
+    const { status, json } = await api(path);
+    if (status !== 200) return '(nothing to show)';
+    return json.body.text || '(empty)';
+  }
+
+  async function openSession(s) {
+    state.open = s;
+    await drawSession();
+  }
+
+  async function drawSession() {
+    const s = state.open;
+    const text = await sessionText(s);
+    if (state.open !== s) return;
+    const controls = [];
+    if (state.me.scope === 'control' && !s.prompt_refusal) {
+      const box = h('textarea', { 'aria-label': 'Reply', maxlength: '8000' });
+      box.value = state.draft.text;
+      box.addEventListener('input', () => {
+        state.draft.text = box.value;
+      });
+      const status = h('p', { class: 'meta', role: 'status' });
+      controls.push(
+        box,
+        h('div', { class: 'actions' },
+          h('button', { on: { click: () => send(s, status) } }, 'Send')),
+        status,
+      );
+    } else if (s.prompt_refusal) {
+      controls.push(h('p', { class: 'meta' }, s.prompt_refusal));
+    } else {
+      controls.push(h('p', { class: 'meta' }, 'This device reads only.'));
+    }
+    drawHeader();
+    mainEl.replaceChildren(
+      h('div', { class: 'actions' }, h('button', { class: 'plain', on: { click: back } }, 'Back')),
+      h('h2', {}, s.name),
+      h('pre', {}, text),
+      ...controls,
+    );
+  }
+
+  async function back() {
+    await refresh();
+    drawList();
+  }
+
+  async function send(s, status) {
+    const text = state.draft.text.trim();
+    if (!text) return;
+    // A retry after a dropped reply repeats the op, so the host
+    // answers it from its log and types nothing twice.
+    if (!state.draft.op || state.draft.sent !== text) {
+      state.draft.op = newOp((b) => crypto.getRandomValues(b));
+      state.draft.sent = text;
+    }
+    status.textContent = 'Sending…';
+    try {
+      const { status: code, json } = await api(route(API.send, s.id), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ op: state.draft.op, text }),
+      });
+      if (code === 403 && json && json.error && json.error.code === 'scope') {
+        state.me = (await api(API.me)).json.body;
+        return drawSession();
+      }
+      if (code !== 200) {
+        status.textContent = (json && json.error && json.error.message) || 'Not sent.';
+        return;
+      }
+      state.draft = { text: '', op: null };
+      status.textContent = 'Sent. The session card shows progress.';
+      const box = mainEl.querySelector('textarea');
+      if (box) box.value = '';
+    } catch (e) {
+      if (e.message !== 'unauthorized') status.textContent = "Can't reach the host; send again to retry.";
+    }
+  }
+
+  // --- data
+
+  async function refresh() {
+    const waiting = await api(API.waiting);
+    if (waiting.status !== 200) return;
+    const mark = { epoch: waiting.json.epoch, revision: waiting.json.revision };
+    if (isStale(state.held, mark)) return;
+    const projects = await api(API.projects);
+    if (projects.status !== 200) return;
+    const groups = await Promise.all(
+      projects.json.body.projects.map(async (project) => {
+        const r = await api(route(API.sessions, project.id));
+        return { project, sessions: r.status === 200 ? r.json.body.sessions : [] };
+      }),
+    );
+    state.groups = arrange(groups);
+    state.held = mark;
+    if (state.open) {
+      const fresh = state.groups.flatMap((g) => g.sessions).find((s) => s.id === state.open.id);
+      if (fresh) state.open = fresh;
+    }
+  }
+
+  async function enter() {
+    const me = await api(API.me);
+    if (me.status !== 200) return;
+    state.me = me.json.body;
+    await refresh();
+    drawList();
+    schedule();
+    connectSocket();
+  }
+
+  // --- refresh: poll always, socket when it will connect
+
+  let timer = null;
+
+  function schedule() {
+    clearTimeout(timer);
+    timer = setTimeout(tick, state.socket ? POLL_WITH_SOCKET_MS : POLL_MS);
+  }
+
+  async function tick() {
+    try {
+      if (!document.hidden && state.me) {
+        const waiting = await api(API.waiting);
+        if (waiting.status === 200 && moved(state.held, waiting.json)) await changed();
+      }
+    } catch (e) {
+      if (e.message === 'unauthorized') return;
+    }
+    schedule();
+  }
+
+  async function changed() {
+    await refresh();
+    if (state.open) await drawSession();
+    else drawList();
+  }
+
+  function connectSocket() {
+    if (!state.me || typeof WebSocket === 'undefined') return;
+    let ws;
+    try {
+      ws = new WebSocket(`wss://${location.host}${API.events}`);
+    } catch (e) {
+      return;
+    }
+    ws.addEventListener('open', () => {
+      state.socket = true;
+      state.socketDelay = SOCKET_RETRY_MS;
+      schedule();
+    });
+    ws.addEventListener('message', (event) => {
+      let frame = null;
+      try {
+        frame = JSON.parse(event.data);
+      } catch (e) {
+        return;
+      }
+      if (frame && (frame.type === 'changed' || frame.type === 'resync_required')) {
+        changed().catch(() => {});
+      }
+    });
+    const lost = () => {
+      if (ws.lost) return;
+      ws.lost = true;
+      state.socket = false;
+      schedule();
+      changed().catch(() => {});
+      setTimeout(connectSocket, state.socketDelay);
+      state.socketDelay = Math.min(state.socketDelay * 2, SOCKET_RETRY_MAX_MS);
+    };
+    ws.addEventListener('close', lost);
+    ws.addEventListener('error', lost);
+  }
+
+  async function boot() {
+    const fragment = parseFragment(location.hash);
+    try {
+      if (fragment) await pairFrom(fragment);
+      else await enter();
+    } catch (e) {
+      if (e.message !== 'unauthorized') notice(SAYINGS.unreachable);
+    }
+  }
+
+  document.addEventListener('visibilitychange', () => {
+    if (!document.hidden && state.me) tick();
+  });
+  boot();
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { API, parseFragment, deviceName, inferFailure, isStale, moved, newOp, arrange, ago, route };
+} else {
+  start();
+}
