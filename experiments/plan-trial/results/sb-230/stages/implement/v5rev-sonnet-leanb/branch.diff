+'use strict';
+// Run with `node --test web/`. The page's pure parts only; nothing here
+// drives a browser.
+const test = require('node:test');
+const assert = require('node:assert');
+const app = require('./app.js');
+
+test('the fragment holds code, key and id, or nothing', () => {
+  assert.deepStrictEqual(app.parseFragment('#code=ABCD2345&key=ab&id=17a9'), {
+    code: 'ABCD2345',
+    key: 'ab',
+    id: '17a9',
+  });
+  assert.strictEqual(app.parseFragment('#key=ab&id=17a9'), null);
+  assert.strictEqual(app.parseFragment(''), null);
+});
+
+test('a device is named from its user agent', () => {
+  const iphone = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit Version/18 Safari/605';
+  assert.strictEqual(app.deviceName(iphone, 5), 'Safari on iPhone');
+  const ipad = 'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) AppleWebKit Version/18 Safari/605';
+  assert.strictEqual(app.deviceName(ipad, 5), 'Safari on iPad');
+  assert.strictEqual(app.deviceName(ipad, 0), 'Safari on Mac');
+  const chrome = 'Mozilla/5.0 (Linux; Android 14) AppleWebKit Chrome/120 Mobile Safari/537';
+  assert.strictEqual(app.deviceName(chrome, 5), 'Chrome on Android');
+  assert.strictEqual(app.deviceName('curl/8', 0), 'Browser');
+});
+
+test('a 401 is told apart by what /info says', () => {
+  const stored = { server_id: 'a', spki_sha256: 'k' };
+  assert.strictEqual(app.inferFailure(stored, null), 'unreachable');
+  assert.strictEqual(app.inferFailure(null, { server_id: 'a', spki_sha256: 'k' }), 'not-paired');
+  assert.strictEqual(app.inferFailure(stored, { server_id: 'a', spki_sha256: 'k' }), 'removed');
+  assert.strictEqual(app.inferFailure(stored, { server_id: 'a', spki_sha256: 'z' }), 'changed');
+  assert.strictEqual(app.inferFailure(stored, { server_id: 'b', spki_sha256: 'k' }), 'changed');
+});
+
+test('an older reply in the same epoch is dropped', () => {
+  const applied = { epoch: 'e', revision: 5 };
+  assert.ok(app.isStale(applied, { epoch: 'e', revision: 4 }));
+  assert.ok(!app.isStale(applied, { epoch: 'e', revision: 5 }));
+  assert.ok(!app.isStale(applied, { epoch: 'f', revision: 1 }));
+  assert.ok(!app.isStale(null, { epoch: 'e', revision: 1 }));
+  assert.ok(app.moved(applied, { epoch: 'e', revision: 6 }));
+  assert.ok(!app.moved(applied, { epoch: 'e', revision: 5 }));
+});
+
+test('waiting sessions and their projects come first', () => {
+  const groups = [
+    { project: { name: 'quiet' }, sessions: [{ name: 'a', waiting: false }] },
+    {
+      project: { name: 'busy' },
+      sessions: [
+        { name: 'b', waiting: false },
+        { name: 'c', waiting: true },
+      ],
+    },
+  ];
+  const out = app.arrange(groups);
+  assert.strictEqual(out[0].project.name, 'busy');
+  assert.strictEqual(out[0].sessions[0].name, 'c');
+});
+
+test('an op is 32 hex characters', () => {
+  const op = app.newOp((b) => b.fill(171));
+  assert.strictEqual(op, 'ab'.repeat(16));
+});
+
+test('every route is one table entry under /api/v1', () => {
+  for (const path of Object.values(app.API)) assert.ok(path.startsWith('/api/v1/'));
+  assert.strictEqual(app.route(app.API.sessions, 'x y'), '/api/v1/projects/x%20y/sessions');
+});
