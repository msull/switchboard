+const CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+/// A page request answered by the connection thread alone.
+fn page(port: &Port, path: &str) -> Resp {
+    exchange(port.addr, &port.client, "GET", path, &[], "").expect("page")
+}
+
+/// Pair as a browser does: `transport: cookie`, the reply and the
+/// cookie it set (`name=value`).
+fn pair_browser(port: &mut Port, code: &str, scope: Scope) -> (Resp, String) {
+    port.app.dispatch(AppAction::OpenPairing {
+        code: code.into(),
+        scope,
+    });
+    let spki = port
+        .remote
+        .state()
+        .identity
+        .as_ref()
+        .unwrap()
+        .spki_sha256
+        .clone();
+    let body = serde_json::json!({
+        "code": code, "device_name": "Safari on iPhone", "spki_sha256": spki, "transport": "cookie",
+    });
+    let resp = call_with(port, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(resp.status, 200, "{}", resp.body);
+    let set = resp.header("set-cookie").expect("a cookie").to_owned();
+    let cookie = set.split(';').next().unwrap().to_owned();
+    (resp, cookie)
+}
+
+fn json(resp: &Resp) -> serde_json::Value {
+    serde_json::from_str(&resp.body).unwrap_or_else(|e| panic!("{e}: {}", resp.body))
+}
