+
+    private static func parseURL(_ text: String) throws -> PairingInvite {
+        func bad(_ why: String) -> DecodingError {
+            .dataCorrupted(.init(codingPath: [], debugDescription: why))
+        }
+        guard let parts = URLComponents(string: text), let host = parts.host,
+            let fragment = parts.fragment
+        else { throw bad("the invite URL has no host or fragment") }
+        var fields: [String: String] = [:]
+        for pair in fragment.split(separator: "&") {
+            let kv = pair.split(separator: "=", maxSplits: 1).map(String.init)
+            if kv.count == 2 { fields[kv[0]] = kv[1] }
+        }
+        guard let code = fields["code"], !code.isEmpty else { throw bad("the invite has no code") }
+        guard let key = fields["key"], let id = fields["id"] else {
+            throw bad("the invite has no key or id")
+        }
+        let shown = host.contains(":") ? "[\(host)]" : host
+        let address = parts.port.map { "\(shown):\($0)" } ?? shown
+        return PairingInvite(serverID: ServerID(id), spkiSha256: key, code: code, addresses: [address])
     }
 }
