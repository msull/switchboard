+// --- the web control surface
+
+/// A response with its head kept: the page tests read headers.
+struct Raw {
+    status: u16,
+    headers: Vec<(String, String)>,
+    body: String,
+}
+
+impl Raw {
+    fn header(&self, name: &str) -> Option<&str> {
+        self.headers
+            .iter()
+            .find(|(n, _)| n.eq_ignore_ascii_case(name))
+            .map(|(_, v)| v.as_str())
+    }
+
+    fn json(&self) -> serde_json::Value {
+        serde_json::from_str(&self.body).unwrap_or_else(|e| panic!("{e}: {}", self.body))
+    }
+
+    fn error_code(&self) -> String {
+        self.json()["error"]["code"]
+            .as_str()
+            .unwrap_or("")
+            .to_owned()
+    }
+}
+
+/// One request with `headers` as given (a `Host` is added when none is),
+/// over a fresh pinned connection; the whole head comes back.
+fn http_raw(
+    addr: SocketAddr,
+    config: &Arc<ClientConfig>,
+    method: &str,
+    path: &str,
+    headers: &[(String, String)],
+    body: &str,
+) -> std::io::Result<Raw> {
+    let tcp = TcpStream::connect(addr)?;
+    tcp.set_read_timeout(Some(Duration::from_secs(10)))?;
+    let conn = ClientConnection::new(
+        Arc::clone(config),
+        ServerName::try_from("localhost").unwrap(),
+    )
+    .map_err(std::io::Error::other)?;
+    let mut s = StreamOwned::new(conn, tcp);
+    while s.conn.is_handshaking() {
+        s.conn.complete_io(&mut s.sock)?;
+    }
+    write!(s, "{method} {path} HTTP/1.1\r\n")?;
+    if !headers.iter().any(|(n, _)| n.eq_ignore_ascii_case("host")) {
+        write!(s, "Host: localhost\r\n")?;
+    }
+    for (n, v) in headers {
+        write!(s, "{n}: {v}\r\n")?;
+    }
+    write!(s, "Content-Length: {}\r\n\r\n{body}", body.len())?;
+    s.flush()?;
+    let mut reader = BufReader::new(s);
+    let mut line = String::new();
+    reader.read_line(&mut line)?;
+    let status: u16 = line
+        .split_whitespace()
+        .nth(1)
+        .and_then(|s| s.parse().ok())
+        .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidData, line.clone()))?;
+    let mut out_headers = Vec::new();
+    loop {
+        let mut h = String::new();
+        reader.read_line(&mut h)?;
+        let h = h.trim_end();
+        if h.is_empty() {
+            break;
+        }
+        if let Some((n, v)) = h.split_once(':') {
+            out_headers.push((n.trim().to_owned(), v.trim().to_owned()));
+        }
+    }
+    let length = out_headers
+        .iter()
+        .find(|(n, _)| n.eq_ignore_ascii_case("content-length"))
+        .and_then(|(_, v)| v.parse().ok())
+        .unwrap_or(0);
+    let mut body = vec![0; length];
+    reader.read_exact(&mut body)?;
+    Ok(Raw {
+        status,
+        headers: out_headers,
+        body: String::from_utf8_lossy(&body).into_owned(),
+    })
+}
+
+fn pairs(headers: &[(&str, &str)]) -> Vec<(String, String)> {
+    headers
+        .iter()
+        .map(|(n, v)| ((*n).to_owned(), (*v).to_owned()))
+        .collect()
+}
+
+/// `http_raw` from a client thread while the app serves on this one.
+fn raw(port: &mut Port, method: &str, path: &str, headers: &[(&str, &str)], body: &str) -> Raw {
+    let addr = port.addr;
+    let config = Arc::clone(&port.client);
+    let headers = pairs(headers);
+    let (method, path, body) = (method.to_owned(), path.to_owned(), body.to_owned());
+    let client =
+        std::thread::spawn(move || http_raw(addr, &config, &method, &path, &headers, &body));
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while !client.is_finished() {
+        assert!(std::time::Instant::now() < deadline, "no reply");
+        port.app.serve_pending();
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    client.join().unwrap().expect("http")
+}
+
+/// Pair as a browser does, with the cookie transport: the reply head.
+fn pair_browser(port: &mut Port, code: &str, scope: Scope) -> Raw {
+    port.app.dispatch(AppAction::OpenPairing {
+        code: code.into(),
+        scope,
+    });
+    let spki = port
+        .remote
+        .state()
+        .identity
+        .as_ref()
+        .unwrap()
+        .spki_sha256
+        .clone();
+    let body = serde_json::json!({
+        "code": code,
+        "device_name": "Safari on iPhone",
+        "spki_sha256": spki,
+        "transport": "cookie",
+    });
+    let reply = raw(port, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(reply.status, 200, "{}", reply.body);
+    reply
+}
+
+/// The `name=value` pair of a `Set-Cookie`, to send back as `Cookie`.
+fn cookie_pair(reply: &Raw) -> String {
+    let set = reply.header("set-cookie").expect("a Set-Cookie");
+    set.split(';').next().unwrap().to_owned()
+}
