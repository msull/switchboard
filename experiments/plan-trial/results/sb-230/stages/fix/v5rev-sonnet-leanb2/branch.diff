+/// The network address a device can reach this host on: the Mac's
+/// `local` address, only when the port listens beyond the loopback.
+#[must_use]
+pub fn lan_address(identity: &Identity, local: Option<IpAddr>) -> Option<IpAddr> {
+    local.filter(|_| identity.listen.lan)
+}
+
+/// The text the pairing QR carries: the page's address with the code,
+/// the host's key and its id in the fragment, which a browser never
+/// sends, so the code stays out of the first request and every log. A
+/// port that listens on this Mac alone answers no other address, so
+/// without a `lan` address the URL names the loopback one.
+#[must_use]
+pub fn invite_url(
+    identity: &Identity,
+    window: &PairingWindow,
+    lan: Option<IpAddr>,
+    port: u16,
+) -> String {
+    let address = lan.unwrap_or_else(|| IpAddr::from([127, 0, 0, 1]));
+    let host = match address {
+        IpAddr::V4(ip) => ip.to_string(),
+        IpAddr::V6(ip) => format!("[{ip}]"),
+    };
+    format!(
+        "https://{host}:{port}/#code={}&key={}&id={}",
+        window.code, identity.spki_sha256, identity.server_id
+    )
+}
