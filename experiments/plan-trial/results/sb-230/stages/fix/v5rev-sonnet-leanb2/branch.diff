+    let cookie = cookie_pair(&reply);
+    let c = [("Cookie", cookie.as_str())];
+    let me = raw(&mut port, "GET", "/api/v1/me", &c, "").json();
+    assert_eq!(me["body"]["scope"], "read");
+    let device = port.app.core().devices()[0].id;
+    port.app.dispatch(AppAction::SetDeviceScope {
+        device,
+        scope: Scope::Control,
+    });
+    let me = raw(&mut port, "GET", "/api/v1/me", &c, "").json();
+    assert_eq!(me["body"]["scope"], "control");
+
+    let before = raw(&mut port, "GET", "/api/v1/info", &[], "").json();
+    port.app.dispatch(AppAction::RevokeDevice(device));
+    let r = raw(&mut port, "GET", "/api/v1/me", &c, "");
+    assert_eq!((r.status, r.error_code().as_str()), (401, "unauthorized"));
+    // What the page needs to say "removed": the same identity and key.
+    let after = raw(&mut port, "GET", "/api/v1/info", &[], "").json();
+    assert_eq!(after["body"]["server_id"], before["body"]["server_id"]);
+    assert_eq!(after["body"]["spki_sha256"], before["body"]["spki_sha256"]);
+}
+
+#[test]
+fn a_rotated_key_keeps_the_server_id_and_changes_the_key_the_page_compares() {
+    let (old, _) = remote::make_identity(None, "Old", Listen::default()).unwrap();
+    let store = FakeRemoteStore::default();
+    store.state().identity = Some(old.clone());
+    let mut port = port_with(FakeHost::default(), FakeSecrets::default(), store);
+    let info = raw(&mut port, "GET", "/api/v1/info", &[], "").json();
+    assert_eq!(info["body"]["server_id"], old.server_id.to_string());
+    assert_ne!(info["body"]["spki_sha256"], old.spki_sha256);
+}
+
+#[test]
+fn a_page_load_frees_its_slot_and_the_page_window_is_its_own() {
+    let mut first = port();
+    // Five loads in a row: `Connection: close` frees each slot.
+    for _ in 0..=MAX_UNAUTHENTICATED {
+        assert_eq!(raw(&mut first, "GET", "/", &[], "").status, 200);
+        std::thread::sleep(Duration::from_millis(30));
+    }
+    // Four stalled strangers still leave a page request closed at accept.
+    let strangers: Vec<TcpStream> = (0..MAX_UNAUTHENTICATED)
+        .map(|_| TcpStream::connect(first.addr).expect("connect"))
+        .collect();
+    std::thread::sleep(Duration::from_millis(100));
+    let result = http_raw(first.addr, &first.client, "GET", "/", &[], "");
+    assert!(result.is_err(), "the pool is full of strangers");
+    drop(strangers);
+    drop(first);
+
+    // 120 page requests a minute; the 121st is refused, `/info` and `/pair` are not.
+    let mut port = port();
+    let mut statuses = Vec::new();
+    for _ in 0..121 {
+        statuses.push(raw(&mut port, "GET", "/app.css", &[], "").status);
+        // Let the thread give its slot back before the next accept.
+        std::thread::sleep(Duration::from_millis(3));
+    }
+    assert_eq!(statuses.iter().filter(|s| **s == 200).count(), 120);
+    assert_eq!(statuses[120], 429);
+    assert_eq!(raw(&mut port, "GET", "/api/v1/info", &[], "").status, 200);
+    assert_eq!(
+        raw(&mut port, "POST", "/api/v1/pair", &[], "{}").status,
+        403
+    );
+}
+
+#[test]
+fn the_pages_logic_passes_its_own_tests_under_node() {
+    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("web");
+    let Ok(out) = std::process::Command::new("node")
+        .arg("--test")
+        .arg(dir.join("app.test.js"))
+        .output()
+    else {
+        return; // no node here: skip, as the tmux tests do
+    };
+    assert!(
+        out.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
