+/// The cookie a browser holds its token in for one host. The id is in
+/// the name because cookies ignore ports, so two instances on one
+/// address would otherwise overwrite each other's credential.
+#[must_use]
+pub fn cookie_name(server_id: Uuid) -> String {
+    format!("__Host-sb-{server_id}")
+}
+
+/// The value of the cookie `name` in a `Cookie` header, matched by exact
+/// name; every other cookie is ignored.
+#[must_use]
+pub fn cookie_value<'a>(header: &'a str, name: &str) -> Option<&'a str> {
+    header
+        .split(';')
+        .filter_map(|pair| pair.trim().split_once('='))
+        .find(|(n, _)| *n == name)
+        .map(|(_, v)| v)
+        .filter(|v| !v.is_empty())
+}
