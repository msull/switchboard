+/// The `/api/v1/...` strings in `text`, each up to its closing quote.
+fn api_strings(text: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut rest = text;
+    while let Some(at) = rest.find("/api/v1/") {
+        let tail = &rest[at..];
+        let end = tail.find(['\'', '"', '`']).unwrap_or(tail.len());
+        out.push(tail[..end].to_owned());
+        rest = &tail[end..];
+    }
+    out
+}
