+fn the_embedded_page_asks_only_for_what_the_host_serves() {
+    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("web");
+    let html = std::fs::read_to_string(dir.join("index.html")).unwrap();
+    let js = std::fs::read_to_string(dir.join("app.js")).unwrap();
+    // The embedded bytes are the files.
+    for (path, text) in [("/", &html), ("/app.js", &js)] {
+        assert_eq!(switchboard::adapters::web::page(path).unwrap().body, text);
+    }
+    // Guards: no inline script or style, no handler attributes, and
+    // nothing that turns agent output into markup or code.
+    assert!(!html.contains("style="));
+    for tag in html.split("<script").skip(1) {
+        let open = &tag[..tag.find('>').unwrap()];
+        assert!(open.contains("src="), "an inline script: {open}");
+    }
+    assert!(!html.contains(" on"), "an event handler attribute");
+    for banned in [
+        "innerHTML",
+        "outerHTML",
+        "eval(",
+        "document.write",
+        "insertAdjacentHTML",
+    ] {
+        assert!(!js.contains(banned), "{banned}");
+    }
+    // `src` and `href` values are pages we serve, or `data:`.
+    for attr in ["src=\"", "href=\""] {
+        for part in html.split(attr).skip(1) {
+            let value = &part[..part.find('"').unwrap()];
+            assert!(
+                value.starts_with("data:") || switchboard::adapters::web::page(value).is_some(),
+                "{value}"
+            );
+        }
+    }
+
+    // Every route in app.js answers something other than `not_found`
+    // for a paired device.
+    let mut port = port();
+    port.transcripts.set(Some(conversation(2)));
+    let (_, project, session) = seed(&mut port, "");
+    launched(&mut port, &session);
+    let token = pair(&mut port, "ABCD2345", Scope::Control, "Pad");
+    let auth = format!("Bearer {token}");
