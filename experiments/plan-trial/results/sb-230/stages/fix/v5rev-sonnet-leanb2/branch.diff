new file mode 100644
index 0000000..d1f6de1
--- /dev/null
+++ b/src/adapters/web.rs
@@ -0,0 +1,67 @@
+//! The web control surface's three files, embedded at build time and
+//! answered on the connection thread, before pairing and without the
+//! frame: the bytes are constant, so a page load never waits on a busy
+//! frame. They carry no secret; the page learns everything else through
+//! the same `/api/v1/` routes a headset uses.
+
+/// One embedded file.
+pub struct Page {
+    /// The exact request path it answers.
+    pub path: &'static str,
+    /// The `Content-Type` it is sent with.
+    pub content_type: &'static str,
+    /// The file, embedded at build time.
+    pub body: &'static str,
+}
+
+/// The pages, matched by exact path.
+pub const PAGES: [Page; 3] = [
+    Page {
+        path: "/",
+        content_type: "text/html; charset=utf-8",
+        body: include_str!("../../web/index.html"),
+    },
+    Page {
+        path: "/app.js",
+        content_type: "text/javascript; charset=utf-8",
+        body: include_str!("../../web/app.js"),
+    },
+    Page {
+        path: "/app.css",
+        content_type: "text/css; charset=utf-8",
+        body: include_str!("../../web/app.css"),
+    },
+];
+
+/// The page for `path` (query already stripped), if it is one of ours.
+#[must_use]
+pub fn page(path: &str) -> Option<&'static Page> {
+    PAGES.iter().find(|p| p.path == path)
+}
+
+/// The content security policy: nothing inline and nothing external, so
+/// agent output that reaches the DOM as text cannot become script.
+pub const CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+/// Headers on every page reply, besides the type and length.
+pub const HEADERS: [(&str, &str); 4] = [
+    ("Content-Security-Policy", CSP),
+    ("Cache-Control", "no-store"),
+    ("X-Content-Type-Options", "nosniff"),
+    ("Referrer-Policy", "no-referrer"),
+];
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pages_match_exactly() {
+        assert!(page("/").is_some());
+        assert!(page("/app.js").is_some());
+        assert!(page("/app.css").is_some());
+        assert!(page("/favicon.ico").is_none());
+        assert!(page("/api/v1/info").is_none());
+        assert!(page("/app.js/").is_none());
+    }
+}
