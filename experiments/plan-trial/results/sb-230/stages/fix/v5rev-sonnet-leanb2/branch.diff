+  --link: #1d4ed8;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --fg: #f2f2f3;
+    --bg: #161618;
+    --card: #232326;
+    --line: #3a3a3f;
+    --muted: #a1a1aa;
+    --accent: #fbbf24;
+    --link: #93c5fd;
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+body {
+  margin: 0;
+  font: 16px/1.4 system-ui, sans-serif;
+  color: var(--fg);
+  background: var(--bg);
+}
+
+header {
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--line);
+}
+
+main {
+  max-width: 44rem;
+  margin: 0 auto;
+  padding: 16px;
+}
+
+h2 {
+  margin: 20px 0 8px;
+  font-size: 1rem;
+  color: var(--muted);
+}
+
+.row {
+  display: block;
+  width: 100%;
+  margin: 0 0 8px;
+  padding: 12px;
+  text-align: left;
+  font: inherit;
+  color: inherit;
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 8px;
+}
+
+.row.waiting {
+  border-left: 6px solid var(--accent);
+}
+
+.row .flag {
+  display: block;
+  font-weight: 600;
+  color: var(--accent);
+}
+
+.row .meta {
+  display: block;
+  font-size: 0.875rem;
+  color: var(--muted);
+}
+
+pre {
+  margin: 8px 0;
+  padding: 12px;
+  overflow-x: auto;
+  white-space: pre-wrap;
+  word-break: break-word;
+  font: 0.8125rem/1.35 ui-monospace, monospace;
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 8px;
+}
+
