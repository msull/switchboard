+"""Spike 23: a throwaway HTTPS server for the browser questions behind the
+remote port's web page. Run two on different ports (see README.md):
+
+    python3 serve.py 8443 aaaaaaaa
+    python3 serve.py 8444 bbbbbbbb
+
+`/` is a page with no inline script that sets this server's cookie
+(`__Host-sb-<id>`, HttpOnly) by `fetch`, reads it back, and tries a
+`wss:` socket under the same Content-Security-Policy the host sends.
+"""
+
+import json
+import secrets
+import ssl
+import sys
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+PORT = int(sys.argv[1])
+SERVER_ID = sys.argv[2]
+NAME = f"__Host-sb-{SERVER_ID}"
+HERE = Path(__file__).resolve().parent
+CSP = (
+    "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; "
+    "img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
+)
+
+
+def cookie_value(header):
+    for pair in (header or "").split(";"):
+        name, _, value = pair.strip().partition("=")
+        if name == NAME:
+            return value
+    return None
+
+
+class Handler(BaseHTTPRequestHandler):
+    def send_body(self, status, content_type, body, extra=()):
+        self.send_response(status)
+        self.send_header("Content-Type", content_type)
+        self.send_header("Content-Length", str(len(body)))
+        self.send_header("Content-Security-Policy", CSP)
+        self.send_header("Cache-Control", "no-store")
+        self.send_header("Connection", "close")
+        for name, value in extra:
+            self.send_header(name, value)
+        self.end_headers()
+        self.wfile.write(body)
+
+    def do_GET(self):
+        path = self.path.split("?")[0]
+        self.log_message("connection from port %s", self.client_address[1])
+        if path == "/":
+            self.send_body(200, "text/html; charset=utf-8", (HERE / "index.html").read_bytes())
+        elif path == "/spike.js":
+            self.send_body(200, "text/javascript", (HERE / "spike.js").read_bytes())
+        elif path == "/set":
+            token = secrets.token_urlsafe(32)
+            cookie = f"{NAME}={token}; Max-Age=34560000; Path=/; Secure; HttpOnly; SameSite=Strict"
+            body = json.dumps({"set": NAME, "token_tail": token[-6:]}).encode()
+            self.send_body(200, "application/json", body, [("Set-Cookie", cookie)])
+        elif path == "/get":
+            value = cookie_value(self.headers.get("Cookie"))
+            body = json.dumps(
+                {
+                    "name": NAME,
+                    "found": value is not None,
+                    "token_tail": value[-6:] if value else None,
+                    "cookie_names": [
+                        p.strip().partition("=")[0]
+                        for p in (self.headers.get("Cookie") or "").split(";")
+                        if p.strip()
+                    ],
+                }
+            ).encode()
+            self.send_body(200, "application/json", body)
+        else:
+            self.send_body(404, "application/json", b'{"error":"not_found"}')
+
+
+context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+context.load_cert_chain(HERE / "cert.pem", HERE / "key.pem")
+server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
+server.socket = context.wrap_socket(server.socket, server_side=True)
+print(f"https://<this Mac's address>:{PORT}/  cookie {NAME}")
+server.serve_forever()
