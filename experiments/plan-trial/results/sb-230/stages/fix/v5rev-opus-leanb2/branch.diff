+// --- the web page
+
+/// A reply with its head: the status, every header as sent, the body.
+struct Response {
+    status: u16,
+    headers: Vec<(String, String)>,
+    body: Vec<u8>,
+}
+
+impl Response {
+    fn header(&self, name: &str) -> Option<&str> {
+        self.headers
+            .iter()
+            .find(|(n, _)| n.eq_ignore_ascii_case(name))
+            .map(|(_, v)| v.as_str())
+    }
+
+    fn json(&self) -> serde_json::Value {
+        serde_json::from_slice(&self.body)
+            .unwrap_or_else(|e| panic!("{e}: {}", String::from_utf8_lossy(&self.body)))
+    }
+
+    fn text(&self) -> String {
+        String::from_utf8_lossy(&self.body).into_owned()
+    }
+}
+
+type Tls = BufReader<StreamOwned<ClientConnection, TcpStream>>;
+
+/// A pinned TLS connection, handshake done.
+fn connect(addr: SocketAddr, config: &Arc<ClientConfig>) -> std::io::Result<Tls> {
+    let tcp = TcpStream::connect(addr)?;
+    tcp.set_read_timeout(Some(Duration::from_secs(10)))?;
+    let conn = ClientConnection::new(
+        Arc::clone(config),
+        ServerName::try_from("localhost").unwrap(),
+    )
+    .map_err(std::io::Error::other)?;
+    let mut s = StreamOwned::new(conn, tcp);
+    while s.conn.is_handshaking() {
+        s.conn.complete_io(&mut s.sock)?;
+    }
+    Ok(BufReader::new(s))
+}
+
+/// One request on `conn` with `headers` beside `Host: localhost`, and
+/// its reply read whole.
+fn exchange(
+    conn: &mut Tls,
+    method: &str,
+    path: &str,
+    headers: &[(&str, String)],
+    body: &str,
+) -> std::io::Result<Response> {
+    let extra = headers.iter().fold(String::new(), |mut s, (n, v)| {
+        use std::fmt::Write as _;
+        let _ = write!(s, "{n}: {v}\r\n");
+        s
+    });
+    write!(
+        conn.get_mut(),
+        "{method} {path} HTTP/1.1\r\nHost: localhost\r\n{extra}Content-Length: {}\r\n\r\n{body}",
+        body.len()
+    )?;
+    conn.get_mut().flush()?;
+    let mut line = String::new();
+    conn.read_line(&mut line)?;
+    let status: u16 = line
+        .split_whitespace()
+        .nth(1)
+        .and_then(|s| s.parse().ok())
+        .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidData, line.clone()))?;
+    let mut headers = Vec::new();
+    loop {
+        let mut h = String::new();
+        conn.read_line(&mut h)?;
+        let h = h.trim_end();
+        if h.is_empty() {
+            break;
+        }
+        if let Some((n, v)) = h.split_once(':') {
+            headers.push((n.trim().to_owned(), v.trim().to_owned()));
+        }
+    }
+    let length = headers
+        .iter()
+        .find(|(n, _)| n.eq_ignore_ascii_case("content-length"))
+        .and_then(|(_, v)| v.parse().ok())
+        .unwrap_or(0);
+    let mut body = vec![0; length];
+    conn.read_exact(&mut body)?;
+    Ok(Response {
+        status,
+        headers,
+        body,
+    })
+}
+
+/// A page file over a fresh connection: answered on the connection
+/// thread, so the frame need not serve.
+fn page_load(
+    addr: SocketAddr,
+    config: &Arc<ClientConfig>,
+    path: &str,
+) -> std::io::Result<Response> {
+    exchange(&mut connect(addr, config)?, "GET", path, &[], "")
+}
+
+/// A page load that waits out a slot still being given back: the
+/// previous load's thread frees its slot a moment after the client
+/// sees the close.
+fn page_load_retrying(port: &Port, path: &str) -> Response {
+    let mut last = None;
+    for _ in 0..50 {
+        match page_load(port.addr, &port.client, path) {
+            Ok(r) => return r,
+            Err(e) => last = Some(e),
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    panic!("no page: {last:?}");
+}
+
+/// A request from a client thread with `headers`, served by the app on
+/// this thread.
+fn call_with(
+    port: &mut Port,
+    method: &str,
+    path: &str,
+    headers: &[(&str, String)],
+    body: &str,
+) -> Response {
+    let addr = port.addr;
+    let config = Arc::clone(&port.client);
+    let (method, path, body) = (method.to_owned(), path.to_owned(), body.to_owned());
+    let headers: Vec<(String, String)> = headers
+        .iter()
+        .map(|(n, v)| ((*n).to_owned(), v.clone()))
+        .collect();
+    let client = std::thread::spawn(move || {
+        let headers: Vec<(&str, String)> = headers
+            .iter()
+            .map(|(n, v)| (n.as_str(), v.clone()))
+            .collect();
+        exchange(
+            &mut connect(addr, &config)?,
+            &method,
+            &path,
+            &headers,
+            &body,
+        )
+    });
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while !client.is_finished() {
+        assert!(std::time::Instant::now() < deadline, "no reply");
+        port.app.serve_pending();
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    client.join().unwrap().expect("http")
+}
+
+fn cookie(value: &str) -> (&'static str, String) {
+    ("Cookie", value.to_owned())
+}
+
+/// The identity's key, as the QR carries it.
+fn spki(port: &Port) -> String {
+    port.remote
+        .state()
+        .identity
+        .as_ref()
+        .unwrap()
+        .spki_sha256
+        .clone()
+}
+
+/// Pair as a browser does: `/info`, then `/pair` asking for the cookie.
+/// The reply, whose `Set-Cookie` carries the token.
+fn pair_browser(port: &mut Port, code: &str, scope: Scope) -> Response {
+    port.app.dispatch(AppAction::OpenPairing {
+        code: code.into(),
+        scope,
+    });
+    let (status, info) = get(port, "/api/v1/info", None);
+    assert_eq!(status, 200);
+    assert_eq!(info["body"]["spki_sha256"], spki(port));
+    let body = serde_json::json!({
+        "code": code,
+        "spki_sha256": spki(port),
+        "device_name": "Safari on iPhone",
+        "transport": "cookie",
+    });
+    let reply = call_with(port, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(reply.status, 200, "{}", reply.text());
+    reply
+}
+
+/// `name=value` from a reply's `Set-Cookie`, and its attributes.
+fn set_cookie(reply: &Response) -> (String, Vec<String>) {
+    let header = reply.header("Set-Cookie").expect("a cookie");
+    let mut parts = header.split(';').map(|p| p.trim().to_owned());
+    let pair = parts.next().unwrap();
+    (pair, parts.collect())
+}
+
+/// A second, native pairing on the same host: its token.
+fn native_pair(port: &mut Port) -> String {
+    pair(port, "NATV2345", Scope::Control, "Pad")
+}
+
+/// The page's three files answer anyone, each with its type and the
+/// headers that keep a browser to the page's own files, and close the
+/// connection; anything else still gets the frame's JSON 404.
+#[test]
+fn the_page_is_served_to_anyone_with_its_headers_and_nothing_else_is() {
+    use switchboard::adapters::web;
+    let mut port = port();
+    assert_eq!(
+        web::CSP,
+        "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
+    );
+    for page in &web::PAGES {
+        let reply = page_load(port.addr, &port.client, page.path).expect("page");
+        assert_eq!(reply.status, 200, "{}", page.path);
+        assert_eq!(reply.header("Content-Type"), Some(page.content_type));
+        assert_eq!(reply.header("Content-Security-Policy"), Some(web::CSP));
+        assert_eq!(reply.header("Cache-Control"), Some("no-store"));
+        assert_eq!(reply.header("X-Content-Type-Options"), Some("nosniff"));
+        assert_eq!(reply.header("Referrer-Policy"), Some("no-referrer"));
+        assert_eq!(reply.header("Connection"), Some("close"));
+        assert_eq!(reply.body, page.body);
+    }
+    let reply = page_load(port.addr, &port.client, "/?code=ZZZZ9999&key=ab").expect("page");
+    assert_eq!(reply.status, 200, "a query on a page path is ignored");
+    assert!(!reply.text().contains("ZZZZ9999"), "and never echoed");
+
+    for (method, path) in [("GET", "/favicon.ico"), ("POST", "/"), ("GET", "/api")] {
+        let reply = call_with(&mut port, method, path, &[], "");
+        assert_eq!(reply.status, 404, "{method} {path}");
+        assert_eq!(code(&reply.json()), "not_found", "{method} {path}");
+    }
+    let reply = call_with(&mut port, "GET", "/api/v1/info", &[], "");
+    assert_eq!(reply.header("Cache-Control"), Some("no-store"));
+    assert_eq!(reply.header("X-Content-Type-Options"), Some("nosniff"));
+    assert_eq!(reply.header("Connection"), Some("keep-alive"));
+}
