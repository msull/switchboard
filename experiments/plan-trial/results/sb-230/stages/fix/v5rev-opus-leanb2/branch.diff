+/// The page names only what the host serves: its own files, and API
+/// paths that are routes; and it has no inline script or style and no
+/// way to turn the host's text into markup.
+#[test]
+fn the_embedded_page_names_only_what_the_host_serves() {
+    use switchboard::adapters::web;
+    let html = String::from_utf8(web::PAGES[0].body.to_vec()).unwrap();
+    let js = String::from_utf8(web::page("/app.js").unwrap().body.to_vec()).unwrap();
+    let attribute_values = |text: &str, attr: &str| -> Vec<String> {
+        text.split(&format!("{attr}=\""))
+            .skip(1)
+            .map(|rest| rest.split('"').next().unwrap().to_owned())
+            .collect()
+    };
+    let named: Vec<String> = attribute_values(&html, " src")
+        .into_iter()
+        .chain(attribute_values(&html, " href"))
+        .collect();
+    assert!(named.len() >= 3, "{named:?}");
+    for value in named {
+        assert!(
+            value.starts_with("data:") || web::page(&value).is_some(),
+            "{value} is not served"
+        );
+    }
+    let scripts = html.matches("<script").count();
+    assert_eq!(
+        scripts,
+        html.matches("<script src=").count(),
+        "inline script"
+    );
+    assert!(!html.contains("style="), "inline style");
+    let lower = html.to_ascii_lowercase();
+    for (i, _) in lower.match_indices(" on") {
+        let name: String = lower[i + 3..]
+            .chars()
+            .take_while(char::is_ascii_alphabetic)
+            .collect();
+        assert!(
+            !lower[i + 3 + name.len()..].starts_with('='),
+            "an inline handler: on{name}"
+        );
+    }
+    for banned in [
+        "innerHTML",
+        "outerHTML",
+        "insertAdjacentHTML",
+        "eval(",
+        "document.write",
+        "new Function",
+    ] {
+        assert!(!js.contains(banned), "{banned} in app.js");
+    }
+
+    let mut port = port();
+    let (_, project, session) = seed(&mut port, "");
+    let token = pair(&mut port, "ABCD2345", Scope::Control, "Pad");
+    let paths: Vec<&str> = js
+        .split("'/api/v1/")
+        .skip(1)
+        .map(|rest| rest.split('\'').next().unwrap())
+        .collect();
+    assert!(paths.len() >= 10, "{paths:?}");
+    for path in paths {
+        let path = format!("/api/v1/{path}")
+            .replace("/projects/{id}", &format!("/projects/{project}"))
+            .replace("/sessions/{id}", &format!("/sessions/{session}"));
+        assert!(!path.contains('{'), "{path}");
+        let method = if path.ends_with("/pair") || path.ends_with("/send") {
+            "POST"
+        } else {
+            "GET"
+        };
+        let (status, reply) = call(&mut port, method, &path, Some(&token), "{}");
+        let message = reply["error"]["message"].as_str().unwrap_or("");
+        assert!(
+            !(status == 404
+                && ["no such endpoint", "not available on this port"].contains(&message)),
+            "{method} {path} is not a route: {reply}"
+        );
+    }
+}
