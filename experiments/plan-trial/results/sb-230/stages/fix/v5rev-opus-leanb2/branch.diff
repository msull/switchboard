+        let rest = text.dropFirst("https://".count)
+        guard let hash = rest.firstIndex(of: "#") else { throw InviteError.incomplete }
+        // The authority as written, so an IPv6 address keeps its
+        // brackets the way `Address` reads them.
+        let address = String(rest[..<hash].prefix { $0 != "/" })
