+    assert_eq!(reply.json()["body"]["token"].as_str().unwrap().len(), 43);
+
+    // A second instance: another name, and each host reads its own.
+    let mut b = port();
+    let (pair_b, _) = set_cookie(&pair_browser(&mut b, "ABCD2345", Scope::Read));
+    assert_ne!(
+        pair_a.split_once('=').unwrap().0,
+        pair_b.split_once('=').unwrap().0
+    );
+    let both = cookie(&format!("theme=dark; {pair_a}; {pair_b}"));
+    let device_b = b.app.core().devices()[0].id;
+    let me = call_with(&mut a, "GET", "/api/v1/me", std::slice::from_ref(&both), "");
+    assert_eq!(me.json()["body"]["device_id"], device_a.id.to_string());
+    let me = call_with(&mut b, "GET", "/api/v1/me", &[both], "");
+    assert_eq!(me.json()["body"]["device_id"], device_b.to_string());
+    let other = call_with(&mut a, "GET", "/api/v1/me", &[cookie(&pair_b)], "");
+    assert_eq!((other.status, code(&other.json())), (401, "unauthorized"));
+    let fixed = cookie(&format!("__Host-sb={token}"));
+    let reply = call_with(&mut a, "GET", "/api/v1/me", &[fixed], "");
+    assert_eq!((reply.status, code(&reply.json())), (401, "unauthorized"));
+}
+
+/// A write or an upgrade by cookie alone must carry this host's own
+/// origin; a bearer needs none, and a read by cookie needs none.
+#[test]
+fn a_write_by_cookie_must_come_from_the_hosts_page() {
+    let mut port = port();
+    let (_, _, session) = seed(&mut port, "");
+    let (pair, _) = set_cookie(&pair_browser(&mut port, "ABCD2345", Scope::Control));
+    let send = format!("/api/v1/sessions/{session}/send");
+    let body = r#"{"op":"web-1","text":"hello"}"#;
+    for origin in [
+        None,
+        Some("https://evil.example"),
+        Some("http://localhost"),
+        Some("https://localhost:1"),
+    ] {
+        let mut headers = vec![cookie(&pair)];
+        headers.extend(origin.map(|o| ("Origin", o.to_owned())));
+        let reply = call_with(&mut port, "POST", &send, &headers, body);
+        assert_eq!(
+            (reply.status, code(&reply.json())),
+            (403, "origin"),
+            "{origin:?}"
+        );
+    }
+    let own = ("Origin", "https://localhost".to_owned());
+    let reply = call_with(
+        &mut port,
+        "POST",
+        &send,
+        &[cookie(&pair), own.clone()],
+        body,
+    );
+    assert_ne!(code(&reply.json()), "origin", "{}", reply.text());
+    assert_ne!(reply.status, 401);
+
+    let token = native_pair(&mut port);
+    let reply = call_with(
+        &mut port,
+        "POST",
+        &send,
+        &[("Authorization", format!("Bearer {token}"))],
+        r#"{"op":"native-1","text":"hello"}"#,
+    );
+    assert_ne!(code(&reply.json()), "origin", "{}", reply.text());
+    let reply = call_with(&mut port, "GET", "/api/v1/waiting", &[cookie(&pair)], "");
+    assert_eq!(reply.status, 200, "a read by cookie needs no Origin");
+
+    let foreign = subscribe_with(
+        &mut port,
+        "/api/v1/events",
+        &[cookie(&pair), ("Origin", "https://evil.example".to_owned())],
+    );
+    assert!(foreign.is_err(), "a cross-origin upgrade is refused");
+    let own = subscribe_with(&mut port, "/api/v1/events", &[cookie(&pair), own]);
+    assert!(own.is_ok(), "{:?}", own.err());
+}
+
+/// `/me` follows the scope the dialog sets, and after a revocation the
+/// cookie is refused while `/info` still names the same host, which is
+/// how the page tells "removed on the host" from "identity changed".
+#[test]
+fn me_follows_the_scope_and_a_revoked_browser_can_tell_it_was_removed() {
+    let mut port = port();
+    let (_, info) = get(&mut port, "/api/v1/info", None);
+    let (pair, _) = set_cookie(&pair_browser(&mut port, "ABCD2345", Scope::Read));
+    let me = call_with(&mut port, "GET", "/api/v1/me", &[cookie(&pair)], "");
+    assert_eq!(me.json()["body"]["scope"], "read");
+    let id = port.app.core().devices()[0].id;
+    port.app.dispatch(AppAction::SetDeviceScope {
+        device: id,
+        scope: Scope::Control,
+    });
+    let me = call_with(&mut port, "GET", "/api/v1/me", &[cookie(&pair)], "");
+    assert_eq!(me.json()["body"]["scope"], "control");
+    port.app.dispatch(AppAction::RevokeDevice(id));
+    let me = call_with(&mut port, "GET", "/api/v1/me", &[cookie(&pair)], "");
+    assert_eq!((me.status, code(&me.json())), (401, "unauthorized"));
+    let (_, after) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(after["body"]["server_id"], info["body"]["server_id"]);
+    assert_eq!(after["body"]["spki_sha256"], info["body"]["spki_sha256"]);
+    let (status, reply) = get(&mut port, "/api/v1/me", None);
+    assert_eq!((status, code(&reply)), (401, "unauthorized"), "unpaired");
+}
+
+/// A page load closes its connection, so four browsers that keep theirs
+/// open still leave a slot for a fifth; and the page has a window of
+/// its own, which leaves `/info` and `/pair` theirs.
+#[test]
+fn a_page_load_frees_its_slot_and_has_its_own_window() {
+    let mut port = port();
+    let mut held = Vec::new();
+    for _ in 0..MAX_UNAUTHENTICATED {
+        let mut conn = connect(port.addr, &port.client).expect("connect");
+        let reply = exchange(&mut conn, "GET", "/", &[], "").expect("page");
+        assert_eq!(reply.status, 200);
+        let mut buf = [0u8; 1];
+        let closed = matches!(conn.get_mut().read(&mut buf), Ok(0) | Err(_));
+        assert!(closed, "the host closed after the page");
+        held.push(conn);
+    }
+    let fifth = page_load_retrying(&port, "/app.css");
+    assert_eq!(fifth.status, 200, "the slots came back");
+    drop(held);
+
+    // Five loads so far; the window allows `PAGE_PER_MINUTE`.
+    for _ in 5..remote::PAGE_PER_MINUTE {
+        assert_eq!(page_load_retrying(&port, "/app.js").status, 200);
+    }
+    let over = page_load_retrying(&port, "/");
+    assert_eq!(over.status, 429);
+    assert_eq!(code(&over.json()), "rate_limited");
+    let (status, _) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200, "info keeps its own window");
+    let (status, reply) = call(&mut port, "POST", "/api/v1/pair", None, "{}");
+    assert_eq!((status, code(&reply)), (403, "pairing_closed"), "and pair");
+}
+
+/// The page's pure logic (the fragment, the device name, the 401
+/// inference, the revision order) under `node --test`, when `node` is
+/// on the PATH; skipped cleanly where it is not.
+#[test]
+fn the_pages_own_logic_passes_its_node_tests() {
+    let Ok(version) = std::process::Command::new("node").arg("--version").output() else {
+        eprintln!("node is not installed; skipping web/app.test.js");
+        return;
+    };
+    if !version.status.success() {
+        eprintln!("node does not run; skipping web/app.test.js");
+        return;
+    }
+    let out = std::process::Command::new("node")
+        .args(["--test", "web/app.test.js"])
+        .current_dir(env!("CARGO_MANIFEST_DIR"))
+        .output()
+        .expect("node");
+    assert!(
+        out.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
