+        for pair in rest[rest.index(after: hash)...].split(separator: "&") {
+            let parts = pair.split(separator: "=", maxSplits: 1)
+            guard parts.count == 2 else { continue }
+            values[String(parts[0])] = String(parts[1]).removingPercentEncoding
+        }
+        guard let code = values["code"], !code.isEmpty,
+              let key = values["key"], !key.isEmpty,
+              let id = values["id"], !id.isEmpty
+        else { throw InviteError.incomplete }
+        return PairingInvite(
+            serverID: ServerID(id), spkiSha256: key, code: code,
+            addresses: address.isEmpty ? [] : [address])
     }
 }
