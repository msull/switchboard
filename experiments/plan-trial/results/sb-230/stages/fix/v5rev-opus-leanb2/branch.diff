+        .unwrap_or(IpAddr::V4(Ipv4Addr::LOCALHOST));
+    format!(
+        "https://{}/#code={}&key={}&id={}",
+        SocketAddr::new(ip, port),
+        window.code,
+        identity.spki_sha256,
+        identity.server_id
+    )
+}
