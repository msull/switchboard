--- /dev/null
+++ b/src/adapters/web.rs
@@ -0,0 +1,76 @@
+//! The web page the remote port serves: three files under `web/`,
+//! embedded at build time, answered on the connection thread before a
+//! request reaches the frame. The page speaks the same `/api/v1`
+//! protocol a native client does; nothing here knows what it says.
+
+/// One file of the page.
+pub struct Page {
+    pub path: &'static str,
+    pub content_type: &'static str,
+    pub body: &'static [u8],
+}
+
+/// Every path the page is served at, matched exactly. Anything else
+/// goes to the frame, which answers a JSON 404 outside `/api/v1/`.
+pub const PAGES: [Page; 3] = [
+    Page {
+        path: "/",
+        content_type: "text/html; charset=utf-8",
+        body: include_bytes!("../../web/index.html"),
+    },
+    Page {
+        path: "/app.js",
+        content_type: "text/javascript; charset=utf-8",
+        body: include_bytes!("../../web/app.js"),
+    },
+    Page {
+        path: "/app.css",
+        content_type: "text/css; charset=utf-8",
+        body: include_bytes!("../../web/app.css"),
+    },
+];
+
+/// The policy every page reply carries: the page's own files and its
+/// own origin, nothing inline, nothing framed. A browser that does not
+/// count `wss:` as `'self'` loses the events socket, and the page
+/// polls instead.
+pub const CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+/// The headers on every page reply besides type, length and
+/// `Connection: close`.
+pub const PAGE_HEADERS: [(&str, &str); 4] = [
+    ("Content-Security-Policy", CSP),
+    ("Cache-Control", "no-store"),
+    ("X-Content-Type-Options", "nosniff"),
+    ("Referrer-Policy", "no-referrer"),
+];
+
+/// The page file at `path`, if there is one.
+#[must_use]
+pub fn page(path: &str) -> Option<&'static Page> {
+    PAGES.iter().find(|p| p.path == path)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_three_paths_are_matched_exactly() {
+        assert_eq!(
+            page("/").map(|p| p.content_type),
+            Some(PAGES[0].content_type)
+        );
+        assert!(page("/app.js").is_some());
+        assert!(page("/app.css").is_some());
+        for other in [
+            "",
+            "/index.html",
+            "/app.js/",
+            "/favicon.ico",
+            "/api/v1/info",
+        ] {
+            assert!(page(other).is_none(), "{other}");
+        }
+    }
+}
