@@ -0,0 +1,31 @@
+'use strict';
+
+const out = document.getElementById('out');
+const lines = [];
+const say = (line) => {
+  lines.push(line);
+  out.textContent = lines.join('\n');
+};
+
+document.addEventListener('securitypolicyviolation', (e) => {
+  say('CSP blocked ' + e.blockedURI + ' under ' + e.violatedDirective);
+});
+
+(async () => {
+  say('origin ' + location.origin);
+  say('document.cookie sees: ' + JSON.stringify(document.cookie) + ' (HttpOnly should hide it)');
+  const before = await (await fetch('/get')).json();
+  say('before /set: ' + JSON.stringify(before));
+  const set = await (await fetch('/set')).json();
+  say('/set: ' + JSON.stringify(set));
+  const after = await (await fetch('/get')).json();
+  say('after /set: ' + JSON.stringify(after));
+  say(after.found && after.token_tail === set.token_tail ? 'COOKIE: stored and sent' : 'COOKIE: NOT sent back');
+  try {
+    const ws = new WebSocket('wss://' + location.host + '/ws');
+    ws.onopen = () => say('wss: opened (unexpected: the server has no socket)');
+    ws.onerror = () => say('wss: error (expected here: the server has no socket; a CSP block would be reported above)');
+  } catch (e) {
+    say('wss: constructor threw ' + e);
+  }
+})();
