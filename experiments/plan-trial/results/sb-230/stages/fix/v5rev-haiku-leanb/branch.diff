index 0000000..aa17ae0
--- /dev/null
+++ b/src/adapters/web.rs
@@ -0,0 +1,44 @@
+//! The web control surface's pages: the three files a browser loads
+//! from the remote port before anyone is paired. They are built into
+//! the binary from `web/` and carry no state, so the connection thread
+//! answers them without the frame.
+
+/// One page: the path a browser asks for, its type, and its bytes.
+pub struct Page {
+    /// The request path, matched exactly.
+    pub path: &'static str,
+    /// The `Content-Type` the reply carries.
+    pub content_type: &'static str,
+    /// The file's text, built into the binary from `web/`.
+    pub body: &'static str,
+}
+
+/// The policy every page reply carries: the page's own script, style
+/// and API calls, and nothing else; no framing, no base URI, no form
+/// target. The page has no inline script and no inline style.
+pub const CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+/// The page's three files, each at the path a browser asks for it.
+pub const PAGES: [Page; 3] = [
+    Page {
+        path: "/",
+        content_type: "text/html; charset=utf-8",
+        body: include_str!("../../web/index.html"),
+    },
+    Page {
+        path: "/app.js",
+        content_type: "text/javascript; charset=utf-8",
+        body: include_str!("../../web/app.js"),
+    },
+    Page {
+        path: "/app.css",
+        content_type: "text/css; charset=utf-8",
+        body: include_str!("../../web/app.css"),
+    },
+];
+
+/// The page at `path`, matched exactly; a query was already removed.
+#[must_use]
+pub fn find(path: &str) -> Option<&'static Page> {
+    PAGES.iter().find(|page| page.path == path)
+}
