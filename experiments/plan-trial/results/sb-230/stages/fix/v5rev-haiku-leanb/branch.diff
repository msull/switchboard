+/// The Content-Security-Policy the page's replies carry, exactly.
+const PAGE_CSP: &str = "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
+
+/// The three page files answer to anyone, with their type and the policy;
+/// anything else outside the API is the frame's JSON refusal.
+#[test]
+fn the_page_files_answer_before_pairing_with_their_policy() {
+    let mut port = port();
+    let pages = [
+        (
+            "/",
+            include_str!("../web/index.html"),
+            "text/html; charset=utf-8",
+        ),
+        (
+            "/app.js",
+            include_str!("../web/app.js"),
+            "text/javascript; charset=utf-8",
+        ),
+        (
+            "/app.css",
+            include_str!("../web/app.css"),
+            "text/css; charset=utf-8",
+        ),
+    ];
+    for (path, body, content_type) in pages {
+        let head = exchange(port.addr, &port.client, "GET", path, &[], "").expect("page");
+        assert_eq!(head.status, 200, "{path}");
+        assert_eq!(head.header("content-type"), Some(content_type), "{path}");
+        assert_eq!(
+            head.header("content-security-policy"),
+            Some(PAGE_CSP),
+            "{path}"
+        );
+        assert_eq!(head.header("cache-control"), Some("no-store"), "{path}");
+        assert_eq!(
+            head.header("x-content-type-options"),
+            Some("nosniff"),
+            "{path}"
+        );
+        assert_eq!(
+            head.header("referrer-policy"),
+            Some("no-referrer"),
+            "{path}"
+        );
+        assert_eq!(head.header("connection"), Some("close"), "{path}");
+        assert_eq!(head.body, body, "{path}");
+    }
+    // A query is ignored and never echoed.
+    let head = exchange(port.addr, &port.client, "GET", "/?code=ABCD2345", &[], "").unwrap();
+    assert_eq!(head.body, include_str!("../web/index.html"));
+
+    for (method, path) in [("GET", "/favicon.ico"), ("GET", "/api"), ("POST", "/")] {
+        let (status, reply) = call(&mut port, method, path, None, "");
+        assert_eq!(
+            (status, code(&reply)),
+            (404, "not_found"),
+            "{method} {path}: {reply}"
+        );
+    }
+}
