+/// The pairing invite: the host's page at `host` and `port`, with the
+/// code, the key and the installation in the fragment. A fragment is
+/// never sent in a request, so the code reaches no server before the
+/// page has it; a phone's camera and a paste both carry this text.
+#[must_use]
+pub fn invite_url(identity: &Identity, window: &PairingWindow, host: IpAddr, port: u16) -> String {
+    let host = match host {
+        IpAddr::V4(ip) => ip.to_string(),
+        IpAddr::V6(ip) => format!("[{ip}]"),
+    };
+    format!(
+        "https://{host}:{port}/#code={}&key={}&id={}",
+        window.code, identity.spki_sha256, identity.server_id
+    )
+}
