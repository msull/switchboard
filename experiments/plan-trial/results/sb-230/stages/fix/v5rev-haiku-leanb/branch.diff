+/// A browser pairs as the page does: the cookie is `HttpOnly`, `Secure`,
+/// `SameSite=Strict`, `__Host-` and named for the host, and the body holds
+/// no token. The cookie alone reads `/me`. A native pair is unchanged.
+#[test]
+fn a_browser_pairs_with_a_cookie_and_no_token_in_the_body() {
+    let mut port = port();
+    let identity = port.remote.state().identity.clone().unwrap();
+    port.app.dispatch(AppAction::OpenPairing {
+        code: "ABCD2345".into(),
+        scope: Scope::Read,
+    });
+    let body = serde_json::json!({
+        "code": "ABCD2345",
+        "spki_sha256": identity.spki_sha256,
+        "device_name": "Safari on iPhone",
+        "transport": "cookie",
+    });
+    let (head, reply) = call_with(&mut port, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(head.status, 200, "{reply}");
+    let name = format!("__Host-sb-{}", identity.server_id);
+    let set = head.header("set-cookie").expect("a Set-Cookie");
+    let (pair, attrs) = set.split_once("; ").unwrap();
+    assert!(pair.starts_with(&format!("{name}=")), "{set}");
+    for attr in [
+        "Max-Age=34560000",
+        "Path=/",
+        "Secure",
+        "HttpOnly",
+        "SameSite=Strict",
+    ] {
+        assert!(attrs.split("; ").any(|a| a == attr), "{attr} in {set}");
+    }
+    assert!(!set.contains("Domain"), "{set}");
+    assert!(reply["body"]["token"].is_null(), "no token in the body");
+    assert_eq!(reply["body"]["server_id"], identity.server_id.to_string());
+
+    let cookie = format!("{}={}", name, &pair[name.len() + 1..]);
+    let (head, me) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!(head.status, 200, "{me}");
+    assert_eq!(me["body"]["name"], "Safari on iPhone");
+    assert_eq!(me["body"]["scope"], "read");
+    assert_eq!(me["body"]["server_name"], identity.server_name);
+
+    // The window closed with that pairing, so a native pair opens its own.
+    port.app.dispatch(AppAction::OpenPairing {
+        code: "BBBB2345".into(),
+        scope: Scope::Read,
+    });
+    let native_body = serde_json::json!({
+        "code": "BBBB2345",
+        "spki_sha256": identity.spki_sha256,
+        "device_name": "Vision Pro",
+    });
+    let (head, native) = call_with(
+        &mut port,
+        "POST",
+        "/api/v1/pair",
+        &[],
+        &native_body.to_string(),
+    );
+    assert_eq!(head.status, 200, "{native}");
+    assert!(
+        head.header("set-cookie").is_none(),
+        "a native pair gets no cookie"
+    );
+    assert!(
+        native["body"]["token"].is_string(),
+        "its token is in the body"
+    );
+}
