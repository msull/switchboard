+/// Two instances on one address: each host's cookie is its own name, a
+/// host reads only its own, and a cookie under the fixed name reads nothing.
+#[test]
+fn two_hosts_on_one_address_never_read_each_others_cookie() {
+    let mut a = port();
+    let mut b = port();
+    let (device_a, name_a, token_a) = pair_cookie(&mut a, "ABCD2345", Scope::Read, "Pad");
+    let (_, name_b, token_b) = pair_cookie(&mut b, "ABCD2345", Scope::Read, "Pad");
+    assert_ne!(name_a, name_b, "each host names its cookie for its own id");
+
+    let only_b = format!("{name_b}={token_b}");
+    let (head, _) = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", &only_b)], "");
+    assert_eq!(head.status, 401, "another host's cookie is not this host's");
+
+    let both = format!("{only_b}; {name_a}={token_a}");
+    let (head, me) = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", &both)], "");
+    assert_eq!(head.status, 200, "{me}");
+    assert_eq!(me["body"]["device_id"], device_a, "a's own device");
+
+    let fixed = format!("__Host-sb={token_a}");
+    let (head, _) = call_with(&mut a, "GET", "/api/v1/me", &[("Cookie", &fixed)], "");
+    assert_eq!(head.status, 401, "the fixed name authenticates nothing");
+}
