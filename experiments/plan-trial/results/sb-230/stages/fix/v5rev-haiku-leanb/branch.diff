+/// Every route the page names answers a paired control device with
+/// something other than `not_found`. The routes are read from the page's
+/// `ROUTES` table, so a route the page adds is checked without a change here.
+#[test]
+fn every_route_the_page_names_is_served() {
+    let js = std::fs::read_to_string(concat!(env!("CARGO_MANIFEST_DIR"), "/web/app.js")).unwrap();
+    let table = js
+        .split("const ROUTES = {")
+        .nth(1)
+        .and_then(|rest| rest.split("};").next())
+        .expect("the page has a ROUTES table");
+    let mut port = port();
+    let (_, project, session) = seed(&mut port, "");
+    let token = pair(&mut port, "ABCD2345", Scope::Control, "Phone");
+    for line in table.lines() {
+        let Some(path) = line.split('"').nth(1).filter(|p| p.starts_with("/api/v1/")) else {
+            continue;
+        };
+        let id = if path.contains("/projects/") {
+            &project
+        } else {
+            &session
+        };
+        let path = path.replace("{id}", id);
+        let method = if path.ends_with("/send") || path.ends_with("/pair") {
+            "POST"
+        } else {
+            "GET"
+        };
+        let (_, reply) = call(&mut port, method, &path, Some(&token), "{}");
+        assert_ne!(code(&reply), "not_found", "{method} {path}: {reply}");
+    }
+}
