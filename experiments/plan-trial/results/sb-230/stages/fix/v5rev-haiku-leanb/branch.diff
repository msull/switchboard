+/// `/me` says the scope the device has now, and follows a change of it.
+#[test]
+fn me_reports_the_scope_the_device_has_now() {
+    let mut port = port();
+    let (device, name, token) = pair_cookie(&mut port, "ABCD2345", Scope::Read, "Pad");
+    let cookie = format!("{name}={token}");
+    let (_, me) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!(me["body"]["scope"], "read");
+    assert_eq!(me["body"]["device_id"], device);
+    port.app.dispatch(AppAction::SetDeviceScope {
+        device: uuid::Uuid::parse_str(&device).unwrap(),
+        scope: Scope::Control,
+    });
+    let (_, me) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!(me["body"]["scope"], "control");
+}
