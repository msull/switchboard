+/// A page load is an unauthenticated connection that closes after its
+/// reply, so four sequential loads leave the pool as it was.
+#[test]
+fn a_page_load_frees_its_slot_at_once() {
+    let port = port();
+    for _ in 0..=MAX_UNAUTHENTICATED {
+        let head = exchange(port.addr, &port.client, "GET", "/app.css", &[], "").expect("page");
+        assert_eq!(head.status, 200);
+        // The listener's thread frees the slot just after the close.
+        std::thread::sleep(Duration::from_millis(50));
+    }
+}
+
+/// Pages have their own window: 120 a minute, and the 121st is 429 while
+/// `/info` (its own window) still answers.
+#[test]
+fn page_loads_are_limited_per_minute_on_their_own_window() {
+    let mut port = port();
+    for n in 0..120 {
+        let head = exchange(port.addr, &port.client, "GET", "/", &[], "").expect("page");
+        assert_eq!(head.status, 200, "load {n}");
+    }
+    let head = exchange(port.addr, &port.client, "GET", "/", &[], "").expect("page");
+    assert_eq!(head.status, 429, "the 121st load in a minute");
+    let (status, _) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(status, 200, "the info window is its own");
+    let (status, reply) = call(&mut port, "POST", "/api/v1/pair", None, "{}");
+    assert_eq!(
+        (status, code(&reply)),
+        (403, "pairing_closed"),
+        "the pair window is its own"
+    );
+}
