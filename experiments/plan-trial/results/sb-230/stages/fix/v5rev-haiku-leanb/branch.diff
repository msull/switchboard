+    let identity = port.remote.state().identity.clone().unwrap();
+    let body = serde_json::json!({
+        "code": code,
+        "spki_sha256": identity.spki_sha256,
+        "device_name": name,
+        "transport": "cookie",
+    });
+    let (head, reply) = call_with(port, "POST", "/api/v1/pair", &[], &body.to_string());
+    assert_eq!(head.status, 200, "{reply}");
+    let cookie = remote::cookie_name(identity.server_id);
+    let set = head.header("set-cookie").expect("a Set-Cookie");
+    let token = set
+        .split(';')
+        .next()
+        .and_then(|pair| pair.strip_prefix(&format!("{cookie}=")))
+        .expect("the cookie is named for this host")
+        .to_owned();
+    let device = reply["body"]["device_id"].as_str().unwrap().to_owned();
+    (device, cookie, token)
+}
