+/// After a revocation the cookie is the same 401 an unknown token is, and
+/// `/info` still names the same host and key, which is what lets the page
+/// say the device was removed.
+#[test]
+fn a_revoked_cookie_is_unauthorized_and_info_names_the_same_host() {
+    let mut port = port();
+    let (_, before) = get(&mut port, "/api/v1/info", None);
+    let (device, name, token) = pair_cookie(&mut port, "ABCD2345", Scope::Read, "Pad");
+    port.app.dispatch(AppAction::RevokeDevice(
+        uuid::Uuid::parse_str(&device).unwrap(),
+    ));
+    let cookie = format!("{name}={token}");
+    let (head, reply) = call_with(&mut port, "GET", "/api/v1/me", &[("Cookie", &cookie)], "");
+    assert_eq!(
+        (head.status, code(&reply)),
+        (401, "unauthorized"),
+        "{reply}"
+    );
+    let (_, after) = get(&mut port, "/api/v1/info", None);
+    assert_eq!(after["body"]["server_id"], before["body"]["server_id"]);
+    assert_eq!(after["body"]["spki_sha256"], before["body"]["spki_sha256"]);
+}
