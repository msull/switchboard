+/// The page names only what the host serves, and its markup and script
+/// stay inside the policy: no inline script, style or handler, no markup
+/// written from a string. Every API path the script names answers for a
+/// paired device, something other than `not_found`.
+#[test]
+fn the_page_names_only_what_the_host_serves_and_keeps_its_markup_plain() {
+    let mut port = port();
+    let html = include_str!("../web/index.html");
+    let script = include_str!("../web/app.js");
+    for attr in ["src=\"", "href=\""] {
+        for (at, _) in html.match_indices(attr) {
+            let value = &html[at + attr.len()..];
+            let value = &value[..value.find('"').unwrap()];
+            assert!(
+                ["/", "/app.js", "/app.css"].contains(&value) || value.starts_with("data:"),
+                "{value} is not served"
+            );
+        }
+    }
+    for (at, _) in html.match_indices("<script") {
+        let tag = &html[at..at + html[at..].find('>').unwrap()];
+        assert!(tag.contains("src="), "an inline script: {tag}");
+    }
+    assert!(!html.contains("style="), "no inline style");
+    assert!(
+        !html
+            .split_whitespace()
+            .any(|w| w.starts_with("on") && w.contains('=')),
+        "no inline handler"
+    );
+    for banned in [
+        "innerHTML",
+        "outerHTML",
+        "eval(",
+        "document.write",
+        "insertAdjacentHTML",
+    ] {
+        assert!(!script.contains(banned), "the script uses {banned}");
+    }
+
+    let (_, project, session) = seed(&mut port, "");
+    let token = pair(&mut port, "ABCD2345", Scope::Control, "Vision Pro");
+    let mut checked = 0;
+    for (at, _) in script.match_indices("\"/api/v1/") {
+        let rest = &script[at + 1..];
+        let path = &rest[..rest.find('"').unwrap()];
+        let path = if path.contains("projects/{id}") {
+            path.replace("{id}", &project)
+        } else {
+            path.replace("{id}", &session)
+        };
+        let (method, bearer) = match path.as_str() {
+            "/api/v1/pair" => ("POST", None),
+            p if p.ends_with("/send") => ("POST", Some(token.as_str())),
+            _ => ("GET", Some(token.as_str())),
+        };
+        let (status, reply) = call(&mut port, method, &path, bearer, "{}");
+        assert_ne!(
+            code(&reply),
+            "not_found",
+            "{method} {path}: {status} {reply}"
+        );
+        checked += 1;
+    }
+    assert!(checked >= 10, "the script names its routes: {checked}");
+}
