+/// A cookie is a credential the browser sends on its own, so a write from
+/// it must come from this host's own origin; a bearer, a read, and a write
+/// from the right origin are not refused for the origin.
+#[test]
+fn a_write_by_cookie_must_come_from_this_hosts_own_origin() {
+    let mut port = port();
+    let (_, _, session) = seed(&mut port, "");
+    let (_, name, token) = pair_cookie(&mut port, "ABCD2345", Scope::Control, "Pad");
+    let cookie = format!("{name}={token}");
+    let path = format!("/api/v1/sessions/{session}/send");
+    let body = r#"{"op":"o1","text":"hi"}"#;
+
+    let (head, reply) = call_with(&mut port, "POST", &path, &[("Cookie", &cookie)], body);
+    assert_eq!((head.status, code(&reply)), (403, "origin"), "{reply}");
+    let (head, reply) = call_with(
+        &mut port,
+        "POST",
+        &path,
+        &[("Cookie", &cookie), ("Origin", "https://evil.example")],
+        body,
+    );
+    assert_eq!((head.status, code(&reply)), (403, "origin"), "{reply}");
+    let (head, reply) = call_with(
+        &mut port,
+        "POST",
+        &path,
+        &[("Cookie", &cookie), ("Origin", "https://localhost")],
+        body,
+    );
+    assert_ne!(code(&reply), "origin", "{reply}");
+    assert_ne!(head.status, 403, "{reply}");
+
+    let bearer = pair(&mut port, "BBBB2345", Scope::Control, "Vision Pro");
+    let (_, reply) = call(&mut port, "POST", &path, Some(&bearer), body);
+    assert_ne!(code(&reply), "origin", "a bearer is exempt: {reply}");
+    let (head, _) = call_with(
+        &mut port,
+        "GET",
+        "/api/v1/waiting",
+        &[("Cookie", &cookie)],
+        "",
+    );
+    assert_eq!(head.status, 200, "a read by cookie needs no origin");
+}
+
+/// The same rule holds for the events socket's upgrade: a cookie upgrade
+/// from another origin is refused, and from this host's own origin it is
+/// accepted (101).
+#[test]
+fn a_cookie_upgrade_must_come_from_this_hosts_own_origin() {
+    let mut port = port();
+    let (_, name, token) = pair_cookie(&mut port, "ABCD2345", Scope::Read, "Pad");
+    let cookie = format!("{name}={token}");
+    let upgrade = |origin: &'static str| {
+        vec![
+            ("Upgrade", "websocket"),
+            ("Connection", "Upgrade"),
+            ("Sec-WebSocket-Version", "13"),
+            ("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ=="),
+            ("Cookie", cookie.as_str()),
+            ("Origin", origin),
+        ]
+    };
+    let head = head_with(
+        &mut port,
+        "GET",
+        "/api/v1/events",
+        &upgrade("https://evil.example"),
+        "",
+    );
+    assert_eq!(head.status, 403, "{}", head.body);
+    assert!(head.body.contains("\"origin\""), "{}", head.body);
+    let head = head_with(
+        &mut port,
+        "GET",
+        "/api/v1/events",
+        &upgrade("https://localhost"),
+        "",
+    );
+    assert_eq!(head.status, 101, "{}", head.body);
+}
