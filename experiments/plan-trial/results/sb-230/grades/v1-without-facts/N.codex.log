    fn authenticate(&mut self, request: &RemoteRequest) -> Result<PairedDevice, RemoteReply> {
        let Some(token) = &request.bearer else {
            return Err(self.refuse(
                request,
                401,
                "unauthorized",
                "pair this device first",
                false,
            ));
        };
        let Some(device) = self
            .core
            .device_by_token(&remote::token_sha256(token))
            .cloned()
        else {
            return Err(self.refuse(
                request,
                401,
                "unauthorized",
                "the token is not known; pair again",
                false,
            ));
        };
        self.dispatch_inner(AppAction::DeviceSeen(device.id));
        Ok(device)
    }

    /// A command under `control` scope. The body's `op` is the operation
    /// id the device made, which is the idempotency key: the command
/// The head of one HTTP/1.1 request: method, target, lowercased
/// headers, body. `None` at a clean end of stream before any byte; an
/// oversized or malformed request is an error that closes the
/// connection.
fn read_request<R: Read>(reader: &mut BufReader<R>) -> io::Result<Option<RemoteRequest>> {
    let mut line = String::new();
    if reader.read_line(&mut line)? == 0 {
        return Ok(None);
    }
    let mut parts = line.split_whitespace();
    let (Some(method), Some(target)) = (parts.next(), parts.next()) else {
        return Err(io::Error::new(
            io::ErrorKind::InvalidData,
            "bad request line",
        ));
    };
    let mut headers: Vec<(String, String)> = Vec::new();
    let mut total = line.len();
    loop {
        let mut h = String::new();
        if reader.read_line(&mut h)? == 0 {
            return Err(io::Error::new(io::ErrorKind::UnexpectedEof, "headers cut"));
        }
        total += h.len();
        if total > MAX_HEAD {
            return Err(io::Error::new(io::ErrorKind::InvalidData, "head too large"));
        }
        let h = h.trim_end();
        if h.is_empty() {
            break;
        }
        if let Some((n, v)) = h.split_once(':') {
            headers.push((n.trim().to_ascii_lowercase(), v.trim().to_owned()));
        }
    }
    let header = |name: &str| {
        headers
            .iter()
            .find(|(n, _)| n == name)
            .map(|(_, v)| v.as_str())
    };
    let length: usize = header("content-length")
        .and_then(|v| v.parse().ok())
        .unwrap_or(0);
    if length > MAX_BODY {
        return Err(io::Error::new(io::ErrorKind::InvalidData, "body too large"));
    }
    let bearer = header("authorization")
        .and_then(|v| v.strip_prefix("Bearer "))
        .map(|t| t.trim().to_owned())
        .filter(|t| !t.is_empty());
    let upgrade = header("upgrade")
        .filter(|u| u.eq_ignore_ascii_case("websocket"))
        .and_then(|_| header("sec-websocket-key"))
        .map(str::to_owned);
    let (path, query) = target.split_once('?').unwrap_or((target, ""));
    let query = query
        .split('&')
        .filter(|s| !s.is_empty())
        .map(|pair| {
            let (n, v) = pair.split_once('=').unwrap_or((pair, ""));
            (n.to_owned(), v.to_owned())
        })
        .collect();
    let mut body = vec![0; length];
    reader.read_exact(&mut body)?;
    Ok(Some(RemoteRequest {
        method: method.to_owned(),
        path: path.to_owned(),
        query,
        body,
        bearer,
        upgrade,
    }))
}

pub fn make_identity(
    server_id: Option<Uuid>,
    server_name: &str,
    listen: Listen,
) -> Result<(Identity, String), String> {
    let server_id = server_id.unwrap_or_else(Uuid::new_v4);
    let key = rcgen::KeyPair::generate().map_err(|e| format!("key: {e}"))?;
    let mut params = rcgen::CertificateParams::new(Vec::<String>::new())
        .map_err(|e| format!("certificate: {e}"))?;
    params.distinguished_name.push(
        rcgen::DnType::CommonName,
        format!("Switchboard {server_id}"),
    );
    let cert = params
        .self_signed(&key)
        .map_err(|e| format!("certificate: {e}"))?;
    let der = cert.der().to_vec();
    let spki_sha256 = sha256_hex(&key.subject_public_key_info());
    debug_assert_eq!(
        spki_sha256_of_cert(&der).as_deref(),
        Some(spki_sha256.as_str())
    );
    let identity = Identity {
        schema_version: IDENTITY_SCHEMA_VERSION,
        server_id,
        server_name: server_name.to_owned(),
        certificate: base64::engine::general_purpose::STANDARD.encode(&der),
        spki_sha256,
        created: SystemTime::now(),
        listen,
    };
    Ok((identity, key.serialize_pem()))
}

/// The certificate's DER back from the identity.
pub fn certificate_der(identity: &Identity) -> Result<Vec<u8>, String> {
    base64::engine::general_purpose::STANDARD
        .decode(&identity.certificate)
        .map_err(|e| format!("certificate: {e}"))
}

