fn status_of(result: io::Result<Reply>) -> Option<Status> {
    match result {
        Ok(Reply::Status(status)) => Some(status),
        Ok(other) => {
            log::warn!("dispatch status answered {other:?}");
            None
        }
        Err(e) => {
            log::debug!("dispatch status: {e}");
            None
        }
    }
}

