                    t.id
                );
                return Ok(());
            }
        };
        if !matches!(view.state, RunState::Converged | RunState::AtCap) {
            log::warn!(
                "ticket {} {stage}/{number}: revise: the review is no longer finished",
                t.id
            );
            return Ok(());
